    {
      "parameters": {
        "jsCode": "// Telegram alert listing every flagged line for human review.\nconst rec = $('Prepare RFQ Record').first().json;\nconst stats = $('Build RFQ Stats').first().json;\nconst review = $('Match Lines Against Catalogue').all().map(i => i.json).filter(l => l.status === 'REVIEW');\nconst lines = review.slice(0, 15).map(l =>\n  `\\u2022 L${l.line_no} | ${l.code || '\\u2014'} | ${l.description} | Qty ${l.quantity} ${l.unit} \\u2014 <b>${l.issue}</b> (conf ${l.confidence})`\n);\nconst more = review.length > 15 ? `\\n\\u2026and ${review.length - 15} more \\u2014 see the Review Queue sheet.` : '';\nreturn [{ json: { message:\n`<b>\\u26a0\\ufe0f Quote review needed</b>\\nRFQ <b>${rec.rfq_reference}</b> \\u2014 ${rec.customer_name}\\n${review.length} of ${stats.line_count} line(s) flagged for human review:\\n${lines.join('\\n')}${more}\\n\\nOpen the <b>Review Queue</b> tab, approve or correct each line, then update the Quote Draft. Nothing was auto-substituted.`\n}}];",
        "mode": "runOnceForAllItems"
      },
      "id": "d0446846-e85d-4f28-8a47-da4ce7a5c0f3",
      "name": "Build Review Alert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4320,
        140
