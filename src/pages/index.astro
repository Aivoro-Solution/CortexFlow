---
import { getCollection } from "astro:content";
import BaseLayout from "../components/BaseLayout.astro";
import { SITE } from "../config";

const templates = (await getCollection("templates", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const featured = templates.slice(0, 4);
const pad = (n: number) => String(n).padStart(3, "0");

const difficultyLabel: Record<string, string> = {
  beginner: "Beginner",
  intermediate: "Intermediate",
  advanced: "Advanced",
};

const comparisons = (await getCollection("comparisons", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 4);
---

<BaseLayout
  title="Free n8n Workflow Templates"
  description="Free, ready-to-import n8n workflow templates — AI agents, chatbots, and automations. Download the JSON, import in n8n, add your credentials, done."
  canonicalPath="/"
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Organization",
    name: SITE.name,
    url: SITE.url,
    logo: new URL("/og-default.svg", SITE.url).toString(),
  })} />

  <section class="hero">
    <div class="wrap" style="position: relative;">
      <span class="sticker sticker--free" style="top: 6px; right: 4%;">100% FREE!</span>
      <span class="sticker sticker--new" style="top: 108px; right: 14%;">★ New drop</span>
      <p class="kicker">N8N WORKFLOW TEMPLATES — <b>FREE FOREVER</b></p>
      <h1>Free n8n workflows, <span class="hl-y">ready</span> to <span class="hl-o">import.</span></h1>
      <p class="lead">
        Production-grade n8n workflow templates built from real demand — AI agents,
        chatbots, and automations. Download the JSON, import it in n8n, add your
        credentials, and you're running in minutes.
      </p>
      <div class="hero-actions">
        <a class="btn" href="/templates/">Browse templates</a>
        <a class="btn btn-ghost" href="/blog/">Read the tutorials</a>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 1rem;">
    <div class="wrap">
      <div class="sec-head">
        <h2>The stash</h2>
        <span class="tag">{templates.length} templates · {templates.length} live</span>
        <a class="more" href="/templates/">View all →</a>
      </div>
      {featured.length > 0 ? (
        <div class="tpl-grid">
          {featured.map((t, i) => (
            <a class="tpl-card" href={`/templates/${t.id.replace(/\.md$/, "")}/`}>
              {i === 0 && <span class="burst" aria-hidden="true">Live</span>}
              <h3>{t.data.title}</h3>
              <p class="flow">{t.data.description}</p>
              <div class="meta">
                <span class="tpl-tag tpl-tag--live">Live</span>
                <span class="tpl-tag tpl-tag--diff">{difficultyLabel[t.data.difficulty]}</span>
                <span class="tpl-dl">↓ JSON</span>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <p>Templates are on the drawing board — check back soon.</p>
      )}
    </div>
  </section>

  <section class="section" style="padding-top: 0;">
    <div class="wrap">
      <div class="sec-head">
        <h2>Dead simple</h2>
        <span class="tag">3 steps</span>
      </div>
      <div class="steps">
        <div class="step">
          <p class="n">01</p>
          <h3>Download the JSON</h3>
          <p>Pick a template and download the workflow JSON. Free forever, no signup.</p>
        </div>
        <div class="step">
          <p class="n">02</p>
          <h3>Import in n8n</h3>
          <p>In n8n: Workflows → ⋯ → Import from file. The full workflow appears on your canvas.</p>
        </div>
        <div class="step">
          <p class="n">03</p>
          <h3>Connect &amp; run</h3>
          <p>Add your own credentials (Telegram, OpenAI, etc.), activate, and it runs.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 0;">
    <div class="wrap">
      <div class="sec-head">
        <h2>Head-to-head</h2>
        <span class="tag">{comparisons.length} comparisons</span>
        <a class="more" href="/compare/">View all →</a>
      </div>
      {comparisons.length > 0 ? (
        <div class="tpl-grid">
          {comparisons.map((c) => (
            <a class="tpl-card" href={`/compare/${c.id.replace(/\.md$/, "")}/`}>
              <h3>{c.data.tool_a} vs {c.data.tool_b}</h3>
              <p class="flow">{c.data.verdict}</p>
              <div class="meta">
                <span class="tpl-tag tpl-tag--live">Comparison</span>
                <span class="tpl-dl">Read →</span>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <p>Comparisons are on the drawing board — check back soon.</p>
      )}
    </div>
  </section>

  <section class="section" style="padding-top: 0;">
    <div class="wrap">
      <div class="rss-strip">
        <div class="inner">
          <div>
            <span class="fmt">Doc. CF-BLOG-001 · Tutorials</span>
            <h2>Want the full breakdown?</h2>
            <p>Step-by-step tutorials on AI agents, n8n automation, and chatbots live on the blog — organized by topic.</p>
          </div>
          <a class="btn btn-ghost" href="/blog/">Visit the blog →</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
