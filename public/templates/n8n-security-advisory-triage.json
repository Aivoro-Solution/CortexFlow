    {
      "parameters": {
        "method": "GET",
        "url": "https://api.github.com/advisories?ecosystem=npm&affects=n8n",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "X-GitHub-Api-Version",
              "value": "2022-11-28"
            }
          ]
        },
        "options": {}
      },
      "id": "8333e8eb-5425-45b0-a4b1-adae975c67ab",
      "name": "Fetch n8n Advisories",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Keep only advisories whose GHSA ID is not already in the sheet\nconst seen = new Set(\n  $('Read Seen Advisory IDs').all().map(i => (i.json['GHSA ID'] || '').trim()).filter(Boolean)\n);\nconst raw = $('Fetch n8n Advisories').first().json;\nconst advisories = Array.isArray(raw) ? raw : [raw];\nconst fresh = advisories.filter(a => a && a.ghsa_id && !seen.has(a.ghsa_id.trim()));\nreturn fresh.map(a => ({ json: {\n  ghsa_id: a.ghsa_id,\n  summary: a.summary || '',\n  severity: a.severity || '',\n  published_at: (a.published_at || '').slice(0, 10),\n  html_url: a.html_url || '',\n  vulnerable_version_range: a.vulnerable_version_range\n    || (a.vulnerabilities && a.vulnerabilities[0] && a.vulnerabilities[0].vulnerable_version_range)\n    || '',\n}}));",
        "mode": "runOnceForAllItems"
      },
      "id": "a3bddb92-0eaf-4ce3-80a1-f25408f711eb",
      "name": "Filter New Advisories",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "combinator": "and",
          "conditions": [
            {
              "id": "if-new",
              "leftValue": "={{ $input.all().length }}",
              "rightValue": "0",
              "operator": {
                "type": "number",
                "operation": "largerThan",
                "name": "filter.operator.number.largerThan"
              }
            }
          ],
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          }
        },
        "options": {}
      },
