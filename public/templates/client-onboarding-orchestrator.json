    {
      "parameters": {
        "jsCode": "// Kickoff call: N days out at 10:00, 45 minutes long\nconst daysAhead = parseInt($('CONFIG — Business').first().json.kickoff_days_ahead || '3', 10);\nconst start = new Date();\nstart.setDate(start.getDate() + daysAhead);\nstart.setHours(10, 0, 0, 0);\nconst end = new Date(start.getTime() + 45 * 60000);\nreturn [{ json: {\n  ...$input.first().json,\n  kickoff_start: start.toISOString(),\n  kickoff_end: end.toISOString(),\n}}];",
        "mode": "runOnceForAllItems"
      },
      "id": "f876e072-a52e-4d60-a5f9-beddd9c2f00a",
      "name": "Code — Compute Kickoff Date",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
