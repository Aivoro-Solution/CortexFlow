    {
      "parameters": {
        "jsCode": "// Build 5 clickable star-rating links from the CONFIG webhook base URL\nconst cfg = $('CONFIG — Review Flow').first().json;\nconst base = (cfg.rating_webhook_base_url || '').replace(/\\/$/, '');\nconst job = $('Job Completed').first().json.body || {};\nconst jobId = job.job_id || '';\nconst links = {};\nfor (let s = 1; s <= 5; s++) {\n  links['stars_' + s] = base + '/rate?job_id=' + encodeURIComponent(jobId) + '&stars=' + s;\n}\nreturn [{ json: {\n  customer_name: job.customer_name || '',\n  email: job.email || '',\n  job_id: jobId,\n  business_name: cfg.business_name || '',\n  stars_1: links.stars_1,\n  stars_2: links.stars_2,\n  stars_3: links.stars_3,\n  stars_4: links.stars_4,\n  stars_5: links.stars_5,\n}}];",
        "mode": "runOnceForAllItems"
      },
      "id": "c8ad9cd5-a5bb-4b14-b776-e375a8aac6d2",
      "name": "Build Star Links",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        300
      ]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "subject": "=How was your experience with {{ $json.business_name }}? ⭐",
        "sendTo": "={{ $json.email }}",
        "emailType": "html",
        "message": "=Hi {{ $json.customer_name }},<br><br>Thanks for choosing {{ $json.business_name }}! We'd love your honest feedback — just tap a star:<br><br><a href=\"{{ $json.stars_1 }}\">⭐</a> <a href=\"{{ $json.stars_2 }}\">⭐⭐</a> <a href=\"{{ $json.stars_3 }}\">⭐⭐⭐</a> <a href=\"{{ $json.stars_4 }}\">⭐⭐⭐⭐</a> <a href=\"{{ $json.stars_5 }}\">⭐⭐⭐⭐⭐</a><br><br>It takes 5 seconds, and it really helps us improve. 🙏",
        "options": {}
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "",
          "name": "Gmail API"
        }
      },
      "id": "b2d05a5e-7e3a-468c-b954-362bd1918ac3",
      "name": "Send Review Request",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1440,
        300
      ]
    },
    {
      "parameters": {
        "httpMethod": "GET",
        "path": "rate",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "f7c2b513-0450-4973-9b4a-b5115329a6fe",
      "name": "Rating Submitted",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        1680,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Extract stars + job_id from the GET /rate webhook query string\nconst q = $input.first().json.query || {};\nconst stars = parseInt(q.stars, 10);\nreturn [{ json: {\n  job_id: String(q.job_id || ''),\n  stars: isNaN(stars) ? 0 : stars,\n}}];",
        "mode": "runOnceForAllItems"
      },
      "id": "5b0f7b8a-24d7-42e0-a7bb-92d1831c24ca",
      "name": "Parse Rating",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1920,
        300
      ]
    },
    {
      "parameters": {
        "operation": "read",
        "resource": "sheetWithinDocument",
        "documentId": {
          "__rl": true,
          "mode": "list",
          "value": "={{ $('CONFIG — Review Flow').first().json.spreadsheet_id }}"
        },
        "sheetName": {
          "__rl": true,
          "mode": "list",
          "value": "Review Requests"
        },
        "options": {}
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "",
          "name": "Google Sheets API"
        }
      },
      "id": "761efe12-b611-415e-b55f-d3527f6228d0",
      "name": "Read Review Requests",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        2160,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Find the sheet row matching this rating's job_id\nconst me = $input.first().json;\nconst rows = $('Read Review Requests').all().map(i => i.json);\nconst row = rows.find(r => String(r['Job ID'] || '').trim() === String(me.job_id).trim()) || {};\nreturn [{ json: {\n  job_id: me.job_id,\n  stars: me.stars,\n  customer_name: row['Customer'] || '',\n  email: row['Email'] || '',\n  matched: Boolean(row['Job ID']),\n}}];",
        "mode": "runOnceForAllItems"
      },
      "id": "a1c2d66d-edf4-4f34-bf59-e72d156da556",
      "name": "Match Job ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2400,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "combinator": "and",
          "conditions": [
            {
              "id": "if-rating",
              "leftValue": "={{ $json.stars }}",
              "rightValue": "4",
              "operator": {
                "type": "number",
                "operation": "smaller",
                "name": "filter.operator.number.smaller"
              }
            }
          ],
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          }
        },
        "options": {}
