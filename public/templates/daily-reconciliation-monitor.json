    {
      "parameters": {
        "jsCode": "// One output item per break, so the Run Log gets one row per break\nconst sum = $('Compare Row Sets').first().json;\nreturn (sum.breaks || []).map(b => ({ json: {\n  yesterday: sum.yesterday,\n  break_type: b.break_type,\n  key: b.key,\n  field: b.field || '',\n  source_value: b.source_value || '',\n  dest_value: b.dest_value || '',\n}}));",
