    {
      "parameters": {
        "jsCode": "// Build a Slack-safe channel slug + today's date; keep client fields flowing\nconst item = $input.first().json;\nconst raw = (item.company || 'client').toString();\nconst slug = raw\n  .toLowerCase()\n  .normalize('NFD').replace(/[\\u0300-\\u036f]/g, '')\n  .replace(/[^a-z0-9]+/g, '-')\n  .replace(/^-+|-+$/g, '')\n  .slice(0, 60) || 'client';\nreturn [{ json: {\n  ...item,\n  company_slug: slug,\n  date: new Date().toISOString().slice(0, 10),\n}}];",
        "mode": "runOnceForAllItems"
      },
      "id": "dcb5755d-8de4-409c-9efb-1c204201a6ec",
      "name": "Code — Slugify Company",
      "type": "n8n-nodes-base.code",
