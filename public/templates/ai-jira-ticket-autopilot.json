            "Priority": "={{ $json.priority }}",
            "Reporter": "={{ $json.reporter }}",
            "Ticket URL": "={{ $json.ticket_url }}",
            "Created": "={{ $json.created }}",
            "Status": "NEW"
          }
        },
        "options": {}
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "",
          "name": "Google Sheets API"
        }
      },
      "id": "9ab93c4a-6c9a-412f-a798-36a1288cac03",
      "name": "Log Tickets — Status NEW",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1800,
        300
      ]
    },
    {
      "parameters": {
        "options": {
          "systemMessage": "=You are a senior support engineer triaging Jira tickets for project {{ $('CONFIG — Jira + AI').first().json.project_key }}. For each ticket decide: can it be safely AUTO-RESOLVED (clear question with a known answer, simple config/access change with a documented procedure, duplicate of an already-resolved ticket) or must it be ESCALATED to a human (ambiguous requirements, production incidents, security issues, anything touching customer data, billing, or access grants, low confidence)? Be conservative: when in doubt, escalate. Output ONLY via the structured output parser — no prose."
        },
        "text": "=Ticket: {{ $json.ticket_key }} — {{ $json.summary }}\nPriority: {{ $json.priority }} | Status: {{ $json.status }} | Reporter: {{ $json.reporter }}\nURL: {{ $json.ticket_url }}\n\nDescription:\n{{ $json.description }}"
      },
      "id": "51faf7c2-f46e-478b-b637-d68619e48881",
      "name": "AI Ticket Triage Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        2060,
        300
      ]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4o-mini"
        },
        "options": {}
      },
      "credentials": {
        "openAiApi": {
          "id": "",
          "name": "OpenAI API"
        }
      },
      "id": "e9371a3e-ce1e-4ef6-9a0a-76f4d9fe4603",
      "name": "OpenAI Chat Model — Triage",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [
        2060,
        560
      ]
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"can_resolve\": true,\n  \"confidence\": 85,\n  \"summary\": \"one-line summary of the issue\",\n  \"category\": \"BUG / QUESTION / ACCESS_REQUEST / FEATURE_REQUEST / INCIDENT / OTHER\",\n  \"resolution_comment\": \"the exact comment to post on the Jira ticket when auto-resolving (empty string when escalating)\",\n  \"escalation_reason\": \"one-line reason a human must handle this (empty string when auto-resolving)\"\n}"
      },
      "id": "7a5d3c0c-477c-48df-9a3d-dd328292008b",
      "name": "Structured Output Parser — Triage",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [
        2320,
        560
      ]
    },
    {
      "parameters": {
        "operation": "update",
        "resource": "sheetWithinDocument",
        "documentId": {
          "__rl": true,
          "mode": "list",
          "value": ""
        },
        "sheetName": {
          "__rl": true,
          "mode": "list",
          "value": "TicketLog"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "matchingColumns": [
            "Ticket Key"
          ],
          "schema": [],
          "attemptToConvertTypes": false,
          "convertFieldsToString": false,
          "value": {
            "Ticket Key": "={{ $json.ticket_key }}",
            "AI Summary": "={{ $json.output.summary }}",
            "Category": "={{ $json.output.category }}",
            "Can Resolve": "={{ $json.output.can_resolve }}",
            "Confidence": "={{ $json.output.confidence }}",
            "Escalation Reason": "={{ $json.output.escalation_reason }}",
            "Status": "TRIAGED"
          }
        },
        "options": {}
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "",
          "name": "Google Sheets API"
        }
      },
      "id": "52d4d990-ba12-4d22-a2cb-87bea771b4cb",
      "name": "Update Sheet — Status TRIAGED",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        2320,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "combinator": "and",
          "conditions": [
            {
              "id": "if-can-resolve",
              "leftValue": "={{ $json.output.can_resolve === true ? 'yes' : 'no' }}",
              "rightValue": "yes",
              "operator": {
                "type": "string",
                "operation": "equals",
                "name": "filter.operator.string.equals"
              }
            },
            {
              "id": "if-confidence",
              "leftValue": "={{ $json.output.confidence }}",
              "rightValue": "={{ $('CONFIG — Jira + AI').first().json.confidence_threshold }}",
              "operator": {
                "type": "number",
                "operation": "largerEqual",
                "name": "filter.operator.number.largerEqual"
              }
            }
          ],
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          }
        },
        "options": {}
      },
      "id": "c78f9bf0-ecf6-4af5-96c0-8f954158f83d",
      "name": "IF — Auto-Resolve?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        2580,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://{{ $('CONFIG — Jira + AI').first().json.jira_host }}/rest/api/3/issue/{{ $json.ticket_key }}/comment",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ $('Build Jira Auth Header').first().json.auth_header }}"
            },
            {
              "name": "Accept",
              "value": "application/json"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"body\": {\"type\": \"doc\", \"version\": 1, \"content\": [{\"type\": \"paragraph\", \"content\": [{\"type\": \"text\", \"text\": \"{{ $json.output.resolution_comment }}\"}]}]}}",
        "options": {}
      },
      "id": "e5b7db9d-a26c-40a2-ad5d-07abde5b1d98",
      "name": "Jira — Add Resolution Comment",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2840,
        140
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://{{ $('CONFIG — Jira + AI').first().json.jira_host }}/rest/api/3/issue/{{ $('IF — Auto-Resolve?').item.json.ticket_key }}/transitions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ $('Build Jira Auth Header').first().json.auth_header }}"
            },
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        },
        "options": {}
      },
      "id": "ff76841c-0639-47f6-b8bf-15e505eabbb0",
      "name": "Jira — Get Transitions",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        3100,
        140
      ]
    },
    {
      "parameters": {
        "jsCode": "// Find the Jira \"Done\" transition id; carry ticket context forward (paired by index)\nconst ifItems = $('IF — Auto-Resolve?').all();\nconst auth = $('Build Jira Auth Header').first().json.auth_header;\nreturn $input.all().map((item, i) => {\n  const ticket = (ifItems[i] && ifItems[i].json) || {};\n  const transitions = item.json.transitions || [];\n  const done = transitions.find(t => String(t.name || '').toLowerCase() === 'done');\n  if (!done) {\n    throw new Error('No \"Done\" transition found for ticket ' + (ticket.ticket_key || '?') + ' — check your Jira workflow has a transition named \"Done\".');\n  }\n  return { json: {\n    ticket_key: ticket.ticket_key,\n    ticket_url: ticket.ticket_url,\n    summary: ticket.summary,\n    confidence: ticket.output ? ticket.output.confidence : 0,\n    ai_category: ticket.output ? ticket.output.category : '',\n    resolution_comment: ticket.output ? ticket.output.resolution_comment : '',\n    done_transition_id: done.id,\n    auth_header: auth,\n  }};\n});",
        "mode": "runOnceForAllItems"
      },
      "id": "acdaf8b6-135c-4380-b468-514d5bbdbaf3",
      "name": "Pick Done Transition",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3360,
        140
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://{{ $('CONFIG — Jira + AI').first().json.jira_host }}/rest/api/3/issue/{{ $('Pick Done Transition').item.json.ticket_key }}/transitions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ $('Pick Done Transition').item.json.auth_header }}"
            },
            {
              "name": "Accept",
              "value": "application/json"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"transition\": {\"id\": \"{{ $('Pick Done Transition').item.json.done_transition_id }}\"}}",
        "options": {}
      },
      "id": "06e066f3-9629-496b-821d-b930135f1ece",
      "name": "Jira — Transition to Done",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        3620,
        140
      ]
    },
    {
      "parameters": {
        "method": "PUT",
        "url": "=https://{{ $('CONFIG — Jira + AI').first().json.jira_host }}/rest/api/3/issue/{{ $('Pick Done Transition').item.json.ticket_key }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ $('Pick Done Transition').item.json.auth_header }}"
