      "id": "e5b7cf5e-2047-498c-b0a1-d2d4521ef682",
      "name": "Log Breaks — Status BREAK_FOUND",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        2400,
        140
      ]
    },
    {
      "parameters": {
        "options": {
          "systemMessage": "=You are a data-quality analyst. Classify each mismatched record into one likely cause:\n- timing_difference: the destination usually catches up later (sync lag, batch delays)\n- transformation_bug: a mapping, rounding, or formatting error between source and destination\n- genuine_loss: the values are irreconcilable and data is actually wrong\n\nBe conservative: label 'genuine_loss' only when the values cannot be explained by timing or transformation.\n\nCompare fields: {{ $('CONFIG — Reconciliation').first().json.compare_fields }}. Numeric tolerance used: {{ $('CONFIG — Reconciliation').first().json.tolerance }}. Output ONLY via the structured output parser.",
          "text": "=Reconciliation date: {{ $('Compare Row Sets').first().json.yesterday }}.\n\nMismatched records (key | field | source value | destination value):\n{{ JSON.stringify($('Compare Row Sets').first().json.mismatches) }}"
        }
      },
      "id": "4a1e2bb6-6eb5-4f97-8bec-43eaafe9d3f8",
      "name": "AI Agent — Classify Mismatches",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        2640,
        140
      ]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4o-mini"
        },
        "options": {}
      },
      "credentials": {
        "openAiApi": {
          "id": "",
          "name": "OpenAI API"
        }
      },
      "id": "e67a9b9b-25f9-475c-8d3b-5ff962af40ca",
      "name": "OpenAI Chat Model — Classifier",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [
        2640,
        400
      ]
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"classifications\": [\n    {\n      \"key\": \"the record's key value\",\n      \"field\": \"the mismatched field name\",\n      \"cause\": \"timing_difference / transformation_bug / genuine_loss\",\n      \"confidence\": 85,\n      \"reasoning\": \"one sentence explaining the call\"\n    }\n  ],\n  \"overall_verdict\": \"one sentence: are these mismatches likely benign or do they need investigation?\"\n}"
      },
      "id": "7831dd7a-094f-4faa-9f4f-18738bff17e5",
      "name": "Structured Output Parser — Cause",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [
        2880,
        400
      ]
    },
    {
      "parameters": {
        "mode": "append",
        "options": {}
      },
      "id": "93c8f842-fc4f-441d-aadf-5ce4fe5b1701",
      "name": "Merge — Combine Reports",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        3120,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Build one Telegram summary from the reconciliation result\nconst sum = $('Compare Row Sets').first().json;\nconst prev = $input.first().json;\nconst cls = prev.output ? prev.output : null;\nconst date = sum.yesterday;\nconst rows = sum.rows_checked_source + sum.rows_checked_dest;\nlet lines;\nif (sum.break_count === 0) {\n  lines = [`🔍 Reconciliation ${date}: ✅ clean — ${rows} rows checked, no breaks.`];\n} else {\n  lines = [\n    `🔍 Reconciliation ${date}: ⚠️ ${sum.missing_count} missing / ${sum.extra_count} extra / ${sum.mismatch_count} mismatched (${rows} rows checked)`,\n    ``,\n  ];\n  for (const b of sum.breaks.slice(0, 8)) {\n    if (b.break_type === 'MISMATCHED') {\n      lines.push(`• ${b.key} — ${b.field}: src ${b.source_value} → dst ${b.dest_value}`);\n    } else {\n      lines.push(`• ${b.key} — ${b.break_type}`);\n    }\n  }\n  if (sum.breaks.length > 8) lines.push(`…and ${sum.breaks.length - 8} more (see the RunLog sheet)`);\n  if (cls && cls.classifications) {\n    lines.push(``, `🤖 Likely causes: ${cls.overall_verdict || ''}`);\n    for (const c of cls.classifications.slice(0, 5)) {\n      lines.push(`• ${c.key}${c.field ? ' / ' + c.field : ''}: ${c.cause} — ${c.reasoning || ''}`);\n    }\n  }\n}\nreturn [{ json: {\n  summary_message: lines.join('\\n'),\n  date: date,\n  rows_checked: rows,\n  missing_count: sum.missing_count,\n  extra_count: sum.extra_count,\n  mismatch_count: sum.mismatch_count,\n  break_count: sum.break_count,\n}}];",
        "mode": "runOnceForAllItems"
      },
      "id": "36db4fc9-e095-4e5d-9e29-46b8454a983a",
      "name": "Build Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
