        "jsCode": "// Everyone else who got an offer for this slot loses it (first TAKE wins)\nconst win = $('Code \\u2014 Match Reply to Offer').first().json;\nconst winDigits = String(win.phone).replace(/\\D/g, '');\nconst rows = $input.all().map(i => i.json);\nconst others = rows.filter(r =>\n  r['Appointment ID'] === win.appointment_id &&\n  r['Status'] === 'OFFER_SENT' &&\n  String(r['Phone'] || '').replace(/\\D/g, '') !== winDigits\n);\nreturn others.map(r => ({ json: {\n  appointment_id: r['Appointment ID'],\n  phone: r['Phone'],\n  status: 'EXPIRED',\n}}));",
