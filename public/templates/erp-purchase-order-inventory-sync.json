            "Currency": "={{ $json.currency }}",
            "Status": "NEW",
            "Risk Flag": "",
            "AI Summary": ""
          }
        },
        "options": {}
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "",
          "name": "Google Sheets API"
        }
      },
      "id": "c28ca718-3560-413e-a7a5-1606f448ac2e",
      "name": "Log New POs — Status NEW",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1680,
