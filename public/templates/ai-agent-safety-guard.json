    {
      "parameters": {
        "jsCode": "// Normalize the incoming guard request and build a SHA-256 idempotency key\n// from client + action_type + recipient + payload. Same key = same action:\n// a retry can never execute twice.\nconst body = $json.body || $json;\nconst client_id = (body.client_id || '').toString().trim();\nconst action_type = (body.action_type || '').toString().trim();\nconst recipient = (body.recipient || '').toString().trim();\nconst payload = typeof body.payload === 'string' ? body.payload : JSON.stringify(body.payload || {});\nconst estimated_tokens = Number(body.estimated_tokens) || 0;\nconst keyMaterial = [client_id, action_type, recipient, payload].join('|');\nlet idempotency_key = '';\ntry {\n  const crypto = require('crypto');\n  idempotency_key = crypto.createHash('sha256').update(keyMaterial).digest('hex');\n} catch (e) {\n  // Fallback deterministic hash if crypto is unavailable in this runtime\n  let h1 = 0xdeadbeef, h2 = 0x41c6ce57;\n  for (let i = 0; i < keyMaterial.length; i++) {\n    const ch = keyMaterial.charCodeAt(i);\n    h1 = Math.imul(h1 ^ ch, 2654435761);\n    h2 = Math.imul(h2 ^ ch, 1597334677);\n  }\n  idempotency_key = 'fallback-' + (h1 >>> 0).toString(16) + (h2 >>> 0).toString(16);\n}\nreturn [{ json: {\n  timestamp: new Date().toISOString(),\n  idempotency_key, client_id, action_type, recipient, payload,\n  estimated_tokens, status: 'NEW', cost_usd: 0, decision_reason: '', provider_ref: '',\n} }];",
        "mode": "runOnceForAllItems"
      },
      "id": "342174e8-c4a7-4f0d-ba5d-e77527ebe3c5",
      "name": "Code — Normalize Request & Idempotency Key",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
