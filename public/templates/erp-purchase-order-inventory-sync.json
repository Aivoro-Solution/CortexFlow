              "value": "5000"
            }
          ]
        },
        "options": {}
      },
      "id": "173ac123-0a77-4698-bde5-122f37df44c6",
      "name": "CONFIG — AI Review",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1920,
