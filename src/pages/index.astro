---
import BaseLayout from "../components/BaseLayout.astro";
import { SITE, CATEGORIES } from "../config";
import { getPublishedPosts, postUrl, formatDate, categoryName } from "../lib/posts";

const posts = await getPublishedPosts();
const latest = posts.slice(0, 6);
---

<BaseLayout title={SITE.name} description={SITE.description} canonicalPath="/">
  <section class="hero">
    <div class="wrap">
      <h1>Learn to build with {SITE.name}</h1>
      <p class="lead">{SITE.tagline}. Step-by-step tutorials, honest tool comparisons, and real-world builds.</p>
      <div class="cta-row">
        <a class="btn" href="/blog/">Browse all tutorials</a>
        <a class="btn btn-ghost" href="/categories/ai-agents/">Start with AI agents</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>Browse by topic</h2>
      </div>
      <div class="card-grid category-cards">
        {CATEGORIES.map((c) => (
          <a class="card" href={`/categories/${c.slug}/`} style="color: inherit;">
            <span class="icon" aria-hidden="true">{c.icon}</span>
            <h3>{c.name}</h3>
            <p>{c.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section" style="background: var(--bg-soft);">
    <div class="wrap">
      <div class="section-head">
        <h2>Latest posts</h2>
        <a href="/blog/">View all →</a>
      </div>
      <div class="card-grid">
        {latest.map((post) => (
          <article class="card">
            <span class="kicker">{categoryName(post.data.category)}</span>
            <h3><a href={postUrl(post)}>{post.data.title}</a></h3>
            <p>{post.data.description}</p>
            <div class="meta">
              <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
              <span>·</span><span>{post.data.author}</span>
            </div>
          </article>
        ))}
      </div>
      {posts.length === 0 && <p>No posts published yet. Check back soon.</p>}
    </div>
  </section>
</BaseLayout>
