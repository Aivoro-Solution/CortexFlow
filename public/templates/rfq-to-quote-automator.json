    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"line_items\": [\n    {\n      \"line_no\": 1,\n      \"code\": \"EL-CAB-100\",\n      \"description\": \"Copper cable 2.5 sqmm\",\n      \"quantity\": 100,\n      \"unit\": \"meters\"\n    }\n  ]\n}"
      },
      "id": "526993a8-b40d-45fa-8efa-6da0c08d6a9c",
      "name": "Structured Output Parser — Line Items",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [
        1680,
        560
      ]
