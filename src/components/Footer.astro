---
import { SITE, CATEGORIES } from "../config";
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap">
    <div>
      <p class="foot-brand">
        <svg width="26" height="26" viewBox="0 0 40 40" fill="none" aria-hidden="true">
          <path d="M5 11 H35" stroke="#F4F4F1" stroke-width="3.5" stroke-linecap="round"/>
          <path d="M5 20 H25" stroke="#F4F4F1" stroke-width="3.5" stroke-linecap="round"/>
          <circle cx="32" cy="20" r="5" fill="#FF4D00"/>
          <path d="M5 29 H35" stroke="#F4F4F1" stroke-width="3.5" stroke-linecap="round"/>
        </svg>
        {SITE.name}
      </p>
      <p>{SITE.tagline}. Real builds, honest comparisons, zero fluff.</p>
    </div>
    <div>
      <h4>Topics</h4>
      <ul>
        {CATEGORIES.map((c) => (
          <li><a href={`/categories/${c.slug}/`}>{c.name}</a></li>
        ))}
      </ul>
    </div>
    <div>
      <h4>Site</h4>
      <ul>
        <li><a href="/blog/">All posts</a></li>
        <li><a href="/about/">About</a></li>
        <li><a href="/contact/">Contact</a></li>
        <li><a href="/rss.xml">RSS feed</a></li>
      </ul>
    </div>
  </div>
  <div class="footer-bottom">
    <span>© {year} {SITE.name}. All rights reserved.</span>
    <span>Built with Astro · Hosted on Cloudflare Pages</span>
  </div>
</footer>
