    {
      "parameters": {
        "jsCode": "// Build one Telegram digest from all processed jobs\nconst items = $input.all().map(i => i.json);\nconst total = items.length;\nconst hits = items.filter(j => {\n  const s = j.output ? j.output.match_score : j['Match Score'];\n  return Number(s) >= 70;\n});\nlet lines = [`\\U0001F3AF *Job Hunt Digest \\u2014 ${new Date().toISOString().slice(0,10)}*`, ``, `\\U0001F4CB ${total} new jobs scanned`];\nif (hits.length) {\n  lines.push(`\\u2B50 ${hits.length} strong matches (score \\u2265 70):`, ``);\n  for (const h of hits.slice(0, 10)) {\n    const score = h.output ? h.output.match_score : h['Match Score'];\n    lines.push(`\\u2022 *${score}* \\u2014 ${h.job_title} @ ${h.company} ([apply](${h.job_url}))`);\n  }\n} else {\n  lines.push(`No strong matches today. Keep building. \\U0001F4AA`);\n}\nreturn [{ json: { digest: lines.join('\\n'), total, hits: hits.length } }];",
        "mode": "runOnceForAllItems"
      },
      "id": "0904448d-2ae6-41d2-b0f6-3742e0a65625",
      "name": "Build Daily Digest",
