      "id": "f2e06366-ecea-4436-a995-bc608164153b",
      "name": "Google Sheets — Read Payables Log",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1440,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Duplicate = this invoice number + supplier already logged before this run\n// (the row we just appended counts once, so 2+ matches = duplicate).\n// Kill-switch = any BLOCKED row, or a PAID row whose settlement status was lost.\nconst inv = $('Code \\u2014 Normalize Invoice Fields').first().json;\nconst log = $input.all().map(i => i.json);\nconst norm = (s) => (s || '').toString().trim().toLowerCase();\nconst matches = log.filter(r => norm(r['Invoice Number']) === norm(inv.invoice_number)\n  && norm(r['Supplier']) === norm(inv.supplier) && norm(inv.invoice_number) !== '');\nconst prior = matches.find(r => norm(r['Status']) !== 'received');\nconst duplicate = matches.length >= 2 || !!prior;\nconst blocked = log.find(r => norm(r['Status']) === 'blocked');\nconst unsettled = log.find(r => norm(r['Status']) === 'paid' && norm(r['Settlement Status']) !== 'settled');\nconst today = new Date().toISOString().slice(0, 10);\nconst daily_total = log.filter(r => (r['Date Received'] || '').slice(0, 10) === today\n  && ['approved', 'queued_for_payment', 'paid'].includes(norm(r['Status'])))\n  .reduce((s, r) => s + (Number(r['Amount']) || 0), 0);\nreturn [{ json: {\n  ...inv,\n  duplicate,\n  duplicate_reason: duplicate ? `Invoice ${inv.invoice_number} from ${inv.supplier} is already in the PayablesLog` : '',\n  kill_switch: !!(blocked || unsettled),\n  kill_switch_reason: blocked ? 'A BLOCKED row exists in PayablesLog — autopay paused'\n    : (unsettled ? `Unsettled payment ${unsettled['Invoice Number']} — settlement status lost` : ''),\n  daily_total,\n} }];",
        "mode": "runOnceForAllItems"
      },
      "id": "76f40098-353a-4125-8320-df3dfd9ff375",
      "name": "Code — Dedupe + Kill-Switch Check",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1680,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "combinator": "or",
          "conditions": [
            {
              "id": "7b453461-269f-483c-9cef-213e934f1b4c",
              "leftValue": "={{ $json.duplicate }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "name": "filter.operator.boolean.true"
              }
            },
            {
              "id": "b2ff50df-10f3-4da0-ae18-0ee5e552a40a",
              "leftValue": "={{ $json.kill_switch }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "name": "filter.operator.boolean.true"
              }
            }
          ],
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          }
        },
        "options": {}
      },
      "id": "e3d6e4af-44a0-43cf-82c2-1e5ad64fbb43",
      "name": "IF — Duplicate or Kill-Switch?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1920,
        300
      ]
    },
    {
      "parameters": {
        "operation": "read",
