      "parameters": {
        "jsCode": "// Normalize the incoming cancellation payload\nconst body = $input.first().json.body || $input.first().json;\nconst appt = String(body.appointment_id || body.appointmentId || ('APPT-' + Date.now()));\nreturn [{ json: {\n  appointment_id: appt,\n  slot_time: String(body.slot_time || body.slotTime || ''),\n  service: String(body.service || ''),\n  cancelled_by: String(body.cancelled_by || ''),\n  status: 'NEW',\n}}];",
        "mode": "runOnceForAllItems"
      },
      "id": "31a0a42e-cdd3-4e28-bdc0-3b29bde366f3",
      "name": "Code — Normalize Cancellation",
