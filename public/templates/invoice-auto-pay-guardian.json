      "id": "b23ab1ee-c2cf-4adb-b2dd-3211764cb6de",
      "name": "OpenAI Chat Model — 3-Way Match",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [
        3360,
        560
      ]
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"match_verdict\": \"EXACT_MATCH / PARTIAL_MATCH / MISMATCH\",\n  \"line_verdicts\": [{\"po_line\": \"line description\", \"invoice_qty\": 0, \"received_qty\": 0, \"invoice_amount\": 0, \"po_amount\": 0, \"verdict\": \"MATCH / SHORT / SUBSTITUTED / PRICE_CHANGE / MISSING\", \"evidence\": \"quote the numbers from invoice / PO / receiving record\"}],\n  \"total_variance\": 0,\n  \"credit_memos_noted\": \"any credit memos found, or none\",\n  \"recommended_action\": \"AUTO_APPROVE / REVIEW\",\n  \"reasoning\": \"one paragraph explaining the verdict\"\n}"
      },
      "id": "c95a6b37-b16a-443a-bca3-140ca4c80c48",
      "name": "Structured Output Parser — Match Verdict",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [
        3600,
        560
      ]
    },
    {
      "parameters": {
        "jsCode": "// Auto-approve ONLY on exact match + supplier OK + within both caps\nconst inv = $('Code \\u2014 Supplier Check').first().json;\nconst cfg = $('CONFIG \\u2014 Policy & Caps').first().json;\nconst out = $json.output || {};\nconst cap = Number(cfg.per_payment_cap) || 5000;\nconst dailyCap = Number(cfg.daily_cap) || 20000;\nconst dailyTotal = Number(inv.daily_total) || 0;\nconst amount = Number(inv.amount) || 0;\nlet decision = 'REVIEW', reason = '';\nif (out.match_verdict === 'EXACT_MATCH' && out.recommended_action === 'AUTO_APPROVE') {\n  if (amount > cap) reason = `Amount ${amount} exceeds per-payment cap ${cap}`;\n  else if (dailyTotal + amount > dailyCap) reason = `Daily cap ${dailyCap} would be exceeded (today ${dailyTotal} + ${amount})`;\n  else { decision = 'AUTO_APPROVE'; reason = 'Exact 3-way match within caps'; }\n} else {\n  reason = `Match verdict ${out.match_verdict || 'UNKNOWN'}: ${out.reasoning || 'see agent output'}`;\n}\nreturn [{ json: {\n  ...inv,\n  status: 'MATCHING',\n  match_verdict: out.match_verdict || 'UNKNOWN',\n  line_verdicts: out.line_verdicts || [],\n  total_variance: (out.total_variance === undefined || out.total_variance === null) ? '' : out.total_variance,\n  credit_memos_noted: out.credit_memos_noted || '',\n  decision, decision_reason: reason,\n  per_payment_cap: cap, daily_cap: dailyCap,\n  policy_version: cfg.policy_version,\n} }];",
        "mode": "runOnceForAllItems"
      },
      "id": "e8d163cf-9639-429f-b48d-50332430617a",
      "name": "Code — Build Match Decision",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3600,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "combinator": "and",
          "conditions": [
            {
              "id": "caaa5728-e786-4816-8cd5-a65fdf279e5d",
              "leftValue": "={{ $json.decision }}",
              "rightValue": "AUTO_APPROVE",
              "operator": {
                "type": "string",
                "operation": "equals",
                "name": "filter.operator.string.equals"
              }
            }
          ],
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
