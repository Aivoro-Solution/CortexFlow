    {
      "parameters": {
        "jsCode": "// Settlement lost = kill-switch trigger on the next run. Never mark PAID blindly.\nconst res = $input.first().json;\nconst ok = !!(res && (res.status === 'succeeded' || res.status === 'settled' || res.status === 'paid' || res.success === true));\nconst j = $('Code \\u2014 Prepare Payment Batch').first().json;\nreturn [{ json: {\n  ...j,\n  status: ok ? 'PAID' : 'QUEUED_FOR_PAYMENT',\n  settlement_status: ok ? 'SETTLED' : 'UNSETTLED',\n  provider_response: JSON.stringify(res).slice(0, 500),\n} }];",
        "mode": "runOnceForAllItems"
      },
