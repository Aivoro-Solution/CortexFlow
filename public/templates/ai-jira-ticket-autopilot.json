      "id": "e8a928d2-8b44-4094-9f7f-35f32800c9e0",
      "name": "CONFIG — Jira + AI",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Build the Jira Basic auth header from email + API token (no creds hardcoded)\nconst cfg = $('CONFIG — Jira + AI').first().json;\nconst email = (cfg.jira_email || '').trim();\nconst token = (cfg.jira_api_token || '').trim();\nif (!email || !token || token.indexOf('PASTE_YOUR') === 0 || email.indexOf('PASTE_YOUR') === 0) {\n  throw new Error('Fill jira_email and jira_api_token in the \"CONFIG — Jira + AI\" node first (Atlassian account → Security → API tokens).');\n}\nconst auth = 'Basic ' + Buffer.from(email + ':' + token, 'utf8').toString('base64');\nreturn $input.all().map(i => ({ json: { ...i.json, auth_header: auth } }));",
        "mode": "runOnceForAllItems"
      },
      "id": "5ab7698c-942a-4055-a03e-ab35b3134d83",
      "name": "Build Jira Auth Header",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://{{ $('CONFIG — Jira + AI').first().json.jira_host }}/rest/api/3/search",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "jql",
              "value": "=project={{ $('CONFIG — Jira + AI').first().json.project_key }} AND status in (\"To Do\",\"Open\") ORDER BY created DESC"
            },
            {
              "name": "maxResults",
              "value": "25"
            },
            {
              "name": "fields",
              "value": "summary,description,priority,status,reporter,created"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ $('Build Jira Auth Header').first().json.auth_header }}"
            },
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        },
        "options": {}
      },
      "id": "c1bc1f79-a766-4feb-b103-6d6748c135d8",
      "name": "Jira — Fetch Open Tickets",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        760,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Flatten Jira issues into clean ticket objects (ADF description -> plain text)\nfunction adfText(node) {\n  if (!node) return '';\n  if (typeof node === 'string') return node;\n  if (Array.isArray(node)) return node.map(adfText).join('\\n');\n  let t = node.text || '';\n  if (node.content) t += (t ? '\\n' : '') + adfText(node.content);\n  return t;\n}\nconst cfg = $('CONFIG — Jira + AI').first().json;\nconst host = (cfg.jira_host || '').trim();\nconst issues = $input.first().json.issues || [];\nreturn issues.map(issue => {\n  const f = issue.fields || {};\n  return { json: {\n    ticket_key: issue.key,\n    summary: (f.summary || '').slice(0, 200),\n    description: adfText(f.description).slice(0, 2000),\n    priority: (f.priority && f.priority.name) || '',\n    status: (f.status && f.status.name) || '',\n    reporter: (f.reporter && f.reporter.displayName) || '',\n    created: f.created || '',\n    ticket_url: 'https://' + host + '/browse/' + issue.key,\n    status_flow: 'NEW',\n  }};\n});",
        "mode": "runOnceForAllItems"
      },
      "id": "fba64776-6de6-46a8-9e26-5a00cf45bd23",
      "name": "Normalize Tickets",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1020,
        300
      ]
    },
    {
      "parameters": {
        "operation": "read",
        "resource": "sheetWithinDocument",
        "documentId": {
          "__rl": true,
          "mode": "list",
          "value": ""
        },
        "sheetName": {
          "__rl": true,
          "mode": "list",
          "value": "TicketLog"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "matchingColumns": [],
          "schema": [],
          "attemptToConvertTypes": false,
          "convertFieldsToString": false,
          "value": {}
        },
        "options": {}
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "",
          "name": "Google Sheets API"
        }
      },
      "id": "ba10e475-2ef4-43ea-b68e-ab1033711781",
      "name": "Read Logged Ticket Keys",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1280,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Drop tickets whose key is already in the sheet\nconst seen = new Set(\n  $('Read Logged Ticket Keys').all().map(i => (i.json['Ticket Key'] || i.json.ticket_key || '').trim()).filter(Boolean)\n);\nconst fresh = $('Normalize Tickets').all()\n  .map(i => i.json)\n  .filter(t => t.ticket_key && !seen.has(t.ticket_key.trim()));\nreturn fresh.map(t => ({ json: t }));",
        "mode": "runOnceForAllItems"
      },
      "id": "cfcd77c2-ec6e-417f-9e6b-a80eaf502653",
      "name": "Filter New Tickets Only",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        300
      ]
    },
    {
      "parameters": {
        "operation": "append",
        "resource": "sheetWithinDocument",
        "documentId": {
          "__rl": true,
          "mode": "list",
          "value": ""
        },
        "sheetName": {
          "__rl": true,
          "mode": "list",
          "value": "TicketLog"
