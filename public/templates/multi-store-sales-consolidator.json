      "id": "171c506d-a6fe-48cd-8fcb-55e5b81ba316",
      "name": "Read Consolidated Rows — This Week",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        2400,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Aggregate consolidated rows: this ISO week (Mon-Sun) vs previous week\nconst rows = $input.all().map(i => i.json);\nconst num = v => { const n = parseFloat(String(v == null ? '' : v).replace(/[^0-9.\\-]/g, '')); return isNaN(n) ? 0 : n; };\nconst now = new Date();\nconst monday = new Date(now);\nmonday.setDate(now.getDate() - ((now.getDay() + 6) % 7));\nmonday.setHours(0, 0, 0, 0);\nconst iso = d => d.toISOString().slice(0, 10);\nconst thisStart = iso(monday), thisEnd = iso(new Date(monday.getTime() + 6 * 864e5));\nconst lastStart = iso(new Date(monday.getTime() - 7 * 864e5)), lastEnd = iso(new Date(monday.getTime() - 864e5));\nconst inRange = (d, a, b) => d >= a && d <= b;\nconst wow = (cur, prev) => prev > 0 ? Math.round(((cur - prev) / prev) * 1000) / 10 : null;\nconst per = {};\nconst items = {};\nfor (const r of rows) {\n  const d = String(r['Date'] || '').slice(0, 10);\n  const store = String(r['Store'] || 'Unknown');\n  const item = String(r['Item'] || 'Unknown');\n  const qty = num(r['Qty']), rev = num(r['Revenue']);\n  if (!inRange(d, lastStart, thisEnd)) continue;\n  const wk = inRange(d, thisStart, thisEnd) ? 'this' : 'last';\n  per[store] = per[store] || { this_rev: 0, this_qty: 0, last_rev: 0 };\n  per[store][wk + '_rev'] += rev;\n  per[store][wk + '_qty'] += qty;\n  if (wk === 'this') {\n    const key = store + ' \\u2014 ' + item;\n    items[key] = items[key] || { item, store, revenue: 0 };\n    items[key].revenue += rev;\n  }\n}\nconst stores = Object.keys(per).sort().map(s => ({\n  store: s,\n  revenue: Math.round(per[s].this_rev * 100) / 100,\n  orders_qty: per[s].this_qty,\n  wow_pct: wow(per[s].this_rev, per[s].last_rev),\n}));\nconst total_revenue = Math.round(stores.reduce((a, s) => a + s.revenue, 0) * 100) / 100;\nconst total_qty = stores.reduce((a, s) => a + s.orders_qty, 0);\nconst last_total = Object.keys(per).reduce((a, s) => a + per[s].last_rev, 0);\nconst top_items = Object.keys(items).map(k => items[k]).sort((a, b) => b.revenue - a.revenue).slice(0, 5)\n  .map(x => ({ item: x.item, store: x.store, revenue: Math.round(x.revenue * 100) / 100 }));\nreturn [{ json: {\n  run_date: now.toISOString().slice(0, 10),\n  week_start: thisStart, week_end: thisEnd, prev_week_start: lastStart,\n  store_count: stores.length,\n  stores, total_revenue, total_qty,\n  overall_wow_pct: wow(total_revenue, last_total),\n  top_items,\n}}];",
        "mode": "runOnceForAllItems"
      },
      "id": "16d40ff5-2ecb-4c5a-804e-04e18447c21e",
      "name": "Compute Weekly Totals",
