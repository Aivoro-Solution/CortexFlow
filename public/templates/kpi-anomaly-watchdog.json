    {
      "parameters": {
        "jsCode": "// One Telegram digest from all WARNING anomalies in this run\nconst items = $input.all().map(i => i.json);\nconst date = new Date().toISOString().slice(0, 10);\nlet lines = [`⚠️ *KPI Warning Digest — ${date}*`, ``];\nfor (const a of items) {\n  const out = a.output || {};\n  const causes = Array.isArray(out.probable_causes)\n    ? out.probable_causes.map(c => c.cause).join('; ')\n    : '';\n  lines.push(`• *${a.metric}* ${a.direction} baseline (Z ${a.z_score}, DoD ${a.dod_pct}%)`);\n  if (out.anomaly_summary) lines.push(`  ${out.anomaly_summary}`);\n  if (causes) lines.push(`  ↳ Likely: ${causes}`);\n  lines.push(``);\n}\nlines.push(`Logged in the anomaly sheet with status TRIAGED. Flip rows to RESOLVED once reviewed.`);\nreturn [{ json: { digest: lines.join('\\n'), warnings: items.length } }];",
        "mode": "runOnceForAllItems"
      },
