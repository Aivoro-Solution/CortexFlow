      "parameters": {
        "jsCode": "// Normalize the incoming reply: {phone, message}\nconst body = $input.first().json.body || $input.first().json;\nconst digits = String(body.phone || body.from || '').replace(/\\D/g, '');\nconst msg = String(body.message || body.text || '').trim().toUpperCase();\nconst keyword = String($('CONFIG \\u2014 Waitlist Rules').first().json.reply_keyword || 'TAKE').toUpperCase();\nreturn [{ json: { phone: digits, message: msg, wants_slot: msg.includes(keyword) } }];",
        "mode": "runOnceForAllItems"
      },
