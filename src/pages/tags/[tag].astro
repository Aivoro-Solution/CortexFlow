---
import BaseLayout from "../../components/BaseLayout.astro";
import { SITE } from "../../config";
import { getPublishedPosts, slugify } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();
  return tags.map((tag) => ({
    params: { tag: slugify(tag) },
    props: {
      tag,
      posts: posts.filter((p) => p.data.tags.includes(tag)),
    },
  }));
}

const { tag, posts } = Astro.props;
const tagSlug = slugify(tag);
---

<BaseLayout
  title={`Posts tagged "${tag}"`}
  description={`All ${SITE.name} posts tagged ${tag}.`}
  canonicalPath={`/tags/${tagSlug}/`}
  noindex
>
  <section class="section">
    <div class="wrap">
      <p class="breadcrumb"><a href="/">Home</a> / <a href="/blog/">Blog</a> / Tags</p>
      <p class="kicker">CORTEXFLOW · FREE FOREVER</p>
      <h1 style="margin: 0 0 2rem; font-size: clamp(2rem, 4.6vw, 3rem); text-transform: uppercase;">Posts tagged <span class="tag" style="font-size: 1.1rem;">#{tag}</span></h1>
      <div class="spec-list">
        {posts.map((post, i) => (
          <a class="spec" href={`/blog/${post.id.replace(/\.md$/, "")}/`}>
            <span class="spec-no" aria-hidden="true">{String(i + 1).padStart(3, "0")}</span>
            <span class="spec-body">
              <h3 class="spec-title">{post.data.title}</h3>
              <p class="spec-desc">{post.data.description}</p>
            </span>
            <span class="spec-tag">
              <time datetime={post.data.date.toISOString()}>
                {post.data.date.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}
              </time>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
