        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"anomaly_summary\": { \"type\": \"string\", \"description\": \"1-2 sentence plain-English summary of what happened\" },\n    \"probable_causes\": { \"type\": \"array\", \"items\": { \"type\": \"object\", \"properties\": { \"cause\": { \"type\": \"string\" }, \"evidence\": { \"type\": \"string\", \"description\": \"which numbers support this cause\" }, \"where_to_check\": { \"type\": \"string\", \"description\": \"where in the business to verify\" } }, \"required\": [\"cause\", \"evidence\", \"where_to_check\"] }, \"description\": \"ranked most-probable causes, 2-4 items\" },\n    \"recommended_action\": { \"type\": \"string\", \"description\": \"single most important next step\" },\n    \"confidence\": { \"type\": \"number\", \"description\": \"0-100 confidence in the explanation\" }\n  },\n  \"required\": [\"anomaly_summary\", \"probable_causes\", \"recommended_action\", \"confidence\"]\n}"
      },
