    {
      "parameters": {
        "options": {
          "systemMessage": "=You are a strict accounts-payable auditor. Do a line-by-line 3-way match: invoice vs purchase order vs receiving record. Flag short quantities, substitutions, price changes, missing lines and credit memos. Quote the exact evidence (numbers) for every verdict. Recommend AUTO_APPROVE only on a perfect line-by-line match with zero variance. Output ONLY via the structured output parser."
        },
        "text": "=Invoice to verify:\nInvoice #: {{ $json.invoice_number }}\nSupplier: {{ $json.supplier }}\nPO #: {{ $json.po_number }}\nAmount: {{ $json.amount }} {{ $json.currency }}\nDue date: {{ $json.due_date }}\nBank account last-4: {{ $json.bank_account_last4 }}\n\nInvoice text:\n{{ $json.invoice_text }}\n\nPurchase order lines:\n{{ $('Google Sheets \\u2014 Read Purchase Orders').all().map(i => JSON.stringify(i.json)).join('\\n') }}\n\nReceiving records:\n{{ $('Google Sheets \\u2014 Read Receiving Records').all().map(i => JSON.stringify(i.json)).join('\\n') }}"
      },
      "id": "ce1aee7b-195c-4bda-a778-7f17becaba62",
      "name": "AI Agent — 3-Way Match Verdict",
