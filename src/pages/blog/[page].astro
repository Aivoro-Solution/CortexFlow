---
import BaseLayout from "../../components/BaseLayout.astro";
import { SITE, CATEGORIES } from "../../config";
import { getPublishedPosts, postUrl, formatDate, categoryName } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const perPage = SITE.postsPerPage;
  const totalPages = Math.max(1, Math.ceil(posts.length / perPage));
  const counts: Record<string, number> = {};
  for (const p of posts) counts[p.data.category] = (counts[p.data.category] ?? 0) + 1;
  return Array.from({ length: totalPages }, (_, i) => {
    const page = i + 1;
    return {
      params: { page: String(page) },
      props: {
        page,
        totalPages,
        posts: posts.slice((page - 1) * perPage, page * perPage),
        counts,
      },
    };
  });
}

const { page, totalPages, posts, counts } = Astro.props;
const title = page === 1 ? "Blog" : `Blog — Page ${page}`;
const description =
  page === 1
    ? "All tutorials on AI agents, workflow automation, and chatbots — step-by-step guides and honest comparisons."
    : `All tutorials on AI agents, workflow automation, and chatbots — page ${page} of ${totalPages}.`;
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={page === 1 ? "/blog/" : `/blog/${page}/`}
  noindex={page > 1}
>
  <section class="section">
    <div class="wrap">
      <p class="breadcrumb"><a href="/">Home</a> / Blog</p>
      <p class="kicker">CORTEXFLOW · FREE FOREVER</p>
      <h1 style="margin: 0 0 .5rem; font-size: clamp(2.4rem, 5.4vw, 3.6rem); text-transform: uppercase;">The <span style="background: var(--yellow); padding: 0 .25em; border: 3px solid var(--ink); display: inline-block; transform: rotate(-1deg);">Blog</span></h1>
      <p style="margin: 0 0 1.75rem; font-weight: 600; max-width: 62ch;">
        Tutorials, comparisons, and practical guides — organized by topic. Pick a category or browse everything below.
      </p>

      <div class="tracks" style="margin-bottom: 2.5rem;">
        {CATEGORIES.map((c, i) => (
          <a class="track" href={`/categories/${c.slug}/`}>
            <p class="fig">FIG. <b>{String(i + 1).padStart(3, "0")}</b> · {counts[c.slug] ?? 0} posts</p>
            <h3>{c.name}</h3>
            <p>{c.description}</p>
          </a>
        ))}
      </div>

      <nav class="cat-chips" aria-label="Browse by category">
        <span class="cat-chip cat-chip--on" aria-current="page">All posts</span>
        {CATEGORIES.map((c) => (
          <a class="cat-chip" href={`/categories/${c.slug}/`}>
            {c.name} <span class="cat-chip__n">{counts[c.slug] ?? 0}</span>
          </a>
        ))}
      </nav>

      <div class="spec-list">
        {posts.map((post, i) => (
          <a class="spec" href={postUrl(post)}>
            <span class="spec-no" aria-hidden="true">{String((page - 1) * 10 + i + 1).padStart(3, "0")}</span>
            <span class="spec-body">
              <h3 class="spec-title">{post.data.title}</h3>
              <p class="spec-desc">{post.data.description}</p>
            </span>
            <span class="spec-tag">{categoryName(post.data.category)}</span>
          </a>
        ))}
      </div>

      {totalPages > 1 && (
        <nav class="pagination" aria-label="Blog pagination">
          {page > 1 && <a href={page === 2 ? "/blog/" : `/blog/${page - 1}/`}>← Newer</a>}
          {Array.from({ length: totalPages }, (_, i) => i + 1).map((p) =>
            p === page ? (
              <span class="current" aria-current="page">{p}</span>
            ) : (
              <a href={p === 1 ? "/blog/" : `/blog/${p}/`}>{p}</a>
            )
          )}
          {page < totalPages && <a href={`/blog/${page + 1}/`}>Older →</a>}
        </nav>
      )}
    </div>
  </section>
</BaseLayout>
