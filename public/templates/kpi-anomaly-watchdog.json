      "id": "b7192779-24af-4ca9-ae70-bb601ddee2e3",
      "name": "Read KPI Metrics",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        720,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Statistical detection BEFORE any AI call: 7-day baseline (mean/std)\n// + z-score + day-over-day change per metric. Emits one item per anomaly.\nconst cfg = $('CONFIG — Watchdog Settings').first().json;\nconst metrics = (cfg.kpi_columns || 'Revenue,Orders,Ad Spend,Sessions')\n  .split(',').map(s => s.trim()).filter(Boolean);\nconst lookback  = parseInt(cfg.lookback_days || '7', 10);\nconst minDays   = parseInt(cfg.baseline_min_days || '5', 10);\nconst warnZ     = parseFloat(cfg.warning_z || '2');\nconst critZ     = parseFloat(cfg.critical_z || '3');\nconst warnPct   = parseFloat(cfg.warning_pct || '20');\nconst critPct   = parseFloat(cfg.critical_pct || '40');\n\nconst rows = $input.all().map(i => i.json).filter(r => r['Date']);\nif (!rows.length) return [];\nrows.sort((a, b) => String(a['Date']).localeCompare(String(b['Date'])));\nconst latest = rows[rows.length - 1];\nconst num = v => {\n  if (v === null || v === undefined || v === '') return NaN;\n  const n = parseFloat(String(v).replace(/[^0-9.\\-]/g, ''));\n  return isNaN(n) ? NaN : n;\n};\nconst r2 = v => Math.round(v * 100) / 100;\n\nconst anomalies = [];\nfor (const m of metrics) {\n  const vals = rows.map(r => num(r[m])).filter(v => !isNaN(v));\n  if (vals.length < minDays + 1) continue;\n  const latestVal = vals[vals.length - 1];\n  const prevVal = vals[vals.length - 2];\n  const base = vals.slice(-(lookback + 1), -1); // lookback days BEFORE latest\n  if (base.length < minDays) continue;\n  const mean = base.reduce((a, b) => a + b, 0) / base.length;\n  const std = Math.sqrt(base.reduce((a, b) => a + Math.pow(b - mean, 2), 0) / base.length);\n  const z = std > 0 ? (latestVal - mean) / std : 0;\n  const dodPct = prevVal !== 0 ? ((latestVal - prevVal) / Math.abs(prevVal)) * 100 : 0;\n  const absZ = Math.abs(z), absDod = Math.abs(dodPct);\n  let severity = 'OK';\n  if (absZ >= critZ || absDod >= critPct) severity = 'CRITICAL';\n  else if (absZ >= warnZ || absDod >= warnPct) severity = 'WARNING';\n  else if (absZ >= 1 || absDod >= 10) severity = 'WATCH';\n  if (severity === 'OK') continue;\n  anomalies.push({ json: {\n    anomaly_id: String(latest['Date']) + '_' + m.toLowerCase().replace(/[^a-z0-9]+/g, '_'),\n    anomaly_date: latest['Date'],\n    business: cfg.business_name || '',\n    metric: m,\n    latest_value: latestVal,\n    previous_value: prevVal,\n    baseline_mean: r2(mean),\n    baseline_std: r2(std),\n    z_score: r2(z),\n    dod_pct: r2(dodPct),\n    direction: latestVal >= mean ? 'ABOVE' : 'BELOW',\n    severity: severity,\n    status: 'NEW',\n  }});\n}\nreturn anomalies;",
        "mode": "runOnceForAllItems"
      },
