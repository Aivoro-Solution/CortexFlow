    {
      "parameters": {
        "jsCode": "// Parse the extracted invoice text into structured fields\nconst text = ($json.text || '').toString();\nconst pick = (re) => { const m = text.match(re); return m ? m[1].trim() : ''; };\nconst amountRaw = pick(/(?:total|amount due|balance due|grand total)[\\s\\S]{0,40}?\\$?\\s?([\\d,]+\\.\\d{2})/i) || pick(/\\$?\\s?([\\d,]+\\.\\d{2})/);\nconst amount = parseFloat((amountRaw || '0').replace(/,/g, '')) || 0;\nconst invoice_number = pick(/invoice\\s*(?:no\\.?|number|#)\\s*[:#]?\\s*([A-Za-z0-9\\-\\/]+)/i);\nconst po_number = pick(/(?:p\\.?o\\.?|purchase order)\\s*(?:no\\.?|number|#)\\s*[:#]?\\s*([A-Za-z0-9\\-\\/]+)/i);\nconst supplier = pick(/(?:from|vendor|supplier|billed by)\\s*[:\\-]?\\s*([A-Za-z0-9 .&',\\-]+)/i) || 'UNKNOWN_SUPPLIER';\nconst bank_last4 = pick(/(?:account|acct)[\\s\\S]{0,30}?(?:ending|last 4|\\*{2,})(\\d{4})/i) || '';\nconst due_date = pick(/due\\s*date\\s*[:\\-]?\\s*(\\d{4}-\\d{2}-\\d{2}|\\d{2}\\/\\d{2}\\/\\d{4})/i);\nconst currency = (text.match(/\\b(USD|EUR|GBP|INR|AUD|CAD)\\b/) || ['USD'])[0];\nconst idempotency_key = [invoice_number, supplier, amount.toFixed(2)].join('::');\nreturn [{ json: {\n  invoice_number, supplier, po_number, amount, currency, due_date,\n  bank_account_last4: bank_last4,\n  invoice_text: text.slice(0, 6000),\n  idempotency_key,\n  date_received: new Date().toISOString().slice(0, 10),\n  status: 'RECEIVED',\n} }];",
        "mode": "runOnceForAllItems"
      },
      "id": "bae11b0a-d287-4b9f-b011-b4f1311245f8",
      "name": "Code — Normalize Invoice Fields",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        300
      ]
    },
    {
      "parameters": {
