      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "89f35b19-67e4-4092-8cb8-2fb6d5b0e11d",
              "name": "openai_model",
              "type": "string",
              "value": "gpt-4o-mini"
            },
            {
              "id": "9dc098a0-0ec5-4d11-a589-c8f8e4d52983",
              "name": "approval_threshold",
