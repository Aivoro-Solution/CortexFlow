": "message", "operation": "getAll", "filters": {"q": "is:unread (label:urgent OR label:action) newer_than:1d"}, "options": {"limit": 50}}}, {"id": "gml2-0010-4a5b-8c9d-aaaaaaaaaaaaaaaa", "name": "OpenAI: Summarize Digest", "type": "n8n-nodes-base.openAi", "typeVersion": 1, "position": [720, 600], "credentials": {"openAiApi": {"id": "", "name": "OpenAI API"}}, "parameters": {"resource": "text", "operation": "message", "model": "gpt-4o-mini", "messages": {"message": [{"role": "user", "content": "=Summarize these emails into a short morning digest. One line per email: sender, subject, and why it matters. Group urgent ones first.\n\n{{ JSON.stringify($json, null, 2) }}"}]}, "options": {}}}, {"id": "gml2-0011-4a5b-8c9d-bbbbbbbbbbbb", "name": "Gmail: Send Digest", "type": "n8n-nodes-base.gmail", "typeVersion": 2.1, "position": [960, 600], "credentials": {"gmailOAuth2": {"id": "", "name": "Gmail"}}, "parameters": {"resource": "message", "operation": "send", "subject": "=Daily inbox digest - {{ $now.format('yyyy-MM-dd') }}", "email": "you@example.com", "message": "=Good morning,\n\nHere is your inbox digest:\n\n{{ $json.message.content }}", "options": {}}}], "connections": {"Gmail Trigger: New Email": {"main": [[{"node": "OpenAI: Classify Email", "type": "main", "index": 0}]]}, "OpenAI: Classify Email": {"main": [[{"node": "Switch: Route by Category", "type": "main", "index": 0}]]}, "Switch: Route by Category": {"main": [[{"node": "Gmail: Apply Label - Urgent", "type": "main", "index": 0}], [{"node": "Gmail: Apply Label - Action", "type": "main", "index": 0}], [{"node": "Gmail: Apply Label - FYI", "type": "main", "index": 0}], [{"node": "Gmail: Apply Label - Spam", "type": "main", "index": 0}]]}, "Schedule Trigger: Daily Digest": {"main": [[{"node": "Gmail: Fetch Labeled Unread", "type": "main", "index": 0}]]}, "Gmail: Fetch Labeled Unread": {"main": [[{"node": "OpenAI: Summarize Digest", "type": "main", "index": 0}]]}, "OpenAI: Summarize Digest": {"main": [[{"node": "Gmai