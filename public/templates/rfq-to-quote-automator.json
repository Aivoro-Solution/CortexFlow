          "id": "",
          "name": "Google Sheets API"
        }
      },
      "id": "e624e023-f21d-462c-8a2c-35b7e58a136d",
      "name": "Read Catalogue",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        2160,
        300
      ]
    },
    {
      "parameters": {
        "operation": "read",
        "resource": "sheetWithinDocument",
        "documentId": {
          "__rl": true,
          "mode": "list",
          "value": "={{ $('CONFIG \\u2014 RFQ Settings').first().json.spreadsheet_id }}"
        },
        "sheetName": {
          "__rl": true,
          "mode": "list",
          "value": "={{ $('CONFIG \\u2014 RFQ Settings').first().json.price_list_sheet }}"
        },
        "options": {}
