---
import { SITE, CATEGORIES } from "../config";
const path = Astro.url.pathname;
const isActive = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
---
<header class="site-header">
  <div class="wrap">
    <a class="logo" href="/" aria-label={`${SITE.name} home`}>
      <svg width="30" height="30" viewBox="0 0 32 32" fill="none" aria-hidden="true">
        <path d="M9 16h4.5M18.5 16H23" stroke="#15151A" stroke-width="2" stroke-linecap="round"/>
        <circle cx="6.5" cy="16" r="3.6" fill="#FF4D00"/>
        <rect x="13.5" y="11.5" width="9" height="9" rx="2.5" stroke="#15151A" stroke-width="2"/>
        <circle cx="25.5" cy="16" r="3.6" stroke="#15151A" stroke-width="2"/>
      </svg>
      {SITE.name}
    </a>
    <nav class="nav" aria-label="Main navigation">
      <a href="/" class={isActive("/") ? "active" : ""}>Home</a>
      <a href="/blog/" class={isActive("/blog") ? "active" : ""}>Blog</a>
      {CATEGORIES.map((c) => (
        <a href={`/categories/${c.slug}/`} class={isActive(`/categories/${c.slug}`) ? "active" : ""}>
          {c.name}
        </a>
      ))}
      <a href="/about/" class={isActive("/about") ? "active" : ""}>About</a>
    </nav>
  </div>
</header>
