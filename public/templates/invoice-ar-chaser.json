    {
      "parameters": {
        "jsCode": "// Day-specific subject + body for the payment reminder\nconst cfg = $('CONFIG \\u2014 AR').first().json;\nconst j = $input.first().json;\nconst sender = cfg.sender_name || '';\nconst biz = cfg.business_name || '';\nconst amt = (j.currency || 'usd').toUpperCase() + ' ' + (Number(j.amount_due) / 100).toFixed(2);\nconst link = j.hosted_invoice_url || '';\nlet subject, body;\nif (j.reminder_day === 1) {\n  subject = `Friendly reminder: Invoice ${j.number} is due`;\n  body = `Hi ${j.customer_name},\\n\\nJust a friendly reminder that invoice ${j.number} for ${amt} was due on ${j.due_date}. You can pay securely here:\\n${link}\\n\\nThanks for your business!\\n\\n${sender}\\n${biz}`;\n} else if (j.reminder_day === 7) {\n  subject = `Payment overdue \\u2014 action needed: Invoice ${j.number}`;\n  body = `Hi ${j.customer_name},\\n\\nInvoice ${j.number} for ${amt} is now 7 days overdue (due ${j.due_date}). Please pay at your earliest convenience:\\n${link}\\n\\nIf you have already paid, please ignore this message.\\n\\n${sender}\\n${biz}`;\n} else {\n  subject = `Final notice before escalation: Invoice ${j.number}`;\n  body = `Hi ${j.customer_name},\\n\\nThis is a final notice: invoice ${j.number} for ${amt} is 14 days overdue (due ${j.due_date}). Please pay now to avoid further action:\\n${link}\\n\\n${sender}\\n${biz}`;\n}\nreturn [{ json: { ...j, subject, body } }];",
        "mode": "runOnceForEachItem"
      },
