    {
      "parameters": {
        "jsCode": "// One summary item: counts, quote total, and the MATCHED stage flip.\nconst rec = $('Prepare RFQ Record').first().json;\nconst lines = $('Match Lines Against Catalogue').all().map(i => i.json);\nconst matched = lines.filter(l => l.status === 'MATCHED');\nconst review = lines.filter(l => l.status === 'REVIEW');\nconst total = Math.round(matched.reduce((s, l) => s + Number(l.line_total || 0), 0) * 100) / 100;\nreturn [{ json: {\n  rfq_reference: rec.rfq_reference,\n  customer_name: rec.customer_name,\n  line_count: lines.length,\n  matched_count: matched.length,\n  review_count: review.length,\n  quote_total: total,\n  currency: $('CONFIG \\u2014 RFQ Settings').first().json.currency || 'USD',\n  stage: 'MATCHED',\n  status: 'MATCHED',\n}}];",
        "mode": "runOnceForAllItems"
      },
