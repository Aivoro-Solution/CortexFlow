    {
      "parameters": {
        "options": {
          "systemMessage": "=You are a strict AI safety reviewer. Review the requested outbound action BEFORE it executes. Block anything that looks like spam, a mass send, a duplicate of a recent action, a payment/charge the user did not explicitly approve, a message to the wrong audience, or content that is misleading, harmful, or off-brand. Be conservative: when in doubt, block and explain why. Output ONLY via the structured output parser."
        },
        "text": "=Action to review:\nClient: {{ $json.client_id }}\nAction type: {{ $json.action_type }}\nRecipient: {{ $json.recipient }}\nPayload: {{ $json.payload }}\nEstimated cost: ${{ $json.cost_usd }} (month spend so far: ${{ $json.month_spend }}, actions in the last hour: {{ $json.hour_count }})\n\nGuard checks already passed: not a duplicate, within monthly budget and hourly rate cap, kill switch off.\n\nReturn a verdict (allow / block), a short reason, and a risk_score from 0 (harmless) to 100 (definitely harmful)."
      },
      "id": "caa58a14-22fc-4d4b-b735-501b41264cd6",
      "name": "AI Agent — Risk Review",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        1680,
        300
      ]
    },
    {
      "parameters": {
