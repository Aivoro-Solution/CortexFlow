    {
      "parameters": {
        "jsCode": "// One idempotency key per invoice (invoice no. + supplier + amount):\n// a retried execution can never pay the same invoice twice.\nconst j = $input.first().json;\nconst today = new Date().toISOString().slice(0, 10).replace(/-/g, '');\nconst payment_reference = `PAY-${j.invoice_number}-${today}`;\nreturn [{ json: { ...j, payment_reference, status: 'QUEUED_FOR_PAYMENT' } }];",
        "mode": "runOnceForAllItems"
      },
      "id": "98f6fda1-f0c9-44cb-82db-db7fd4ceb41e",
      "name": "Code — Prepare Payment Batch",
