      "name": "List Open Invoices",
      "type": "n8n-nodes-base.stripe",
      "typeVersion": 1,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Compute days overdue per open invoice; keep only invoices past due\nconst items = $input.all();\nconst now = Date.now();\nconst out = [];\nfor (const i of items) {\n  const inv = i.json;\n  const due = inv.due_date ? inv.due_date * 1000 : null;\n  if (!due) continue;\n  const days_overdue = Math.floor((now - due) / 86400000);\n  if (days_overdue < 0) continue; // not due yet\n  const reminder_day = days_overdue === 1 ? 1 : days_overdue === 7 ? 7 : days_overdue === 14 ? 14 : 0;\n  out.push({ json: {\n    invoice_id: inv.id || '',\n    number: inv.number || '',\n    customer_name: inv.customer_name || '',\n    customer_email: inv.customer_email || '',\n    amount_due: inv.amount_due || 0,\n    currency: inv.currency || 'usd',\n    due_date: new Date(due).toISOString().slice(0, 10),\n    days_overdue,\n    reminder_day,\n    hosted_invoice_url: inv.hosted_invoice_url || '',\n  }});\n}\nreturn out;",
        "mode": "runOnceForAllItems"
      },
      "id": "498ec997-e5b2-4e42-8047-b4a871986fe2",
      "name": "Compute Days Overdue",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        300
      ]
    },
    {
