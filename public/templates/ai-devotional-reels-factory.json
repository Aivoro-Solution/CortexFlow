    {
      "id": "f77b9728-b39d-4ac2-b0da-831bae8115af",
      "name": "Set: Master Prompt",
      "type": "n8n-nodes-base.set",
      "position": [
        1640,
        150
      ],
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "id": "11d0ff6f-6a59-4b9f-b19e-c1753df03dff",
              "name": "json_master",
              "type": "string",
              "value": "{\n  \"description\": \"Cinematic devotional reel: a divine moment unfolds with reverent pacing.\",\n  \"style\": \"cinematic devotional | photorealistic divine\",\n  \"camera\": {\n    \"type\": \"slow dolly | gentle orbit\",\n    \"movement\": \"slow push-in toward the deity, reverent and steady\",\n    \"lens\": \"85mm portrait, shallow depth of field\"\n  },\n  \"lighting\": {\n    \"type\": \"warm divine glow\",\n    \"sources\": \"diyas, temple lamps, soft sunrise through sanctum doorway\",\n    \"FX\": \"volumetric light rays, gentle bloom, floating dust in light\"\n  },\n  \"environment\": {\n    \"location\": \"temple sanctum / ghat at dawn / home altar\",\n    \"set_pieces\": [\n      \"marigold garlands\",\n      \"brass diyas\",\n      \"incense smoke\",\n      \"flower petals\"\n    ],\n    \"mood\": \"serene, majestic, deeply peaceful\"\n  },\n  \"deity\": {\n    \"subject\": \"deity or sacred scene from the reference image\",\n    \"presentation\": \"respectful, iconographically accurate, never distorted\",\n    \"action\": \"subtle divine motion \\u2014 lamp flames flicker, petals drift, glow breathes\"\n  },\n  \"motion\": {\n    \"type\": \"slow divine reveal\",\n    \"details\": \"camera drifts closer as light blooms; petals fall in slow motion\"\n  },\n  \"VFX\": {\n    \"transformation\": \"soft golden particle drift\",\n    \"impact\": \"gentle glow pulse at the climax\",\n    \"particles\": \"dust motes, petals, ember sparks from diyas\",\n    \"environment\": \"incense smoke curling through light shafts\"\n  },\n  \"audio\": {\n    \"music\": \"soft ambient mantra drone, tanpura + distant temple bells\",\n    \"sfx\": [\n      \"diya crackle\",\n      \"soft bell\",\n      \"petal rustle\"\n    ],\n    \"ambience\": \"distant temple bells, faint chanting crowd\",\n    \"voiceover\": {\n      \"delivery\": \"none by default\",\n      \"line\": \"\"\n    }\n  },\n  \"ending\": \"Final frame: deity bathed in warm glow, slow fade to mantra text overlay\",\n  \"text\": \"none | mantra overlay at end only\",\n  \"format\": \"9:16 vertical\",\n  \"keywords\": [\n    \"deity\",\n    \"divine glow\",\n    \"slow dolly\",\n    \"devotional\",\n    \"diya light\",\n    \"marigold\",\n    \"serene\"\n  ]\n}"
            }
          ]
        }
      },
      "typeVersion": 3.4
    },
