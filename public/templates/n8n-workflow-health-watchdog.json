       "type": "number",
       "value": 24
      },
      {
       "id": "c-3",
       "name": "stale_hours",
       "type": "number",
       "value": 24
      },
      {
       "id": "c-4",
       "name": "error_spike_threshold",
       "type": "number",
       "value": 5
      },
      {
       "id": "c-5",
       "name": "ignore_workflows",
       "type": "array",
       "value": "[\"Weekly Report\", \"Monthly Cleanup\"]"
      },
      {
       "id": "c-6",
       "name": "telegram_chat_id",
       "type": "string",
       "value": "PASTE_YOUR_TELEGRAM_CHAT_ID"
      }
     ]
    },
    "includeOtherFields": false,
    "options": {}
   },
   "position": [
    490,
    300
   ],
   "type": "n8n-nodes-base.set",
   "typeVersion": 3.4
  },
  {
   "id": "56cd7851-d6fd-4eab-8998-0f696c8d9125",
   "name": "Get Active Workflows",
   "parameters": {
