---
import { getCollection } from "astro:content";
import BaseLayout from "../components/BaseLayout.astro";
import { SITE } from "../config";

const templates = (await getCollection("templates", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const featured = templates.slice(0, 6);
const pad = (n: number) => String(n).padStart(3, "0");

const difficultyLabel: Record<string, string> = {
  beginner: "Beginner",
  intermediate: "Intermediate",
  advanced: "Advanced",
};
---

<BaseLayout
  title="Free n8n Workflow Templates"
  description="Free, ready-to-import n8n workflow templates — AI agents, chatbots, and automations. Download the JSON, import in n8n, add your credentials, done."
  canonicalPath="/"
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Organization",
    name: SITE.name,
    url: SITE.url,
    logo: new URL("/og-default.svg", SITE.url).toString(),
  })} />

  <section class="hero sheet">
    <div class="wrap">
      <span class="tick tl" aria-hidden="true"></span>
      <span class="tick tr" aria-hidden="true"></span>
      <span class="tick bl" aria-hidden="true"></span>
      <span class="tick br" aria-hidden="true"></span>
      <div class="titleblock">
        <div class="tb-top">
          <div class="tb-main">
            <p class="rev">DWG NO. CF-HOME-001 · <b>REV D</b> · SCALE 1:1</p>
            <h1>Free n8n workflows, <span class="hl">ready to import.</span></h1>
            <p class="lead">
              Production-grade n8n workflow templates built from real demand — AI agents,
              chatbots, and automations. Download the JSON, import it in n8n, add your
              credentials, and you're running in minutes.
            </p>
            <div class="hero-actions">
              <a class="btn" href="/templates/">Browse templates</a>
              <a class="btn btn-ghost" href="/blog/">Read the tutorials</a>
            </div>
          </div>
          <div class="tb-meta" aria-hidden="true">
            <div><span class="k">Drawn</span><span class="v">CortexFlow</span></div>
            <div><span class="k">Checked</span><span class="v hot">Builders</span></div>
            <div><span class="k">Subject</span><span class="v">n8n templates</span></div>
            <div><span class="k">Status</span><span class="v">● In service</span></div>
          </div>
        </div>
        <div class="tb-foot" aria-hidden="true">
          <div>TOLERANCE: ZERO FLUFF</div>
          <div>UNITS: WORKFLOWS</div>
          <div>DO NOT SCALE DRAWING</div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="sec-head">
        <h2><span class="sq" aria-hidden="true"></span>Latest templates</h2>
        <a class="more" href="/templates/">View all</a>
      </div>
      {featured.length > 0 ? (
        <div class="spec-list">
          {featured.map((t, i) => (
            <a class="spec" href={`/templates/${t.id.replace(/\.md$/, "")}/`}>
              <span class="spec-no" aria-hidden="true">{pad(i + 1)}</span>
              <span class="spec-body">
                <h3 class="spec-title">{t.data.title}</h3>
                <p class="spec-desc">{t.data.description}</p>
              </span>
              <span class="spec-tag">{difficultyLabel[t.data.difficulty]} · ↓ JSON</span>
            </a>
          ))}
        </div>
      ) : (
        <p>Templates are on the drawing board — check back soon.</p>
      )}
    </div>
  </section>

  <section class="section" style="padding-top: 0;">
    <div class="wrap">
      <div class="sec-head">
        <h2><span class="sq" aria-hidden="true"></span>How it works</h2>
      </div>
      <div class="tracks">
        <div class="track">
          <p class="fig">FIG. <b>001</b></p>
          <h3>Download</h3>
          <p>Pick a template and download the workflow JSON. Free forever, no signup.</p>
        </div>
        <div class="track">
          <p class="fig">FIG. <b>002</b></p>
          <h3>Import</h3>
          <p>In n8n: Workflows → ⋯ → Import from file. The full workflow appears on your canvas.</p>
        </div>
        <div class="track">
          <p class="fig">FIG. <b>003</b></p>
          <h3>Connect &amp; run</h3>
          <p>Add your own credentials (Telegram, OpenAI, etc.), activate, and it runs.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 0;">
    <div class="wrap">
      <div class="rss-strip">
        <div class="inner">
          <div>
            <span class="fmt">DOC. CF-BLOG-001 · SECTION: TUTORIALS</span>
            <h2>Want to understand the builds?</h2>
            <p>Step-by-step tutorials on AI agents, n8n automation, and chatbots live on the blog — organized by topic.</p>
          </div>
          <a class="btn btn-ghost" href="/blog/">Visit the blog</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
