---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../components/BaseLayout.astro";
import { SITE } from "../../config";
import { categoryName, formatDate } from "../../lib/posts";

export async function getStaticPaths() {
  const templates = await getCollection("templates", ({ data }) => !data.draft);
  return templates.map((t) => ({
    params: { slug: t.id.replace(/\.md$/, "") },
    props: { t },
  }));
}

const { t } = Astro.props;
const { Content } = await render(t);
const slug = t.id.replace(/\.md$/, "");
const url = `/templates/${slug}/`;
const fileName = t.data.workflow.split("/").pop();

const difficultyLabel: Record<string, string> = {
  beginner: "Beginner",
  intermediate: "Intermediate",
  advanced: "Advanced",
};

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: t.data.title,
  description: t.data.description,
  applicationCategory: "DeveloperApplication",
  operatingSystem: "Any",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  author: { "@type": "Organization", name: SITE.name },
  datePublished: t.data.date.toISOString(),
  mainEntityOfPage: new URL(url, SITE.url).toString(),
};
---

<BaseLayout
  title={t.data.title}
  description={t.data.description}
  canonicalPath={url}
  type="article"
  publishedTime={t.data.date.toISOString()}
  modifiedTime={(t.data.updated ?? t.data.date).toISOString()}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <div class="prose-wrap">
    <section class="section prose">
      <p class="breadcrumb"><a href="/">Home</a> / <a href="/templates/">Templates</a> / {t.data.title}</p>
      <p class="kicker">CORTEXFLOW · FREE FOREVER</p>
      <p class="post-kicker">{categoryName(t.data.category)}</p>
      <h1 style="text-transform: uppercase;">{t.data.title}</h1>
      <p class="post-meta">
        <time datetime={t.data.date.toISOString()}>{formatDate(t.data.date)}</time>
        {" · "}{difficultyLabel[t.data.difficulty]}{" · "}{categoryName(t.data.category)}
      </p>

      <div class="tpl-download">
        <a class="tpl-download__btn" href={t.data.workflow} download={fileName}>
          ↓ Download workflow JSON
        </a>
        <p class="tpl-download__hint">
          Import in n8n: <b>Workflows → ⋯ → Import from file</b>, then add your credentials.
          Free to use — no signup needed.
        </p>
      </div>

      <Content />

      <div class="tpl-download tpl-download--bottom">
        <a class="tpl-download__btn" href={t.data.workflow} download={fileName}>
          ↓ Download {fileName}
        </a>
      </div>

      <p style="margin-top: 2rem;">
        <a href="/templates/">← All templates</a>
      </p>
    </section>
  </div>
</BaseLayout>
