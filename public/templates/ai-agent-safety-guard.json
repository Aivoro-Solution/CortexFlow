      "id": "109bdad4-2347-484a-9243-06741d003215",
      "name": "HTTP Request — Execute Target Action",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2400,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// The target endpoint must confirm success; anything else is FAILED,\n// and a FAILED row is visible in the ledger (never silently marked DONE).\nconst res = $input.first().json;\nconst req = $('Code \\u2014 Build Agent Decision').first().json;\nconst ok = !!(res && (res.ok === true || res.success === true\n  || [200, 201, 202].includes(Number(res.statusCode || res.status))));\nreturn [{ json: {\n  ...req,\n  status: ok ? 'DONE' : 'FAILED',\n  provider_ref: (res && (res.id || res.message_id || res.reference || '')) || '',\n  decision_reason: ok ? req.decision_reason\n    : 'Target endpoint did not confirm success: ' + JSON.stringify(res).slice(0, 200),\n} }];",
        "mode": "runOnceForAllItems"
      },
      "id": "79cca454-4e89-4da0-b77c-96bc3b5fab6a",
      "name": "Code — Verify Execution",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
