    {
      "parameters": {
        "options": {
          "systemMessage": "=You are a lead-qualification assistant for a local services business. Qualify this inbound lead honestly.\n\nBUSINESS: {{ $('CONFIG \\u2014 Lead Business').first().json.BUSINESS_NAME }}\nSERVICES: {{ $('CONFIG \\u2014 Lead Business').first().json.SERVICES_LIST }}\n\nScore buying intent 0-100. Tag urgency: HOT = ready to buy/book within 24-48h with clear need and reachable contact info; WARM = interested but vague or far out; COLD = spam, test message, or no real need. Write a one-paragraph summary, suggest the concrete next step, and guess the best time to reach them. Output ONLY via the structured output parser."
        },
        "text": "=Lead name: {{ $('Normalize Lead').first().json.name }}\nPhone: {{ $('Normalize Lead').first().json.phone }}\nEmail: {{ $('Normalize Lead').first().json.email }}\nSource: {{ $('Normalize Lead').first().json.source }}\n\nLead's message:\n{{ $('Normalize Lead').first().json.message }}"
      },
      "id": "af227a62-2184-4693-807a-cb8e8d9faa84",
      "name": "AI Agent — Qualify Lead",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        1440,
        300
      ]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4o-mini"
        },
        "options": {}
      },
      "credentials": {
        "openAiApi": {
          "id": "",
          "name": "OpenAI API"
        }
      },
      "id": "24b0df78-15d9-40ac-826f-5803b2dbf95a",
      "name": "OpenAI Chat Model — Qualify",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [
        1440,
        560
      ]
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"lead_score\": 85,\n  \"urgency\": \"HOT / WARM / COLD\",\n  \"summary\": \"one-paragraph summary of who this lead is and what they need\",\n  \"suggested_next_step\": \"concrete next action (e.g. call within 10 minutes, send booking link)\",\n  \"best_contact_time\": \"best time window to reach them\"\n}"
      },
      "id": "f48c6cbc-f2ac-446c-832c-3fe335bcfcb4",
      "name": "Structured Output Parser — Qualification",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [
        1680,
        560
      ]
    },
    {
      "parameters": {
        "jsCode": "// Flatten the AI agent's structured output and carry the lead forward\nconst out = $input.first().json.output || {};\nconst lead = $('Normalize Lead').first().json;\nconst cfg = $('CONFIG \\u2014 Lead Business').first().json;\nreturn [{ json: {\n  name: lead.name,\n  phone: lead.phone,\n  email: lead.email,\n  source: lead.source,\n  message: lead.message,\n  lead_score: Number(out.lead_score) || 0,\n  urgency: out.urgency || 'WARM',\n  summary: out.summary || '',\n  suggested_next_step: out.suggested_next_step || '',\n  best_contact_time: out.best_contact_time || '',\n  business_name: cfg.BUSINESS_NAME,\n  booking_link: cfg.BOOKING_LINK,\n}}];",
        "mode": "runOnceForAllItems"
      },
      "id": "e467d110-80e4-44c5-ab13-27c27cff177d",
      "name": "Parse Qualification",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1680,
        300
      ]
    },
    {
