    {
      "parameters": {
        "jsCode": "// After the reply window: find still-open offers and build the closing summary\nconst rows = $('Sheets \\u2014 Re-read Offers').all().map(i => i.json);\nconst now = Date.now();\nconst expired = rows.filter(r =>\n  r['Status'] === 'OFFER_SENT' && r['Offer Expires At'] && Date.parse(r['Offer Expires At']) <= now\n);\nconst booked = rows.filter(r => r['Status'] === 'BOOKED');\nconst slot = (rows[0] && rows[0]['Slot Time']) || '';\nlet summary;\nif (booked.length) {\n  const b = booked[0];\n  summary = `\\u2705 Slot ${slot} was claimed by ${b['Name'] || b['Phone']} (${b['Phone']}). Nothing to expire.`;\n} else if (expired.length) {\n  summary = `\\u23F0 Reply window closed for slot ${slot}. ${expired.length} unclaimed offer(s) marked EXPIRED.`;\n} else {\n  summary = `\\u2139\\uFE0F Reply window closed for slot ${slot}. No open offers found.`;\n}\nconst items = expired.map(r => ({ json: {\n  appointment_id: r['Appointment ID'],\n  phone: r['Phone'],\n  status: 'EXPIRED',\n  summary,\n}}));\nif (!items.length) items.push({ json: { none_expired: True, summary } });\nreturn items;",
        "mode": "runOnceForAllItems"
      },
