    {
      "parameters": {
        "jsCode": "// Combine AI copy with the deterministic reply instruction + provider config\nconst cfg = $('CONFIG \\u2014 Waitlist Rules').first().json;\nconst windowMin = cfg.reply_window_minutes || '120';\nconst keyword = cfg.reply_keyword || 'TAKE';\nreturn $input.all().map(i => {\n  const j = i.json;\n  const aiText = (j.output && j.output.offer_text) || '';\n  const fallback = `Hi ${j.name || 'there'}! A ${j.service || 'appointment'} slot opened at ${j.slot_time} and you're top of our waitlist.`;\n  const message = (aiText || fallback) + `\\n\\nReply ${keyword} within ${windowMin} minutes to claim it.`;\n  return { json: Object.assign({}, j, {\n    message,\n    provider_url: cfg.message_provider_url,\n    api_token: cfg.message_api_token,\n    sender_id: cfg.sender_id,\n  })};\n});",
        "mode": "runOnceForAllItems"
      },
