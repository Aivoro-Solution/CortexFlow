    {
      "parameters": {
        "jsCode": "// First TAKE wins: match the reply to the latest still-open offer for this phone\nconst reply = $('Code \\u2014 Normalize Reply').first().json;\nconst rows = $input.all().map(i => i.json);\nconst now = Date.now();\nconst open = rows.filter(r =>\n  String(r['Phone'] || '').replace(/\\D/g, '') === reply.phone &&\n  r['Status'] === 'OFFER_SENT' &&\n  r['Offer Expires At'] && Date.parse(r['Offer Expires At']) > now\n).sort((a, b) => Date.parse(b['Offer Sent At'] || 0) - Date.parse(a['Offer Sent At'] || 0));\nconst win = open[0];\nif (!reply.wants_slot || !win) {\n  return [{ json: { found: False, phone: reply.phone, message: reply.message } }];\n}\nreturn [{ json: {\n  found: True,\n  appointment_id: win['Appointment ID'],\n  slot_time: win['Slot Time'],\n  service: win['Service'],\n  name: win['Name'],\n  phone: win['Phone'],\n  reply_at: new Date().toISOString(),\n}}];",
        "mode": "runOnceForAllItems"
