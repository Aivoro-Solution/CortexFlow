    {
      "parameters": {
        "jsCode": "// Flag invoices not yet present in the AR sheet (is_new: 1 = new, 0 = existing)\nconst seen = new Set(\n  $('Read AR Ledger').all().map(i => String(i.json['Invoice ID'] || '').trim()).filter(Boolean)\n);\nreturn $input.all().map(i => ({ json: {\n  ...i.json,\n  is_new: seen.has(String(i.json.invoice_id || '').trim()) ? 0 : 1,\n}}));",
        "mode": "runOnceForAllItems"
      },
