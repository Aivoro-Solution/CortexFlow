---
import BaseLayout from "../components/BaseLayout.astro";
import { SITE, CATEGORIES } from "../config";
import { getPublishedPosts, postUrl, formatDate, categoryName } from "../lib/posts";

const posts = await getPublishedPosts();
const latest = posts.slice(0, 6);
const pad = (n: number) => String(n).padStart(3, "0");
---

<BaseLayout
  title="AI Agents, Automation & Chatbots Tutorials"
  description="Hands-on tutorials on AI agents, workflow automation, and chatbots — step-by-step builds and honest tool comparisons, no fluff."
  canonicalPath="/"
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Organization",
    name: SITE.name,
    url: SITE.url,
    logo: new URL("/og-default.svg", SITE.url).toString(),
  })} />
  <section class="hero sheet">
    <div class="wrap">
      <span class="tick tl" aria-hidden="true"></span>
      <span class="tick tr" aria-hidden="true"></span>
      <span class="tick bl" aria-hidden="true"></span>
      <span class="tick br" aria-hidden="true"></span>
      <div class="titleblock">
        <div class="tb-top">
          <div class="tb-main">
            <p class="rev">DWG NO. CF-HOME-001 · <b>REV D</b> · SCALE 1:1</p>
            <h1>Ship AI agents that <span class="hl">actually work.</span></h1>
            <p class="lead">
              Step-by-step tutorials on AI agents, n8n automation, and chatbots —
              real builds, honest tool comparisons, zero fluff. The kind of guide
              you keep open in a second tab while you build.
            </p>
            <div class="hero-actions">
              <a class="btn" href="/blog/">Browse tutorials</a>
              <a class="btn btn-ghost" href="/about/">What is this site?</a>
            </div>
          </div>
          <div class="tb-meta" aria-hidden="true">
            <div><span class="k">Drawn</span><span class="v">CortexFlow</span></div>
            <div><span class="k">Checked</span><span class="v hot">Builders</span></div>
            <div><span class="k">Subject</span><span class="v">AI agents</span></div>
            <div><span class="k">Status</span><span class="v">● In service</span></div>
          </div>
        </div>
        <div class="tb-foot" aria-hidden="true">
          <div>TOLERANCE: ZERO FLUFF</div>
          <div>UNITS: TUTORIALS</div>
          <div>DO NOT SCALE DRAWING</div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="sec-head">
        <h2><span class="sq" aria-hidden="true"></span>Latest tutorials</h2>
        <a class="more" href="/blog/">View all</a>
      </div>
      <div class="spec-list">
        {latest.map((post, i) => (
          <a class="spec" href={postUrl(post)}>
            <span class="spec-no" aria-hidden="true">{pad(i + 1)}</span>
            <span class="spec-body">
              <h3 class="spec-title">{post.data.title}</h3>
              <p class="spec-desc">{post.data.description}</p>
            </span>
            <span class="spec-tag">{categoryName(post.data.category)}</span>
          </a>
        ))}
      </div>
      {posts.length === 0 && <p>No posts published yet. Check back soon.</p>}
    </div>
  </section>

  <section class="section" style="padding-top: 0;">
    <div class="wrap">
      <div class="sec-head">
        <h2><span class="sq" aria-hidden="true"></span>Pick your track</h2>
      </div>
      <div class="tracks">
        {CATEGORIES.map((c, i) => (
          <a class="track" href={`/categories/${c.slug}/`}>
            <p class="fig">FIG. <b>{pad(i + 1)}</b></p>
            <h3>{c.name}</h3>
            <p>{c.description}</p>
          </a>
        ))}
      </div>

      <div class="rss-strip">
        <div class="inner">
          <div>
            <span class="fmt">DOC. CF-RSS-001 · FORMAT: XML</span>
            <h2>Prefer reading offline?</h2>
            <p>Every tutorial ships with a full RSS feed. No newsletter signup, no spam — just the feed.</p>
          </div>
          <a class="btn btn-ghost" href="/rss.xml">Subscribe via RSS</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
