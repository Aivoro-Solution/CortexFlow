    {
      "parameters": {
        "jsCode": "// Build the owner email HTML from totals + AI insights\nconst totals = $('Compute Weekly Totals').first().json;\nconst ai = $('AI Agent \\u2014 Weekly Sales Analyst').first().json.output;\nconst esc = s => String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst storeRows = totals.stores.map(s =>\n  '<tr><td>' + esc(s.store) + '</td><td>' + s.revenue.toFixed(2) + '</td><td>' + s.orders_qty +\n  '</td><td>' + (s.wow_pct == null ? 'n/a' : (s.wow_pct > 0 ? '+' : '') + s.wow_pct + '%') + '</td></tr>'\n).join('');\nconst topRows = totals.top_items.map(t =>\n  '<li>' + esc(t.item) + ' \\u2014 ' + esc(t.store) + ' (' + t.revenue.toFixed(2) + ')</li>'\n).join('');\nconst insights = (ai.insights || []).map(x => '<li>' + esc(x) + '</li>').join('');\nconst flags = (ai.red_flags || []).map(x => '<li>' + esc(x) + '</li>').join('');\nconst wowStr = totals.overall_wow_pct == null ? 'n/a' :\n  (totals.overall_wow_pct > 0 ? '+' : '') + totals.overall_wow_pct + '%';\nconst html = '<h2>📊 Weekly Sales Report \\u2014 ' + esc(totals.week_start) + ' to ' + esc(totals.week_end) + '</h2>'\n  + '<p><b>Total revenue:</b> ' + totals.total_revenue.toFixed(2) + ' &nbsp;|&nbsp; <b>Week-over-week:</b> ' + wowStr\n  + ' &nbsp;|&nbsp; <b>Units sold:</b> ' + totals.total_qty + ' &nbsp;|&nbsp; <b>Stores:</b> ' + totals.store_count + '</p>'\n  + '<h3>Per-store performance</h3>'\n  + '<table border=\\'1\\' cellpadding=\\'6\\' cellspacing=\\'0\\'><tr><th>Store</th><th>Revenue</th><th>Units</th><th>WoW</th></tr>' + storeRows + '</table>'\n  + '<h3>Top items this week</h3><ol>' + topRows + '</ol>'\n  + '<h3>AI insights</h3><ul>' + insights + '</ul>'\n  + (flags ? '<h3>\\u26A0\\uFE0F Red flags</h3><ul>' + flags + '</ul>' : '')\n  + '<p style=\\'color:#888\\'>Generated by the Multi-Store Sales Consolidator workflow.</p>';\nreturn [{ json: {\n  report_title: 'Weekly Sales Report \\u2014 ' + totals.week_start,\n  report_html: html,\n  total_revenue: totals.total_revenue,\n  week_start: totals.week_start, week_end: totals.week_end,\n}}];",
        "mode": "runOnceForAllItems"
      },
