        "inputSchema": "{\n  \"standout_metric\": \"the single most important number or change this week\",\n  \"risk\": \"the biggest risk or warning sign in the data\",\n  \"recommendation\": \"one concrete action to take next week\",\n  \"summary\": \"60-second plain-language summary of the week\"\n}"
