    {
      "parameters": {
        "jsCode": "// Normalize the incoming lead payload\nconst b = $input.first().json;\nreturn [{ json: {\n  name: (b.name || 'there').trim(),\n  phone: String(b.phone || '').replace(/[^\\d+]/g, ''),\n  email: (b.email || '').trim(),\n  message: (b.message || '').trim(),\n  source: (b.source || 'unknown').trim(),\n  timestamp: new Date().toISOString(),\n}}];",
        "mode": "runOnceForEachItem"
      },
      "id": "467ed26b-89ac-4c84-af17-e0abc00f96a9",
      "name": "Normalize Lead",
