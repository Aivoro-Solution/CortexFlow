    {
      "parameters": {
        "jsCode": "// One Telegram summary of today's AR run (deterministic from invoice data)\nconst all = $('Compute Days Overdue').all().map(i => i.json);\nconst cfg = $('CONFIG \\u2014 AR').first().json;\nconst esc = parseInt(cfg.escalation_day || '14', 10);\nconst overdue = all.filter(j => j.days_overdue > 0);\nconst total = overdue.reduce((s, j) => s + Number(j.amount_due || 0), 0);\nconst cur = (overdue[0] && overdue[0].currency || 'usd').toUpperCase();\nconst oldest = overdue.reduce((m, j) => Math.max(m, j.days_overdue), 0);\nconst reminded = all.filter(j => j.reminder_day > 0).length;\nconst escalated = all.filter(j => j.reminder_day === 0 && j.days_overdue >= esc).length;\nconst fmt = c => (c / 100).toFixed(2);\nconst lines = [\n  `\\U0001F9FE *AR Summary \\u2014 ${new Date().toISOString().slice(0, 10)}*`,\n  ``,\n  `\\U0001F4B0 Total outstanding: *${cur} ${fmt(total)}* (${overdue.length} invoices)`,\n  `\\u23F0 Oldest overdue: *${oldest} days*`,\n  `\\u2709\\uFE0F Reminders sent today: *${reminded}*`,\n  `\\U0001F534 Escalated today: *${escalated}*`,\n];\nreturn [{ json: {\n  summary: lines.join('\\n'),\n  total_outstanding: total,\n  invoices_reminded_today: reminded,\n  escalated_today: escalated,\n  oldest_overdue_days: oldest,\n}}];",
        "mode": "runOnceForAllItems"
      },
      "id": "981f853d-a0f4-40c5-963b-4740d6df2ffd",
      "name": "Build AR Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3840,
        300
      ]
    },
