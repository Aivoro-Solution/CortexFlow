        }
      },
      "id": "4891c0f9-ba53-45a8-b4b6-de202f4c1939",
      "name": "Google Sheets — Read Suppliers",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        2160,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Allowlist check: known supplier? Bank details unchanged vs stored record?\nconst inv = $('Code \\u2014 Dedupe + Kill-Switch Check').first().json;\nconst suppliers = $input.all().map(i => i.json);\nconst norm = (s) => (s || '').toString().trim().toLowerCase();\nconst row = suppliers.find(r => norm(r['Supplier']) === norm(inv.supplier));\nlet supplier_status = 'KNOWN', supplier_reason = '';\nif (!row) {\n  supplier_status = 'NEW_SUPPLIER';\n  supplier_reason = `Supplier ${inv.supplier} is not on the allowlist`;\n} else if (inv.bank_account_last4 && row['Bank Account Last 4']\n    && String(row['Bank Account Last 4']).slice(-4) !== String(inv.bank_account_last4).slice(-4)) {\n  supplier_status = 'BANK_CHANGED';\n  supplier_reason = `Bank details for ${inv.supplier} changed (last-4 mismatch vs stored record)`;\n} else if (norm(row['Status']) === 'blocked') {\n  supplier_status = 'SUPPLIER_BLOCKED';\n  supplier_reason = `Supplier ${inv.supplier} is marked blocked in the Suppliers sheet`;\n}\nreturn [{ json: { ...inv, supplier_status, supplier_reason } }];",
        "mode": "runOnceForAllItems"
      },
      "id": "890034f9-828f-4ca3-aa07-a00306c43c34",
      "name": "Code — Supplier Check",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2400,
        300
      ]
    },
    {
