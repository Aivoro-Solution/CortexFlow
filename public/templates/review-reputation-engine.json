    {
      "parameters": {
        "jsCode": "// One-line summary of the rating event for the shared digest\nconst j = $input.first().json;\nconst route = j.stars < 4 ? 'FLAGGED — support alerted' : 'REVIEW_ASKED — Google link sent';\nreturn [{ json: {\n  flow: 'A',\n  summary: '⭐ ' + j.stars + '/5 rating from ' + (j.customer_name || 'a customer') + ' (Job ' + j.job_id + ') → ' + route,\n}}];",
        "mode": "runOnceForAllItems"
      },
      "id": "79530afb-33cf-45ed-b753-627726051451",
      "name": "Build Flow-A Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3600,
        300
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 24,
              "triggerAtHour": 8,
              "triggerAtMinute": 0
            }
          ]
        }
      },
      "id": "f8ca22be-6851-4259-bd89-f8acd89e2889",
      "name": "Daily Review Check — 8AM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        900
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "111d502e-ccf0-4468-ad90-ba5a308c3325",
              "name": "gbp_access_token",
