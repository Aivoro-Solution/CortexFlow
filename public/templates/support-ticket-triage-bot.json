ue,"mode":"id","value":"YOUR_SPREADSHEET_ID"},"operation":"read","options":{},"resource":"sheetWithinDocument","sheetName":{"__rl":true,"cachedResultName":"OpenTickets","mode":"list","value":"OpenTickets"}},"position":[480,700],"type":"n8n-nodes-base.googleSheets","typeVersion":4.5},{"id":"c3d4e5f6-2213-4a5b-8c9d-000000000004","name":"IF SLA Breached","parameters":{"conditions":{"combinator":"and","conditions":[{"id":"c3d4e5f6-22f2-4a5b-8c9d-f2f2f2f2f2f2","leftValue":"={{ $json.sla_deadline }}","operator":{"name":"filter.operator.dateTime.before","operation":"before","type":"dateTime"},"rightValue":"={{ $now.toISO() }}"}],"options":{"caseSensitive":true,"leftValue":"","typeValidation":"loose"}},"looseTypeValidation":true,"options":{}},"position":[720,700],"type":"n8n-nodes-base.if","typeVersion":2.2},{"credentials":{"slackOAuth2Api":{"id":"","name":"Slack API"}},"id":"c3d4e5f6-2214-4a5b-8c9d-000000000005","name":"Slack SLA Escalation","parameters":{"channelId":{"__rl":true,"mode":"name","value":"support-alerts"},"operation":"send","otherOptions":{},"resource":"message","select":"channel","text":"=SLA BREACHED — ticket {{ $json.ticket_id }}: {{ $json.subject }}\nDeadline was {{ $json.sla_deadline }}. Escalating."},"position":[960,700],"type":"n8n-nodes-base.slack","typeVersion":2.2},{"id":"c3d4e5f6-2215-4a5b-8c9d-000000000006","name":"Sticky Note","parameters":{"color":4,"content":"## Multi-Channel Support Ticket Triage\n\n**Chain 1 — auto-triage:**\n1. Point your forms, chat widget, or email parser at the *New Ticket Webhook* URL (POST JSON: id, subject, body, channel).\n2. Create an **OpenAI** credential; select it in *Classify Ticket (AI)*.\n3. In *Update Ticket System* replace https://api.your-ticket-system.com/v1/tickets/{id} with your real endpoint (Zendesk, Intercom, Freshdesk) and add auth — e.g. an HTTP Header Auth credential with your API token.\n4. Create a **Slack** credential; select it in both Slack nodes and set your channel names.\n5. Edit the *Set Queue* nodes so the queue names match your team's real queues.\n\n**Chain 2 — SLA watchdog (every 15 min):**\n1. Create a **Google Sheets** credential; in *Read Open Tickets* select your spreadsheet and sheet. Required columns: ticket_id, subject, sla_deadline (ISO timestamp), status.\n2. Tune the cron in *SLA Check Timer* if 15 minutes is not your cadence.\n\n**How it works:** Webhook -> AI classifies each ticket (P1-P4 + category, strict JSON) -> Switch routes by priority -> queue assigned -> ticket system updated -> P1s also trigger an urgent Slack alert. Every 15 min, open tickets past their SLA deadline escalate to Slack.","height":440,"width":470},"position":[160,-80],"type":"n8n-nodes-base.stickyNote","typeVersion":1}],"pinData":{},"settings":{"executionOrder":"v1"},"tags":[{"name":"cortexflow-template"}],"versionId":"cortexflow-support-ticket-triage-bot-v1"}