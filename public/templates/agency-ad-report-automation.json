    {
      "parameters": {
        "method": "POST",
        "url": "=https://googleads.googleapis.com/v17/customers/{{$('CONFIG — API Access').first().json.google_ads_customer_id}}/googleAds:search",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$('CONFIG — API Access').first().json.google_oauth_token}}"
            },
            {
              "name": "developer-token",
              "value": "={{$('CONFIG — API Access').first().json.google_ads_developer_token}}"
