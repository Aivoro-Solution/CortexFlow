      "position": [
        4320,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('CONFIG \\u2014 Policy & Caps').first().json.payment_provider_base_url }}/v1/payments",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Idempotency-Key",
              "value": "={{ $json.idempotency_key }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('CONFIG \\u2014 Policy & Caps').first().json.payment_api_key }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
