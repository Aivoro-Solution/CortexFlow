---
import BaseLayout from "../../components/BaseLayout.astro";
import CategoryIcon from "../../components/CategoryIcon.astro";
import { CATEGORIES } from "../../config";
import { getPublishedPosts, postUrl, formatDate } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return CATEGORIES.map((c) => ({
    params: { category: c.slug },
    props: {
      category: c,
      posts: posts.filter((p) => p.data.category === c.slug),
    },
  }));
}

const { category, posts } = Astro.props;
---

<BaseLayout
  title={category.name}
  description={`${category.description} Browse all ${category.name.toLowerCase()} tutorials and guides.`}
  canonicalPath={`/categories/${category.slug}/`}
>
  <section class="section">
    <div class="wrap">
      <p class="breadcrumb"><a href="/">Home</a> / Categories</p>
      <div style="display: flex; align-items: center; gap: 1rem; margin: 0 0 0.75rem;">
        <CategoryIcon slug={category.slug} />
        <h1 style="margin: 0;">{category.name}</h1>
      </div>
      <p style="color: var(--muted); margin: 0 0 2rem;">{category.description}</p>

      {posts.length > 0 ? (
        <div class="post-index">
          {posts.map((post) => (
            <a class="post-row" href={postUrl(post)}>
              <span class="row-date">
                <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
              </span>
              <span>
                <h3>{post.data.title}</h3>
                <p>{post.data.description}</p>
              </span>
            </a>
          ))}
        </div>
      ) : (
        <p>No posts in this category yet — check back soon.</p>
      )}
    </div>
  </section>
</BaseLayout>
