    {
      "parameters": {
        "jsCode": "// Extract order number (#1234 or \"order 1234\") from subject + body\nconst j = $input.item.json;\nconst subject = j.subject || j.snippet || '';\nlet body = j.body || j.text || '';\nif (!body && j.payload && Array.isArray(j.payload.parts)) {\n  try {\n    for (const p of j.payload.parts) {\n      if (p.mimeType && p.mimeType.indexOf('text/plain') === 0 && p.body && p.body.data) {\n        body += Buffer.from(p.body.data, 'base64').toString('utf8') + '\\n';\n      }\n    }\n  } catch (e) {}\n}\nif (!body) body = j.snippet || '';\nconst text = subject + ' ' + body;\nconst m = text.match(/#(\\d{3,})|\\border\\s*(?:number|no\\.?|#)?\\s*(\\d{3,})/i);\nconst order_number = m ? (m[1] || m[2] || '') : '';\nlet from = '';\ntry {\n  const f = j.from || j.payload;\n  if (typeof f === 'string') from = f;\n  else if (f && f.value) from = f.value;\n  else if (f && f.address) from = f.address;\n  else if (j.payload && Array.isArray(j.payload.headers)) {\n    const h = j.payload.headers.find(x => x.name && x.name.toLowerCase() === 'from');\n    if (h) from = h.value;\n  }\n} catch (e) {}\nreturn [{ json: {\n  message_id: j.id || '',\n  thread_id: j.threadId || '',\n  from: String(from),\n  subject: String(subject),\n  body_snippet: String(body).slice(0, 1500),\n  order_number: order_number,\n}}];",
        "mode": "runOnceForEachItem"
      },
      "id": "18038795-af4e-49df-8b8d-5ee0c2822c6b",
      "name": "Extract Order Number",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        300
      ]
    },
