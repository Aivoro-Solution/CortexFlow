    {
      "parameters": {
        "jsCode": "// Normalize inbound payloads from PMS/channel-manager/email bridges into one shape\nconst body = $input.first().json;\nconst cfg = $('CONFIG — Properties & Rules').first().json;\nconst msg = body.message || body.text || body.body || '';\nreturn [{ json: {\n  message_id: body.message_id || ('msg-' + Date.now()),\n  timestamp: new Date().toISOString(),\n  channel: body.channel || body.source || 'unknown',\n  property: body.property || body.property_name || cfg.property_name,\n  guest_name: body.guest_name || body.guest || 'Guest',\n  message: msg,\n} }];",
        "mode": "runOnceForAllItems"
      },
      "id": "0c2f1796-1702-4a22-8a29-16cb3f1af6a6",
      "name": "Normalize Guest Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        560,
        300
      ]
    },
