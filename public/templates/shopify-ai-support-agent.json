    {
      "parameters": {
        "jsCode": "// Combine extracted email fields with the Shopify lookup.\n// The lookup may have failed (no order number / not found) — in that case\n// $input carries the passthrough item, which is NOT a real order JSON.\nconst email = $('Extract Order Number').item.json;\nconst oj = $input.first().json || {};\nconst isOrder = !!(oj && (oj.financial_status !== undefined || oj.line_items !== undefined));\nreturn [{ json: {\n  ...email,\n  order_found: isOrder,\n  order: isOrder ? oj : {},\n}}];",
        "mode": "runOnceForEachItem"
      },
      "id": "7c6aa842-6f8b-4039-9c11-d6453a0df344",
      "name": "Merge Order Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        300
      ]
    },
    {
