    },
    {
      "parameters": {
        "jsCode": "// Blend Meta, Google Ads, and GA4 results into weekly totals\nconst meta = $('Meta Ads \\u2014 Pull Insights').first().json;\nconst gads = $('Google Ads \\u2014 Pull GAQL').first().json;\nconst ga4  = $('GA4 \\u2014 Pull Conversions').first().json;\n\nconst sum = (arr, f) => (Array.isArray(arr) ? arr : []).reduce((t, r) => t + (Number(f(r)) || 0), 0);\n\n// Meta insights rows\nconst metaRows = meta.data || [];\nconst metaSpend = sum(metaRows, r => r.spend);\nconst metaClicks = sum(metaRows, r => r.clicks);\nconst metaImpr = sum(metaRows, r => r.impressions);\nconst metaConv = sum(metaRows, r => (r.actions || [])\n  .filter(a => /purchase|lead|conversion/i.test(a.action_type || ''))\n  .reduce((t, a) => t + Number(a.value || 0), 0));\n\n// Google Ads GAQL rows\nconst gadsRows = gads.results || [];\nconst gadsSpend = sum(gadsRows, r => (r.metrics && r.metrics.costMicros ? Number(r.metrics.costMicros) / 1e6 : 0));\nconst gadsClicks = sum(gadsRows, r => r.metrics && r.metrics.clicks);\nconst gadsImpr = sum(gadsRows, r => r.metrics && r.metrics.impressions);\nconst gadsConv = sum(gadsRows, r => r.metrics && r.metrics.conversions);\n\n// GA4 channel rows (metricValues order: sessions, conversions, totalRevenue)\nconst ga4Rows = ga4.rows || [];\nconst ga4Conv = sum(ga4Rows, r => Number((r.metricValues && r.metricValues[1] && r.metricValues[1].value) || 0));\nconst revenue = sum(ga4Rows, r => Number((r.metricValues && r.metricValues[2] && r.metricValues[2].value) || 0));\n\nconst total_spend = +(metaSpend + gadsSpend).toFixed(2);\nconst total_clicks = Math.round(metaClicks + gadsClicks);\nconst total_impressions = Math.round(metaImpr + gadsImpr);\nconst total_conversions = Math.round(metaConv + gadsConv + ga4Conv);\nconst roas = total_spend > 0 ? +(revenue / total_spend).toFixed(2) : 0;\nconst ctr = total_impressions > 0 ? +((total_clicks / total_impressions) * 100).toFixed(2) : 0;\nconst cpa = total_conversions > 0 ? +(total_spend / total_conversions).toFixed(2) : 0;\n\nreturn [{ json: {\n  period: 'last 7 days',\n  meta: { spend: +metaSpend.toFixed(2), clicks: Math.round(metaClicks), impressions: Math.round(metaImpr), conversions: Math.round(metaConv) },\n  google_ads: { spend: +gadsSpend.toFixed(2), clicks: Math.round(gadsClicks), impressions: Math.round(gadsImpr), conversions: Math.round(gadsConv) },\n  ga4: { conversions: Math.round(ga4Conv), revenue: +revenue.toFixed(2) },\n  total_spend, total_clicks, total_impressions, total_conversions,\n  revenue: +revenue.toFixed(2), roas, ctr_pct: ctr, cpa,\n}}];",
        "mode": "runOnceForAllItems"
      },
      "id": "a798cafb-c917-48d4-914c-a4407f1f15f4",
