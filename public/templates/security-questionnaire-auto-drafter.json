    {
      "parameters": {
        "jsCode": "// Count statuses from the Draft Log rows\nconst rows = $input.all().map(i => i.json);\nconst total = rows.length;\nconst status = r => String(r['Status'] || '').toUpperCase();\nconst approved = rows.filter(r => status(r) === 'APPROVED').length;\nconst inReview = rows.filter(r => status(r) === 'IN_REVIEW').length;\nconst drafted = rows.filter(r => status(r) === 'DRAFTED').length;\nconst date = new Date().toISOString().slice(0, 10);\nconst lines = [\n  `🛡️ *Security Questionnaire Drafting — ${date}*`,\n  ``,\n  `📋 ${total} questions processed`,\n  `✅ ${approved} auto-approved`,\n  `🧑‍💻 ${inReview} need human review`,\n];\nif (drafted) lines.push(`📝 ${drafted} drafted (below review gate)`);\nlines.push(``, `📊 Full log: Draft Log tab`);\nreturn [{ json: { summary: lines.join('\\n'), total, approved, in_review: inReview, drafted } }];",
        "mode": "runOnceForAllItems"
      },
      "id": "b613e961-ee6f-4a00-87a7-00e8a083b789",
      "name": "Build Run Summary",
