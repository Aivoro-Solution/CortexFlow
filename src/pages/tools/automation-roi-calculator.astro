---
import BaseLayout from "../../components/BaseLayout.astro";
import { SITE } from "../../config";
---
<BaseLayout
  title="Automation ROI Calculator — Free Tool"
  description="How much money does automation actually save? Enter hours saved and labor cost — get monthly and yearly savings plus payback period."
  canonical={`${SITE.url}/tools/automation-roi-calculator/`}
>
  <main class="wrap tool-page">
    <nav class="crumbs"><a href="/">Home</a> <span>/</span> <a href="/tools/">Tools</a> <span>/</span> <span>ROI calculator</span></nav>
    <p class="kicker">Free tool</p>
    <h1>Automation ROI calculator</h1>
    <p class="lede">Put a dollar number on your automations. Useful for justifying the project to your boss — or to yourself.</p>

    <div class="calc">
      <div class="inputs">
        <label>Hours saved / week<input type="number" id="hours" value="10" min="0" /></label>
        <label>Avg. hourly cost ($)<input type="number" id="rate" value="30" min="0" /></label>
        <label>One-time setup cost ($)<input type="number" id="setup" value="500" min="0" /></label>
        <button class="btn" id="go">Calculate</button>
      </div>
      <div class="results" id="results" hidden>
        <div class="rcard winner"><h3>Yearly savings</h3><p class="price" id="p-year">—</p></div>
        <div class="rcard"><h3>Monthly savings</h3><p class="price" id="p-month">—</p></div>
        <div class="rcard"><h3>Payback period</h3><p class="price" id="p-payback">—</p></div>
        <div class="rcard"><h3>3-year ROI</h3><p class="price" id="p-roi">—</p></div>
      </div>
    </div>

    <aside class="cta-box">
      <p class="cta-title">Start saving this week</p>
      <p>26 free n8n templates — most take under 30 minutes to set up.</p>
      <a class="btn" href="/templates/">Browse free templates</a>
    </aside>
  </main>

  <script>
    const $ = (id) => document.getElementById(id);
    const fmt$ = (n) => "$" + Math.round(n).toLocaleString();
    function calc() {
      const hours = +$("hours").value || 0;
      const rate = +$("rate").value || 0;
      const setup = +$("setup").value || 0;
      const monthly = hours * 4.33 * rate;
      const yearly = monthly * 12;
      $("p-month").textContent = fmt$(monthly) + "/mo";
      $("p-year").textContent = fmt$(yearly);
      $("p-payback").textContent = monthly > 0 ? (setup / monthly < 1 ? "< 1 month" : (setup / monthly).toFixed(1) + " mo") : "—";
      $("p-roi").textContent = setup > 0 ? Math.round(((yearly * 3 - setup) / setup) * 100).toLocaleString() + "%" : "∞";
      $("results").hidden = false;
    }
    $("go").addEventListener("click", calc);
    calc();
  </script>

  <style>
    .tool-page { padding: 2.5rem 0 4rem; max-width: 820px; }
    .crumbs { font-size: 0.85rem; margin-bottom: 1rem; }
    .crumbs a { text-decoration: underline; }
    .kicker { display: inline-block; background: #111; color: #FFFDF5; font-size: 0.75rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; padding: 0.3rem 0.7rem; margin-bottom: 1rem; }
    .tool-page h1 { font-family: "Archivo Black", sans-serif; text-transform: uppercase; font-size: clamp(1.8rem, 4.5vw, 2.6rem); line-height: 1.05; margin: 0 0 1rem; }
    .lede { font-size: 1.1rem; margin-bottom: 2rem; max-width: 620px; }
    .calc { border: 3px solid #111; box-shadow: 6px 6px 0 #111; background: #fff; padding: 1.75rem; margin-bottom: 2.5rem; }
    .inputs { display: grid; grid-template-columns: 1fr 1fr 1fr auto; gap: 1rem; align-items: end; margin-bottom: 1.5rem; }
    .inputs label { font-weight: 800; font-size: 0.9rem; display: block; }
    .inputs input { display: block; width: 100%; margin-top: 0.4rem; padding: 0.7rem; border: 3px solid #111; font-size: 1.1rem; font-weight: 700; background: #FFFDF5; }
    .btn { background: #FF4D00; color: #fff; border: 3px solid #111; box-shadow: 4px 4px 0 #111; padding: 0.7rem 1.4rem; font-weight: 800; text-transform: uppercase; cursor: pointer; text-decoration: none; display: inline-block; }
    .btn:active { transform: translate(4px, 4px); box-shadow: 0 0 0 #111; }
    .results { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 1rem; }
    .rcard { border: 3px solid #111; padding: 1rem; background: #FFFDF5; }
    .rcard.winner { background: #FFD02F; }
    .rcard h3 { margin: 0 0 0.5rem; font-size: 0.9rem; text-transform: uppercase; }
    .price { font-family: "Archivo Black", sans-serif; font-size: 1.5rem; margin: 0; }
    .cta-box { border: 3px solid #111; box-shadow: 6px 6px 0 #111; background: #fff; padding: 1.5rem; text-align: center; }
    .cta-title { font-family: "Archivo Black", sans-serif; text-transform: uppercase; font-size: 1.25rem; margin: 0 0 0.5rem; }
    @media (max-width: 640px) { .inputs { grid-template-columns: 1fr; } }
  </style>
</BaseLayout>
