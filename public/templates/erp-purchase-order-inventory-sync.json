              "name": "inventory_sheet_name",
              "type": "string",
              "value": "Inventory"
            }
          ]
        },
        "options": {}
      },
      "id": "e6cd0136-e442-40df-8a76-803edc98fd07",
      "name": "CONFIG — Google Sheets",
