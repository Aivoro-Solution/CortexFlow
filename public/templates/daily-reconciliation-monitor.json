      "id": "6d7c292f-9ad0-4ee0-a8c6-f9274ffa0dba",
      "name": "Read Destination Rows",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1200,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Compare yesterday's source vs destination rows on KEY_FIELD\nconst cfg = $('CONFIG — Reconciliation').first().json;\nconst win = $('Build Yesterday Window').first().json;\nconst keyField = cfg.key_field;\nconst tsField = cfg.timestamp_field;\nconst compareFields = String(cfg.compare_fields || '').split(',').map(s => s.trim()).filter(Boolean);\nconst tolerance = parseFloat(cfg.tolerance || '0');\nconst yday = win.yesterday; // YYYY-MM-DD\n\nfunction inWindow(row) {\n  const ts = String(row[tsField] || '').slice(0, 10);\n  return ts === yday;\n}\nconst srcRows = $('Read Source Rows').all().map(i => i.json).filter(inWindow);\nconst dstRows = $('Read Destination Rows').all().map(i => i.json).filter(inWindow);\n\nconst dstByKey = new Map();\nfor (const r of dstRows) dstByKey.set(String(r[keyField] ?? ''), r);\nconst srcByKey = new Map();\nfor (const r of srcRows) srcByKey.set(String(r[keyField] ?? ''), r);\n\n// Numeric fields are equal within TOLERANCE; everything else is exact string match\nfunction fieldsEqual(a, b) {\n  const na = parseFloat(a), nb = parseFloat(b);\n  if (isNaN(na) || isNaN(nb)) return String(a ?? '') === String(b ?? '');\n  return Math.abs(na - nb) <= tolerance;\n}\n\nconst breaks = [];\nfor (const r of srcRows) {\n  const k = String(r[keyField] ?? '');\n  if (!k) continue;\n  const d = dstByKey.get(k);\n  if (!d) {\n    breaks.push({ break_type: 'MISSING_IN_DESTINATION', key: k, field: '', source_value: '', dest_value: '' });\n    continue;\n  }\n  for (const f of compareFields) {\n    if (!fieldsEqual(r[f], d[f])) {\n      breaks.push({ break_type: 'MISMATCHED', key: k, field: f,\n        source_value: String(r[f] ?? ''), dest_value: String(d[f] ?? '') });\n    }\n  }\n}\nfor (const r of dstRows) {\n  const k = String(r[keyField] ?? '');\n  if (k && !srcByKey.has(k)) {\n    breaks.push({ break_type: 'EXTRA_IN_DESTINATION', key: k, field: '', source_value: '', dest_value: '' });\n  }\n}\nconst mismatches = breaks.filter(b => b.break_type === 'MISMATCHED');\nreturn [{ json: {\n  yesterday: yday,\n  rows_checked_source: srcRows.length,\n  rows_checked_dest: dstRows.length,\n  missing_count: breaks.filter(b => b.break_type === 'MISSING_IN_DESTINATION').length,\n  extra_count: breaks.filter(b => b.break_type === 'EXTRA_IN_DESTINATION').length,\n  mismatch_count: mismatches.length,\n  break_count: breaks.length,\n  breaks: breaks,\n  mismatches: mismatches,\n}}];",
        "mode": "runOnceForAllItems"
      },
      "id": "f4c6f96f-0d51-4f2b-92db-766a519897d4",
      "name": "Compare Row Sets",
