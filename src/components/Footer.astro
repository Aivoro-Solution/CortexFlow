---
import { SITE, CATEGORIES } from "../config";
import NewsletterForm from "./NewsletterForm.astro";
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="nl-strip">
    <div class="wrap">
      <div>
        <p class="nl-kicker">Doc. CF-NL-001 · Dispatch</p>
        <h3>Get the next build in your inbox</h3>
        <p class="nl-sub">Practical tutorials on AI agents, automation, and chatbots — one email per new post.</p>
      </div>
      <NewsletterForm source="footer" id="nl-foot" />
    </div>
  </div>
  <div class="wrap">
    <div class="foot-grid">
      <div>
        <p class="foot-brand">
          <svg width="26" height="26" viewBox="0 0 40 40" fill="none" aria-hidden="true">
            <path d="M30.5 12.4 A13 13 0 1 0 30.5 27.6" stroke="#FFFDF5" stroke-width="4" stroke-linecap="round"/>
            <circle cx="34" cy="20" r="4.5" fill="#FF4D00"/>
          </svg>
          <span>{SITE.name}</span>
        </p>
        <p class="desc">{SITE.tagline}. Real builds, honest comparisons, zero fluff.</p>
        <p><a class="email" href={`mailto:${SITE.authorEmail}`}>{SITE.authorEmail}</a></p>
      </div>
      <div>
        <h4>Services</h4>
        <ul>
          <li><a href="/templates/">n8n Templates</a></li>
        </ul>
        <h4 style="margin-top: 1.2rem;">Topics</h4>
        <ul>
          {CATEGORIES.map((c) => (
            <li><a href={`/categories/${c.slug}/`}>{c.name}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <h4>Site</h4>
        <ul>
          <li><a href="/blog/">All posts</a></li>
          <li><a href="/about/">About</a></li>
          <li><a href="/contact/">Contact</a></li>
          <li><a href="/privacy/">Privacy Policy</a></li>
          <li><a href="/terms/">Terms</a></li>
          <li><a href="/rss.xml">RSS feed</a></li>
        </ul>
      </div>
    </div>
  </div>
  <div class="footer-bottom">
    <div class="wrap">
      <span>© {year} {SITE.name} · Free n8n templates, forever</span>
      <span>Built with Astro · Hosted on Cloudflare Pages</span>
    </div>
  </div>
</footer>
