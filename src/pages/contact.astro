---
import BaseLayout from "../components/BaseLayout.astro";
import { SITE } from "../config";
---

<BaseLayout
  title="Contact"
  description={`Contact ${SITE.name} — questions, corrections, topic requests, and partnership inquiries.`}
  canonicalPath="/contact/"
>
  <div class="prose-wrap">
    <section class="section prose">
      <p class="breadcrumb"><a href="/">Home</a> / Contact</p>
      <p class="kicker">CORTEXFLOW · FREE FOREVER</p>
      <h1>Contact</h1>
      <p style="color: var(--muted);">
        Questions about a tutorial, a correction, a topic request, or a partnership inquiry —
        the fastest way to reach us is email.
      </p>
      <p>
        <strong>Email:</strong>
        <a href={`mailto:${SITE.authorEmail}`}>{SITE.authorEmail}</a>
      </p>

      <!--
        This form is wired for Cloudflare Pages + a serverless form handler.
        Option A (simplest): replace the form below with a Formspree/Getform
        endpoint: <form action="https://formspree.io/f/YOUR_ID" method="POST">.
        Option B: add a Cloudflare Pages Function at functions/contact.js.
      -->
      <h2>Send a message</h2>
      <form class="simple-form" action={`mailto:${SITE.authorEmail}`} method="post" enctype="text/plain">
        <label>
          Your name
          <input type="text" name="name" required autocomplete="name" />
        </label>
        <label>
          Your email
          <input type="email" name="email" required autocomplete="email" />
        </label>
        <label>
          Message
          <textarea name="message" rows="6" required></textarea>
        </label>
        <button class="btn" type="submit">Send message</button>
      </form>
    </section>
  </div>
</BaseLayout>
