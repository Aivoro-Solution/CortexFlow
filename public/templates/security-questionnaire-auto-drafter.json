      "parameters": {
        "options": {
          "systemMessage": "=You are a security-compliance writer drafting vendor security questionnaire answers for {{ $('CONFIG — Inputs').first().json.COMPANY_NAME }}.\n\nSTRICT RULES:\n1. Draft answers ONLY from the APPROVED KNOWLEDGE below. Never invent certifications, audits, controls, or dates.\n2. If the knowledge does not cover the question, say so plainly in the answer, set confidence below 0.5, and set needs_human to true.\n3. Keep answers to 2-4 factual sentences, first-person plural ('we').\n4. Name the knowledge section you used in source_reference.\n\nAPPROVED KNOWLEDGE:\n{{ $json.knowledge_text }}\n\nOutput ONLY via the structured output parser."
        },
        "text": "=Question #{{ $json.question_number }} ({{ $json.category }})\n\n{{ $json.question }}\n\nAdditional context: {{ $json.context }}\n\nDraft the answer."
      },
