      "id": "029832dc-ce77-4a20-9429-e806de43acc6",
      "name": "Telegram — Review Alert",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        4560,
        140
      ]
    },
    {
      "parameters": {
        "jsCode": "// HTML quote table email for the reviewer (no review lines pending).\nconst cfg = $('CONFIG \\u2014 RFQ Settings').first().json;\nconst rec = $('Prepare RFQ Record').first().json;\nconst stats = $('Build RFQ Stats').first().json;\nconst matched = $('Match Lines Against Catalogue').all().map(i => i.json).filter(l => l.status === 'MATCHED');\nconst rows = matched.map(l =>\n  `<tr><td>${l.line_no}</td><td>${l.matched_code}</td><td>${l.description}</td>` +\n  `<td>${l.quantity}</td><td>${l.unit}</td><td>${stats.currency} ${Number(l.unit_price).toFixed(2)}</td>` +\n  `<td>${stats.currency} ${Number(l.line_total).toFixed(2)}</td></tr>`\n).join('');\nconst html =\n`<h2>Quote draft \\u2014 RFQ ${rec.rfq_reference}</h2>` +\n`<p>Hi, the AI RFQ-to-Quote Automator prepared this draft for <b>${rec.customer_name}</b> (${cfg.company_name}). ` +\n`All prices come from the approved price list only, and no lines needed human review.</p>` +\n`<table border=\"1\" cellpadding=\"6\" cellspacing=\"0\" style=\"border-collapse:collapse\">` +\n`<tr><th>#</th><th>Matched code</th><th>Description</th><th>Qty</th><th>Unit</th><th>Unit price</th><th>Line total</th></tr>` +\nrows + `</table>` +\n`<p><b>Quote total: ${stats.currency} ${Number(stats.quote_total).toFixed(2)}</b></p>` +\n`<p>Tip: open the <b>Quote Draft</b> sheet and use File \\u2192 Download \\u2192 Microsoft Excel (.xlsx) for a customer-ready file.</p>`;\nreturn [{ json: {\n  subject: `Quote draft ready \\u2014 RFQ ${rec.rfq_reference} (${rec.customer_name})`,\n  html: html,\n}}];",
        "mode": "runOnceForAllItems"
      },
