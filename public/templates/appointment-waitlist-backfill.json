    {
      "parameters": {
        "jsCode": "// Owner summary: who got an offer for which slot\nconst ranked = $('Code \\u2014 Score & Rank Waitlist').all().map(i => i.json);\nconst cfg = $('CONFIG \\u2014 Waitlist Rules').first().json;\nconst first = ranked[0] || {};\nconst lines = [`\\U0001F4CB *Waitlist offers sent*`, ``,\n  `Slot: ${first.slot_time || '—'}`, `Service: ${first.service || '—'}`,\n  `Candidates: ${ranked.length}`, ``];\nranked.forEach((c, idx) => lines.push(`${idx + 1}. ${c.name || c.phone} (${c.phone}) \\u2014 score ${c.score}`));\nlines.push(``, `Reply window: ${cfg.reply_window_minutes} min. First ${cfg.reply_keyword || 'TAKE'} wins.`);\nreturn [{ json: { summary: lines.join('\\n') } }];",
        "mode": "runOnceForAllItems"
      },
