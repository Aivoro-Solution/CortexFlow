    {
      "parameters": {
        "jsCode": "// Drop jobs whose URL is already in the sheet\nconst seen = new Set(\n  $('Read Seen Job URLs').all().map(i => (i.json['Job URL'] || i.json.job_url || '').trim()).filter(Boolean)\n);\nconst fresh = $('Normalize Job Listings').all()\n  .map(i => i.json)\n  .filter(j => j.job_url && !seen.has(j.job_url.trim()));\nreturn fresh.map(j => ({ json: j }));",
        "mode": "runOnceForAllItems"
      },
