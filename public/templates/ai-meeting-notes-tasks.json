        "options": {
          "fileType": "all"
        }
      },
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "",
          "name": "Google Drive OAuth2"
        }
      },
      "id": "1317f382-a85d-409e-aa33-f390d0356d80",
      "name": "New Transcript Arrived",
      "type": "n8n-nodes-base.googleDriveTrigger",
      "typeVersion": 1,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "fileId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $json.id }}"
        },
        "options": {
          "fileName": "={{ $json.name }}"
        },
        "operation": "download"
      },
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "",
          "name": "Google Drive OAuth2"
        }
      },
      "id": "2d8a229e-bce8-4f1b-aff5-d7ccf6e67f9e",
      "name": "Download Transcript",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Decode the downloaded Drive file (text/plain or .md) into transcript text\nconst fileName = $input.item.json.name || $('New Transcript Arrived').first().json.name || 'unknown';\nconst buf = await this.helpers.getBinaryDataBuffer(0, 'data');\nconst raw = buf.toString('utf-8');\nconst MAX = 12000;\nlet transcript_text = raw, truncated_note = '';\nif (raw.length > MAX) {\n  transcript_text = raw.slice(0, MAX);\n  truncated_note = ` (truncated from ${raw.length} chars to ${MAX})`;\n}\nreturn { json: {\n  file_name: fileName,\n  transcript_text,\n  truncated_note,\n  meeting_date: new Date().toISOString().slice(0, 10),\n  char_count: raw.length,\n}};",
        "mode": "runOnceForEachItem"
      },
      "id": "a3facdf0-f48e-4bf4-b379-1e80db50b35f",
      "name": "Extract Transcript Text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "c35b77bb-7aee-4c55-b5a3-4895995d6ff8",
              "name": "notion_database_id",
              "type": "string",
              "value": "PASTE_YOUR_NOTION_DATABASE_ID"
            },
            {
              "id": "d5022be0-9c60-4cb5-9ab0-0c2df35e6fd2",
              "name": "slack_channel",
              "type": "string",
              "value": "PASTE_YOUR_SLACK_CHANNEL (e.g. #meetings)"
            },
            {
              "id": "94a8c3c2-6039-4d18-b4a9-519d3c9ab9b7",
              "name": "default_owner",
              "type": "string",
              "value": "PASTE_YOUR_DEFAULT_OWNER (fallback when the AI cannot identify an owner)"
            }
          ]
        },
        "options": {}
      },
      "id": "c0264f93-7d6c-4c1d-bed7-45dc3762fa43",
      "name": "CONFIG — Task Routing",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        720,
        300
      ]
    },
    {
      "parameters": {
        "options": {
          "systemMessage": "=You are an expert meeting assistant. Read the meeting transcript and extract EVERY action item discussed — commitments, follow-ups, and decisions that need action.\n\nFor each action item identify:\n- task: a clear, self-contained title (start with a verb)\n- owner: the person explicitly assigned; if nobody is named, use an empty string\n- due_date: any mentioned deadline as YYYY-MM-DD (use the meeting date as context); empty string if none is mentioned\n- priority: high if urgent or blocking, medium if normal, low if nice-to-have\n\nAlso write a 3-5 sentence meeting_summary capturing the key decisions and outcomes.\n\nOutput ONLY via the structured output parser. Never invent owners or dates that are not in the transcript."
        },
        "text": "=Meeting transcript (file: {{ $json.file_name }}, date: {{ $json.meeting_date }}{{ $json.truncated_note }}):\n\n{{ $json.transcript_text }}"
      },
      "id": "0685525a-c02c-4cc0-9182-1b7f4d250e8f",
      "name": "AI Agent — Extract Action Items",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        960,
        300
      ]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4o-mini"
        },
        "options": {}
      },
      "credentials": {
        "openAiApi": {
          "id": "",
          "name": "OpenAI API"
        }
      },
      "id": "49cfe653-871e-4623-abfb-154da40d8bcf",
      "name": "OpenAI Chat Model — Extraction",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [
        960,
        560
      ]
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"meeting_summary\": \"3-5 sentence summary of the key decisions and outcomes\",\n  \"action_items\": [\n    {\n      \"task\": \"clear, self-contained task title starting with a verb\",\n      \"owner\": \"assigned person name, or empty string if nobody is named\",\n      \"due_date\": \"YYYY-MM-DD if a deadline was mentioned, or empty string\",\n      \"priority\": \"high / medium / low\"\n    }\n  ]\n}"
      },
      "id": "dd3c89ae-458c-4930-a21c-d337f8fa7250",
      "name": "Structured Output Parser — Action Items",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [
        1200,
        560
      ]
    },
    {
      "parameters": {
        "jsCode": "// One output item per action item, carrying meeting context + task fields\nconst cfg = $('CONFIG — Task Routing').first().json;\nconst src = $('Extract Transcript Text').first().json;\nconst defaultOwner = cfg.default_owner || '';\nconst out = [];\nfor (const a of $input.all()) {\n  const parsed = a.json.output || {};\n  const summary = parsed.meeting_summary || '';\n  const items = Array.isArray(parsed.action_items) ? parsed.action_items : [];\n  for (const t of items) {\n    const prio = String(t.priority || 'medium').toLowerCase();\n    out.push({ json: {\n      meeting_summary: summary,\n      file_name: src.file_name || '',\n      meeting_date: src.meeting_date || '',\n      task: String(t.task || '').trim(),\n      owner: String(t.owner || '').trim() || defaultOwner,\n      due_date: String(t.due_date || '').trim(),\n      priority: ['high', 'medium', 'low'].includes(prio) ? prio : 'medium',\n      status: 'EXTRACTED',\n    }});\n  }\n}\nreturn out;",
        "mode": "runOnceForAllItems"
      },
      "id": "3fd40d40-1e4d-4629-9628-0dff48ad5493",
      "name": "Split Action Items",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        300
      ]
    },
    {
      "parameters": {
        "resource": "databasePage",
        "operation": "create",
        "databaseId": {
          "__rl": true,
          "mode": "list",
          "value": "={{ $('CONFIG — Task Routing').first().json.notion_database_id }}"
        },
        "propertiesUi": {
          "propertyValues": [
            {
              "key": "Name",
              "title": "={{ $json.task }}"
            },
            {
              "key": "Owner",
              "richText": "={{ $json.owner }}"
            },
            {
              "key": "Due",
              "date": "={{ $json.due_date }}"
            },
            {
              "key": "Priority",
              "select": "={{ $json.priority }}"
            },
            {
              "key": "Source",
              "richText": "={{ $json.file_name }}"
            }
          ]
        },
        "options": {}
      },
      "credentials": {
        "notionApi": {
          "id": "",
          "name": "Notion API"
        }
      },
      "id": "50b25e5e-3b3e-4130-9555-5d48f78465cf",
      "name": "Notion — Create Task",
      "type": "n8n-nodes-base.notion",
      "typeVersion": 2.2,
      "position": [
        1680,
        300
      ]
    },
    {
      "parameters": {
        "operation": "append",
        "resource": "sheetWithinDocument",
        "documentId": {
          "__rl": true,
          "mode": "list",
          "value": ""
        },
        "sheetName": {
          "__rl": true,
          "mode": "list",
          "value": "Meeting Tasks"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "matchingColumns": [],
          "schema": [],
          "attemptToConvertTypes": false,
          "convertFieldsToString": false,
          "value": {
            "Date": "={{ $json.meeting_date }}",
            "Meeting File": "={{ $json.file_name }}",
            "Task": "={{ $json.task }}",
            "Owner": "={{ $json.owner }}",
            "Due Date": "={{ $json.due_date }}",
            "Priority": "={{ $json.priority }}",
            "Status": "CREATED"
          }
        },
        "options": {}
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "",
          "name": "Google Sheets API"
        }
      },
      "id": "d41ce7a6-7949-4be8-b72e-f34a2a17386b",
      "name": "Log Task — CREATED",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1920,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Aggregate ALL split items into one Slack message + a short Telegram message\nconst splits = $('Split Action Items').all().map(i => i.json);\nconst summary = (splits[0] && splits[0].meeting_summary) || 'No summary available.';\nconst fileName = (splits[0] && splits[0].file_name) || '';\nconst sLines = [`📝 *Meeting summary* — ${fileName}`, '', summary, '', `✅ *${splits.length} action item(s):*`, ''];\nsplits.forEach((t, i) => {\n  const bits = [`${i + 1}. ${t.task}`];\n  if (t.owner) bits.push(`_Owner: ${t.owner}_`);\n  if (t.due_date) bits.push(`_Due: ${t.due_date}_`);\n  bits.push(`_Priority: ${t.priority}_`);\n  sLines.push('• ' + bits.join(' · '));\n});\nconst top3 = splits.slice(0, 3).map((t, i) => `${i + 1}. ${t.task}${t.owner ? ' — ' + t.owner : ''}`);\nconst tLines = [`🎯 ${splits.length} task(s) created from *${fileName}*`, ''];\nif (top3.length) { tLines.push('Top tasks:', ...top3, ''); }\ntLines.push('Full list posted to Slack.');\nreturn [{ json: {\n  slack_text: sLines.join('\\n'),\n  telegram_text: tLines.join('\\n'),\n  task_count: splits.length,\n  file_name: fileName,\n}}];",
        "mode": "runOnceForAllItems"
      },
      "id": "a3b22399-77cb-4396-ac41-7d3354bff85e",
      "name": "Build Slack Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2160,
        300
      ]
    },
    {
      "parameters": {
        "channelId": {
          "__rl": true,
          "mode": "list",
          "value": "={{ $('CONFIG — Task Routing').first().json.slack_channel }}"
        },
        "operation": "post",
        "otherOptions": {},
        "resource": "message",
        "select": "channel",
        "text": "={{ $json.slack_text }}"
      },
      "credentials": {
