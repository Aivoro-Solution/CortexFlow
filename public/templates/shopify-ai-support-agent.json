    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"intent\": \"order_status / policy_question / refund_request / order_change / other\",\n  \"confidence\": 0,\n  \"draft_reply\": \"full reply text\",\n  \"needs_human\": false,\n  \"order_summary\": \"one line\"\n}"
      },
      "id": "b4d664cb-244b-4be2-8ba1-92fe880fdfed",
      "name": "Structured Output Parser — Triage",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [
        1920,
        560
      ]
    },
    {
      "parameters": {
        "jsCode": "// Decide the resolution path for each triaged email\nconst j = $input.item.json;\nconst o = j.output || {};\nconst threshold = Number($('CONFIG \\u2014 Shop').first().json.confidence_threshold || 80);\nconst intent = String(o.intent || 'other');\nconst confidence = Number(o.confidence || 0);\nconst needs_human = !!o.needs_human;\nconst auto_resolvable = (intent === 'order_status' || intent === 'policy_question')\n  && confidence >= threshold && !needs_human;\nconst money_involved = (intent === 'refund_request' || intent === 'order_change') || needs_human;\nreturn [{ json: {\n  ...j,\n  intent: intent,\n  confidence: confidence,\n  threshold: threshold,\n  auto_resolvable: auto_resolvable,\n  money_involved: money_involved,\n}}];",
        "mode": "runOnceForEachItem"
      },
      "id": "698fbdf0-ac94-451e-ab59-88b71c593237",
      "name": "Compute Routing",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1920,
        300
      ]
