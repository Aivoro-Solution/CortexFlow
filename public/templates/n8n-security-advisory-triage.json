    {
      "parameters": {
        "options": {
          "systemMessage": "=You are a security analyst specializing in self-hosted n8n. Decide whether the security advisory below affects the user's n8n instance.\n\nMy n8n version is {{ $('CONFIG — Instance').first().json.n8n_version }}. Compare it carefully against the vulnerable version range (semver ranges like '>= 1.0.0, < 2.41.4'). If you are unsure whether the version falls inside the range, err on the side of affected = true.\n\nOutput ONLY via the structured output parser."
        },
        "text": "=GHSA ID: {{ $json.ghsa_id }}\nSeverity: {{ $json.severity }}\nPublished: {{ $json.published_at }}\nVulnerable version range: {{ $json.vulnerable_version_range }}\n\nSummary:\n{{ $json.summary }}\n\nAdvisory URL: {{ $json.html_url }}"
      },
      "id": "46874828-5782-4ffa-a69c-a3d089c4b554",
      "name": "AI Agent — Assess Impact on My Version",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
