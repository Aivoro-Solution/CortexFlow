      "id": "ae8dcb64-e35a-4ac6-95ce-f5950862957f",
      "name": "List Store Sheets — Google Drive",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        720,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Map each Drive spreadsheet to a store: name from the file name, tab from CONFIG (positional)\nconst files = $('List Store Sheets \\u2014 Google Drive').all().map(i => i.json).filter(f => f.id);\nconst cfg = $('CONFIG \\u2014 Store Settings').first().json;\nconst tabs = String(cfg.store_sheet_tabs || 'Weekly Sales').split(',').map(s => s.trim()).filter(Boolean);\nif (!files.length) return [{ json: { found: False, found_count: 0 } }];\nreturn files.map((f, idx) => ({ json: {\n  found: True,\n  found_count: files.length,\n  sheet_id: f.id,\n  store_name: String(f.name || ('Store ' + (idx + 1))).replace(/\\.xlsx?$/i, '').trim(),\n  tab_name: tabs[idx] || tabs[0] || 'Weekly Sales',\n}}));",
        "mode": "runOnceForAllItems"
      },
      "id": "67ecfeed-2ef0-4934-b2c6-992992ab6570",
      "name": "Prepare Store List",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        300
      ]
    },
    {
