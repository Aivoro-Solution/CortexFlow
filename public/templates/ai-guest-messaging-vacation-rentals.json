    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"intent\": \"one of wifi, checkin, checkout, houserules, amenities, parking, directions, refund, complaint, access, schedule_change, other\",\n  \"confidence\": 0.0,\n  \"auto_reply_allowed\": true,\n  \"draft_reply\": \"the reply text — ALWAYS fill this, even when escalating (it becomes the suggested draft)\",\n  \"escalation_reason\": \"empty string if auto-reply is safe, otherwise a one-line reason\"\n}"
      },
      "id": "d4b74bb7-a029-4400-9be8-d680d6cb15d3",
      "name": "Structured Output Parser — Guest Intent",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [
        1960,
        560
      ]
    },
    {
      "parameters": {
        "conditions": {
          "combinator": "and",
          "conditions": [
            {
              "id": "if-auto",
              "leftValue": "={{ $json.output.auto_reply_allowed }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "name": "filter.operator.boolean.true"
              }
            },
            {
              "id": "if-conf",
              "leftValue": "={{ $json.output.confidence }}",
              "rightValue": "={{ $('CONFIG — Properties & Rules').first().json.confidence_threshold }}",
              "operator": {
                "type": "number",
                "operation": "largerEqual",
                "name": "filter.operator.number.largerEqual"
              }
            }
          ],
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          }
        },
        "options": {}
      },
      "id": "cc2b8617-2ee5-4a86-840f-37a81adb60f4",
      "name": "IF — Safe to Auto-Reply?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1960,
        300
      ]
    },
