      "parameters": {
        "jsCode": "// Compute yesterday's date (YYYY-MM-DD) to scope both reads\nconst d = new Date();\nd.setDate(d.getDate() - 1);\nconst yesterday = d.toISOString().slice(0, 10);\nreturn [{ json: { yesterday } }];",
        "mode": "runOnceForAllItems"
      },
