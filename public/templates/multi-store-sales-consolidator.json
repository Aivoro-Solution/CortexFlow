        "inputSchema": "{\n  \"total_revenue\": 0,\n  \"revenue_wow_change_pct\": 0,\n  \"per_store\": [{\"store\": \"store name\", \"revenue\": 0, \"wow_pct\": 0}],\n  \"top_items\": [\"top 5 items by revenue, with store\"],\n  \"insights\": [\"3-5 plain-English actionable insights\"],\n  \"red_flags\": [\"stores or items dropping hard, data issues; empty when none\"]\n}"
      },
      "id": "7e014165-e65b-44b9-b5be-6afda4a9a90f",
