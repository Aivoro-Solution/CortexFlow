      "id": "fc918dc3-85f2-4b6b-82ea-bb991713bd3d",
      "name": "AI Agent: Generate Reel Script",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [
        1900,
        150
      ],
      "parameters": {
        "text": "=Create a devotional reel video prompt from the reference keyframe image and the user idea.\n\nUser idea:\n{{ $('Telegram Trigger: Receive Reel Idea').item.json.message.caption }}\n\nKeyframe image:\n{{ $('Download Edited Image').item.json.images[0].url }}\n\nRules:\n- Reverent, serene pacing. Vertical 9:16 composition.\n- Default model: veo3_fast.\n- Output only one JSON object with keys `title` and `final_prompt`.\n",
        "options": {
          "systemMessage": "=SYSTEM PROMPT: Devotional Reel Prompt Generator\nGenerate a structured video prompt strictly from the master schema in {{ $json.json_master }}.\nReturn a JSON object with exactly two keys: `title` (max 12 words, devotional and evocative) and `final_prompt` (a single-line JSON string following the master schema with ALL fields preserved).\nNo explanations, no markdown — only the JSON object."
        },
        "promptType": "define",
        "hasOutputParser": true
      },
      "typeVersion": 2
    },
    {
      "id": "56dd62bb-0387-48e5-b1b3-662834e3dc57",
      "name": "Format Prompt",
      "type": "n8n-nodes-base.code",
      "position": [
        2160,
        150
      ],
      "parameters": {
        "jsCode": "const structuredPrompt = $input.first().json.output.final_prompt;\nreturn {\n  json: {\n    prompt: JSON.stringify(structuredPrompt),\n    model: \"veo3_fast\",\n    aspectRatio: \"9:16\"\n  }\n};\n"
      },
      "typeVersion": 2
    },
