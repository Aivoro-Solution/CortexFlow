          "name": "OpenAI API"
        }
      },
      "id": "8ee8fa33-fa1b-48ba-aa12-8080d5cbfb26",
      "name": "OpenAI Chat Model — Risk Review",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [
        1680,
        560
      ]
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"verdict\": \"allow / block\",\n  \"reason\": \"one or two sentences explaining the verdict\",\n  \"risk_score\": 0\n}"
      },
      "id": "bb4ae5aa-994a-4a45-916e-604fb9a1843c",
      "name": "Structured Output Parser — Risk Verdict",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [
        1920,
        560
      ]
    },
    {
      "parameters": {
        "jsCode": "// Combine the AI verdict with the risk threshold from CONFIG.\n// Block when the agent says block OR the risk score hits the threshold.\nconst req = $('Code \\u2014 Check Guard Rules').first().json;\nconst cfg = $('CONFIG \\u2014 Guard Policy').first().json;\nconst out = $json.output || {};\nconst threshold = Number(cfg.risk_block_threshold) || 70;\nconst risk = Number(out.risk_score);\nconst verdict = String(out.verdict || '').toLowerCase();\nlet decision = 'allow';\nlet decision_reason = out.reason || '';\nif (verdict !== 'allow') {\n  decision = 'block';\n  decision_reason = 'AI agent blocked it: ' + (out.reason || 'no reason given');\n} else if (!Number.isNaN(risk) && risk >= threshold) {\n  decision = 'block';\n  decision_reason = 'Risk score ' + risk + ' is at/above the block threshold ' + threshold + ': ' + (out.reason || '');\n} else {\n  decision_reason = 'AI agent allowed it (risk ' + (Number.isNaN(risk) ? 'n/a' : risk) + '/' + threshold + '): ' + (out.reason || '');\n}\nreturn [{ json: {\n  ...req,\n  status: 'PROCESSING',\n  agent_verdict: out.verdict || '',\n  risk_score: Number.isNaN(risk) ? '' : risk,\n  decision, decision_reason,\n} }];",
        "mode": "runOnceForAllItems"
      },
      "id": "069fde99-8fd4-42bb-9a11-c731573f74c6",
      "name": "Code — Build Agent Decision",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
