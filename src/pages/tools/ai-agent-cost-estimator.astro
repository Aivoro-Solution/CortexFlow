---
import BaseLayout from "../../components/BaseLayout.astro";
import { SITE } from "../../config";
---
<BaseLayout
  title="AI Agent Cost Estimator — Free Tool"
  description="Estimate what your AI agents cost to run. Enter token usage and runs per month — get the real monthly LLM bill before you ship."
  canonicalPath={`${SITE.url}/tools/ai-agent-cost-estimator/`}
>
  <main class="wrap tool-page">
    <nav class="crumbs"><a href="/">Home</a> <span>/</span> <a href="/tools/">Tools</a> <span>/</span> <span>Agent cost estimator</span></nav>
    <p class="kicker">Free tool</p>
    <h1>AI agent cost estimator</h1>
    <p class="lede">Agents burn tokens fast. Estimate the monthly LLM bill <em>before</em> you ship — pick a model, enter usage, done.</p>

    <div class="calc">
      <div class="inputs">
        <label>Model
          <select id="model">
            <option value="1.25,10">GPT-5 · $1.25 / $10 per 1M</option>
            <option value="3,15">Claude Sonnet · $3 / $15 per 1M</option>
            <option value="1.25,10">Gemini 2.5 Pro · $1.25 / $10 per 1M</option>
            <option value="0.3,1.2">GPT-5 mini · $0.30 / $1.20 per 1M</option>
          </select>
        </label>
        <label>Avg input tokens / run<input type="number" id="tin" value="4000" min="0" /></label>
        <label>Avg output tokens / run<input type="number" id="tout" value="800" min="0" /></label>
        <label>Agent runs / month<input type="number" id="runs" value="10000" min="0" /></label>
        <button class="btn" id="go">Estimate</button>
      </div>
      <div class="results" id="results" hidden>
        <div class="rcard winner"><h3>Monthly LLM cost</h3><p class="price" id="p-month">—</p></div>
        <div class="rcard"><h3>Cost / 1,000 runs</h3><p class="price" id="p-k">—</p></div>
        <div class="rcard"><h3>Cost / run</h3><p class="price" id="p-run">—</p></div>
        <div class="rcard"><h3>Yearly</h3><p class="price" id="p-year">—</p></div>
      </div>
      <p class="fine">Model prices are typical 2026 list prices — edit mentally if yours differ; providers change them. Excludes n8n/platform execution costs (see the <a href="/tools/n8n-cost-calculator/">cost calculator</a>).</p>
    </div>

    <aside class="cta-box">
      <p class="cta-title">Ship agents cheaper</p>
      <p>Free n8n agent templates with cost-guard patterns built in.</p>
      <a class="btn" href="/templates/">Browse free templates</a>
    </aside>
  </main>

  <script>
    const $ = (id) => document.getElementById(id);
    const money = (n) => n < 0.01 ? "$" + n.toFixed(4) : "$" + n.toLocaleString(undefined, {maximumFractionDigits: 2});
    function calc() {
      const [pin, pout] = $("model").value.split(",").map(Number);
      const tin = +$("tin").value || 0, tout = +$("tout").value || 0;
      const runs = +$("runs").value || 0;
      const perRun = (tin / 1e6) * pin + (tout / 1e6) * pout;
      const monthly = perRun * runs;
      $("p-run").textContent = money(perRun);
      $("p-k").textContent = money(perRun * 1000);
      $("p-month").textContent = money(monthly) + "/mo";
      $("p-year").textContent = money(monthly * 12);
      $("results").hidden = false;
    }
    $("go").addEventListener("click", calc);
    $("model").addEventListener("change", calc);
    calc();
  </script>

  <style>
    .tool-page { padding: 2.5rem 0 4rem; max-width: 820px; }
    .crumbs { font-size: 0.85rem; margin-bottom: 1rem; }
    .crumbs a { text-decoration: underline; }
    .kicker { display: inline-block; background: #111; color: #FFFDF5; font-size: 0.75rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; padding: 0.3rem 0.7rem; margin-bottom: 1rem; }
    .tool-page h1 { font-family: "Archivo Black", sans-serif; text-transform: uppercase; font-size: clamp(1.8rem, 4.5vw, 2.6rem); line-height: 1.05; margin: 0 0 1rem; }
    .lede { font-size: 1.1rem; margin-bottom: 2rem; max-width: 620px; }
    .calc { border: 3px solid #111; box-shadow: 6px 6px 0 #111; background: #fff; padding: 1.75rem; margin-bottom: 2.5rem; }
    .inputs { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; align-items: end; margin-bottom: 1.5rem; }
    .inputs label { font-weight: 800; font-size: 0.9rem; display: block; }
    .inputs input, .inputs select { display: block; width: 100%; margin-top: 0.4rem; padding: 0.7rem; border: 3px solid #111; font-size: 1rem; font-weight: 700; background: #FFFDF5; }
    .btn { background: #FF4D00; color: #fff; border: 3px solid #111; box-shadow: 4px 4px 0 #111; padding: 0.7rem 1.4rem; font-weight: 800; text-transform: uppercase; cursor: pointer; text-decoration: none; display: inline-block; grid-column: 1 / -1; justify-self: start; }
    .btn:active { transform: translate(4px, 4px); box-shadow: 0 0 0 #111; }
    .results { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 1rem; }
    .rcard { border: 3px solid #111; padding: 1rem; background: #FFFDF5; }
    .rcard.winner { background: #FFD02F; }
    .rcard h3 { margin: 0 0 0.5rem; font-size: 0.9rem; text-transform: uppercase; }
    .price { font-family: "Archivo Black", sans-serif; font-size: 1.4rem; margin: 0; }
    .fine { font-size: 0.8rem; color: #555; margin: 1.25rem 0 0; }
    .cta-box { border: 3px solid #111; box-shadow: 6px 6px 0 #111; background: #fff; padding: 1.5rem; text-align: center; }
    .cta-title { font-family: "Archivo Black", sans-serif; text-transform: uppercase; font-size: 1.25rem; margin: 0 0 0.5rem; }
    @media (max-width: 640px) { .inputs { grid-template-columns: 1fr; } }
  </style>
</BaseLayout>
