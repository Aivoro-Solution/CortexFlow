      "parameters": {
        "jsCode": "// Tag every sales row from this store with its store name\nconst store = $('Loop Stores \\u2014 Split In Batches').first().json.store_name;\nreturn $input.all().map(i => ({ json: { ...i.json, Store: store } }));",
        "mode": "runOnceForAllItems"
