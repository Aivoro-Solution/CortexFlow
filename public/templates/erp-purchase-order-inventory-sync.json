            },
            {
              "name": "page",
              "value": "1"
            },
            {
              "name": "per_page",
              "value": "={{ $json.page_size }}"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $json.erp_api_key }}"
            },
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        },
        "options": {}
      },
      "id": "c456eb2d-1f08-4d8a-9d29-27b0088b5f9e",
      "name": "Fetch Purchase Orders — ERP API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Normalize the ERP response into a clean PO list.\n// Expected ERP shape: { \"purchase_orders\": [ { po_number, supplier, total_amount,\n// currency, order_date, status, lines: [ { sku, description, quantity_ordered,\n// unit_price } ] } ], \"next_page\": null } — a bare array also works.\nconst cfg = $('CONFIG — ERP API').first().json;\nconst pageSize = parseInt(cfg.page_size || '50', 10);\nconst body = $input.first().json;\nconst raw = Array.isArray(body) ? body : (body.purchase_orders || body.data || body.results || []);\nconst pos = (Array.isArray(raw) ? raw : []).slice(0, pageSize);\nreturn pos.map(p => ({ json: {\n  po_number: p.po_number || p.id || p.number || '',\n  supplier: p.supplier || p.vendor || p.supplier_name || '',\n  total_amount: Number(p.total_amount || p.total || 0),\n  currency: p.currency || 'USD',\n  order_date: p.order_date || p.date || new Date().toISOString().slice(0, 10),\n  erp_status: p.status || '',\n  lines: (p.lines || p.items || []).map(l => ({\n    sku: l.sku || l.product_code || '',\n    description: l.description || l.name || '',\n    quantity_ordered: Number(l.quantity_ordered || l.quantity || 0),\n    unit_price: Number(l.unit_price || l.price || 0),\n  })),\n  date_found: new Date().toISOString().slice(0, 10),\n  status: 'NEW',\n}}));",
        "mode": "runOnceForAllItems"
      },
      "id": "6dc5379f-f9b8-4726-adb0-fd02806f5492",
      "name": "Normalize Purchase Orders",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        300
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "76115218-4aad-4633-b49b-d363449c7916",
              "name": "spreadsheet_id",
              "type": "string",
              "value": "PASTE_YOUR_SPREADSHEET_ID"
            },
            {
              "id": "30a2eca5-bbf0-42b9-9ca9-40df587d13bc",
              "name": "po_sheet_name",
              "type": "string",
              "value": "Purchase Orders"
            },
            {
