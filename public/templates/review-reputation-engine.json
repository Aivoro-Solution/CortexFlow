    {
      "parameters": {
        "jsCode": "// Summarize Flow B: new reviews + request stats for the shared digest\nconst statsRows = $('Read Request Stats').all().map(i => i.json);\nconst count = s => statsRows.filter(r => r.Status === s).length;\n// $input carries the logged GBP rows (Status=LOGGED); empty when no new reviews\nconst logged = $input.all().map(i => i.json).filter(r => r.Status === 'LOGGED');\nconst pos = logged.filter(r => r.Sentiment === 'positive').length;\nconst neg = logged.filter(r => r.Sentiment === 'negative').length;\nreturn [{ json: {\n  flow: 'B',\n  new_reviews: logged.length,\n  positive: pos,\n  negative: neg,\n  pending: count('REQUEST_PENDING'),\n  asked: count('REVIEW_ASKED'),\n  flagged: count('FLAGGED'),\n}}];",
        "mode": "runOnceForAllItems"
      },
      "id": "590e7be3-8bdc-44fb-b1d1-2353d1d29436",
      "name": "Build Flow-B Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2400,
        900
      ]
    },
    {
      "parameters": {
        "jsCode": "// Combine Flow A events + Flow B daily stats into one Telegram digest\nconst items = $input.all().map(i => i.json);\nconst a = items.find(i => i.flow === 'A');\nconst b = items.find(i => i.flow === 'B');\nconst today = new Date().toISOString().slice(0, 10);\nconst lines = ['⭐ *Reputation Digest — ' + today + '*', ''];\nif (a) lines.push('📩 ' + a.summary, '');\nif (b) {\n  lines.push('🆕 ' + b.new_reviews + ' new Google review(s) (👍 ' + b.positive + ' / 👎 ' + b.negative + ')');\n  lines.push('📨 Review requests: ' + b.pending + ' pending · ' + b.asked + ' asked · 🚩 ' + b.flagged + ' flagged');\n} else if (!a) {\n  lines.push('No activity today.');\n}\nreturn [{ json: { digest: lines.join('\\n') } }];",
        "mode": "runOnceForAllItems"
      },
      "id": "9dbff3ad-3d42-44a3-9fc9-e8828cef6ad3",
      "name": "Build Daily Digest",
      "type": "n8n-nodes-base.code",
