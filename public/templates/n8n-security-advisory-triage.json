      "id": "a4cc40b6-6469-4e0d-867d-255c51a2dd49",
      "name": "OpenAI Chat Model — Assessment",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [
        1920,
        560
      ]
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"ghsa_id\": \"GHSA-xxxx-xxxx-xxxx\",\n  \"severity\": \"low / moderate / high / critical\",\n  \"affected_versions\": \"vulnerable version range string\",\n  \"is_my_version_affected\": false,\n  \"patch_action\": \"e.g. upgrade to 2.41.4 or later\",\n  \"one_line_summary\": \"plain-English description of the risk\"\n}"
      },
      "id": "1a447dc3-97c9-420a-8ff0-0569cd391792",
      "name": "Structured Output Parser — Impact",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [
        2160,
        560
      ]
    },
    {
      "parameters": {
        "jsCode": "// Flag advisories that affect my version AND are high/critical severity\nconst j = $input.item.json;\nconst o = j.output || {};\nconst sev = String(o.severity || '').toLowerCase();\nconst urgent = o.is_my_version_affected === true && ['high', 'critical'].includes(sev);\nreturn [{ json: { ...j, urgent } }];",
        "mode": "runOnceForEachItem"
      },
      "id": "a3fc49ec-7091-4d6f-80c9-7aef49e2b023",
      "name": "Compute Urgency",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2160,
        300
