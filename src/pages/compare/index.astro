---
import { getCollection } from "astro:content";
import BaseLayout from "../../components/BaseLayout.astro";
import { SITE } from "../../config";

const items = (await getCollection("comparisons", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---
<BaseLayout
  title="Automation Platform Comparisons — n8n vs Zapier vs Make"
  description="Honest head-to-head comparisons of automation platforms: n8n vs Zapier, n8n vs Make, and more. Real pricing, AI agent capabilities, and verdicts."
  canonicalPath={`${SITE.url}/compare/`}
>
  <main class="wrap compare-hub">
    <p class="kicker">Head-to-head</p>
    <h1>Automation platform comparisons</h1>
    <p class="lede">
      No sponsored rankings. Every comparison uses real 2026 pricing, counts
      how each platform actually bills you, and ends with a clear verdict for
      your use case.
    </p>

    <div class="cards">
      {items.map((c) => {
        const slug = c.id.replace(/\.md$/, "");
        return (
          <a class="card" href={`/compare/${slug}/`}>
            <p class="vs">{c.data.tool_a} <span>vs</span> {c.data.tool_b}</p>
            <h2>{c.data.title}</h2>
            <p class="verdict">{c.data.verdict}</p>
            <span class="read">Read comparison →</span>
          </a>
        );
      })}
    </div>

    <aside class="cta-box">
      <p class="cta-title">Whichever you pick, start free</p>
      <p>26 production-ready n8n workflow templates. Download, import, automate.</p>
      <a class="btn" href="/templates/">Browse free templates</a>
    </aside>
  </main>

  <style>
    .compare-hub { padding: 2.5rem 0 4rem; max-width: 900px; }
    .kicker {
      display: inline-block; background: #111; color: #FFFDF5;
      font-size: 0.75rem; font-weight: 800; letter-spacing: 0.08em;
      text-transform: uppercase; padding: 0.3rem 0.7rem; margin-bottom: 1rem;
    }
    .compare-hub h1 {
      font-family: "Archivo Black", sans-serif; text-transform: uppercase;
      font-size: clamp(2rem, 5vw, 3rem); line-height: 1.05; margin: 0 0 1rem;
    }
    .lede { font-size: 1.15rem; margin-bottom: 2.5rem; max-width: 640px; }
    .cards { display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); }
    .card {
      border: 3px solid #111; box-shadow: 6px 6px 0 #111; background: #fff;
      padding: 1.5rem; text-decoration: none; color: inherit; display: block;
    }
    .card:hover { transform: translate(-2px, -2px); box-shadow: 8px 8px 0 #FF4D00; }
    .vs { font-weight: 900; text-transform: uppercase; font-size: 0.85rem; margin: 0 0 0.5rem; }
    .vs span {
      background: #FF4D00; color: #fff; padding: 0.1rem 0.5rem; margin: 0 0.3rem;
    }
    .card h2 { font-size: 1.15rem; margin: 0 0 0.75rem; line-height: 1.3; }
    .card .verdict { font-size: 0.92rem; line-height: 1.6; margin: 0 0 1rem; }
    .read { font-weight: 800; text-transform: uppercase; font-size: 0.85rem; text-decoration: underline; }
    .cta-box {
      border: 3px solid #111; box-shadow: 6px 6px 0 #111;
      background: #fff; padding: 1.5rem; margin: 3rem 0 0; text-align: center;
    }
    .cta-title {
      font-family: "Archivo Black", sans-serif; text-transform: uppercase;
      font-size: 1.25rem; margin: 0 0 0.5rem;
    }
    .btn {
      display: inline-block; margin-top: 1rem; background: #FF4D00; color: #fff;
      border: 3px solid #111; box-shadow: 4px 4px 0 #111;
      padding: 0.7rem 1.5rem; font-weight: 800; text-transform: uppercase;
      text-decoration: none;
    }
  </style>
</BaseLayout>
