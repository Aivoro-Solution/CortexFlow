          "name": "Slack OAuth2 API"
        }
      },
      "id": "87d8dd77-95be-40a8-9951-67206ce47e8f",
      "name": "Slack — Post Meeting Summary",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.3,
      "position": [
