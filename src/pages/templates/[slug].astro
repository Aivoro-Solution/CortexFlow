---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../components/BaseLayout.astro";
import { SITE } from "../../config";
import { categoryName, formatDate } from "../../lib/posts";

export async function getStaticPaths() {
  const templates = await getCollection("templates", ({ data }) => !data.draft);
  return templates.map((t) => ({
    params: { slug: t.id.replace(/\.md$/, "") },
    props: { t },
  }));
}

const { t } = Astro.props;
const { Content } = await render(t);
const slug = t.id.replace(/\.md$/, "");
const url = `/templates/${slug}/`;
const fileName = t.data.workflow.split("/").pop();

const difficultyLabel: Record<string, string> = {
  beginner: "Beginner",
  intermediate: "Intermediate",
  advanced: "Advanced",
};

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: t.data.title,
  description: t.data.description,
  applicationCategory: "DeveloperApplication",
  operatingSystem: "Any",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  author: { "@type": "Organization", name: SITE.name },
  datePublished: t.data.date.toISOString(),
  mainEntityOfPage: new URL(url, SITE.url).toString(),
};
---

<BaseLayout
  title={t.data.title}
  description={t.data.description}
  canonicalPath={url}
  type="article"
  publishedTime={t.data.date.toISOString()}
  modifiedTime={(t.data.updated ?? t.data.date).toISOString()}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <div class="prose-wrap">
    <section class="section prose">
      <p class="breadcrumb"><a href="/">Home</a> / <a href="/templates/">Templates</a> / {t.data.title}</p>
      <p class="dwg-no">DWG NO. CF-TPL-{slug} · <b>REV D</b></p>
      <h1>{t.data.title}</h1>
      <p class="post-meta">
        <time datetime={t.data.date.toISOString()}>{formatDate(t.data.date)}</time>
        {" · "}{difficultyLabel[t.data.difficulty]}{" · "}{categoryName(t.data.category)}
      </p>

      <div class="tpl-download">
        <a class="tpl-download__btn" href={t.data.workflow} download={fileName}>
          ↓ Download workflow JSON
        </a>
        <p class="tpl-download__hint">
          Import in n8n: <b>Workflows → ⋯ → Import from file</b>, then add your credentials.
          Free to use — no signup needed.
        </p>
      </div>

      <Content />

      <div class="tpl-download tpl-download--bottom">
        <a class="tpl-download__btn" href={t.data.workflow} download={fileName}>
          ↓ Download {fileName}
        </a>
      </div>

      <p style="margin-top: 2rem;">
        <a href="/templates/">← All templates</a>
      </p>
    </section>
  </div>
</BaseLayout>

<style>
  .post-meta { color: var(--muted); font-size: 0.9rem; margin: -0.5rem 0 1.5rem; }
  .tpl-download {
    border: 2px solid var(--ink); background: #fff;
    padding: 1.25rem 1.5rem; margin: 0 0 2rem;
    display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.5rem;
  }
  .tpl-download__btn {
    display: inline-block; background: var(--orange); color: #fff;
    font-family: var(--font-mono); font-size: 0.8rem; font-weight: 600;
    letter-spacing: 0.06em; text-transform: uppercase; text-decoration: none;
    padding: 0.8rem 1.6rem; border: 2px solid var(--ink);
    transition: transform 0.12s;
  }
  .tpl-download__btn:hover { transform: translate(-2px, -2px); box-shadow: 3px 3px 0 var(--ink); }
  .tpl-download__hint { margin: 0; font-size: 0.88rem; color: var(--muted); flex: 1 1 16rem; }
  .tpl-download--bottom { margin: 2.5rem 0 0; }
</style>
