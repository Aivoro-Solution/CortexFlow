      "typeVersion": 3.4,
      "position": [
        240,
        900
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://mybusiness.googleapis.com/v4/accounts/{{ $('CONFIG — GBP').first().json.gbp_account_id }}/locations/{{ $('CONFIG — GBP').first().json.gbp_location_id }}/reviews",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('CONFIG — GBP').first().json.gbp_access_token }}"
            }
          ]
        },
        "options": {}
      },
      "id": "913cc284-532a-4342-9c1e-549a5c818430",
      "name": "List New GBP Reviews",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        900
      ]
    },
    {
      "parameters": {
        "operation": "read",
        "resource": "sheetWithinDocument",
        "documentId": {
          "__rl": true,
          "mode": "list",
          "value": "={{ $('CONFIG — GBP').first().json.spreadsheet_id }}"
        },
        "sheetName": {
          "__rl": true,
          "mode": "list",
          "value": "GBP Reviews"
        },
        "options": {}
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "",
          "name": "Google Sheets API"
        }
      },
      "id": "fde8af95-37f7-47a4-97d1-7ed1b8d19207",
      "name": "Read Seen Reviews",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        720,
        900
      ]
    },
    {
      "parameters": {
        "jsCode": "// Keep only GBP reviews whose ID is not already logged in Sheets\nconst seen = new Set(\n  $('Read Seen Reviews').all().map(i => (i.json['Review ID'] || '').trim()).filter(Boolean)\n);\nconst reviews = $input.first().json.reviews || [];\nconst fresh = (Array.isArray(reviews) ? reviews : []).filter(r => r.name && !seen.has(r.name.trim()));\nreturn fresh.map(r => ({ json: {\n  review_id: r.name,\n  reviewer: (r.reviewer && r.reviewer.displayName) || 'Anonymous',\n  stars: (r.starRating || '').replace('STAR', '') || '',\n  text: r.comment || '',\n  create_time: r.createTime || '',\n}}));",
        "mode": "runOnceForAllItems"
      },
