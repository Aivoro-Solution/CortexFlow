        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"query\": \"SELECT campaign.name, metrics.impressions, metrics.clicks, metrics.cost_micros, metrics.conversions FROM campaign WHERE segments.date DURING LAST_7_DAYS\"}",
        "options": {}
      },
      "id": "092f24bb-d649-41c1-a7f0-243ced26d9d6",
      "name": "Google Ads — Pull GAQL",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
