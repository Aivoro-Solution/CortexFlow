    {
      "parameters": {
        "jsCode": "// Deterministic waitlist scoring. No AI here — fully explainable.\nconst cfg = $('CONFIG \\u2014 Waitlist Rules').first().json;\nconst cancel = $('Code \\u2014 Normalize Cancellation').first().json;\nconst wDay = parseFloat(cfg.weight_wait_day || '1');\nconst wNoShow = parseFloat(cfg.weight_no_show || '-10');\nconst wVisit = parseFloat(cfg.weight_visit_loyalty || '2');\nconst wPrio = parseFloat(cfg.weight_priority_flag || '25');\nconst minScore = parseFloat(cfg.min_score || '0');\nconst offerCount = parseInt(cfg.offer_count || '3', 10);\nconst windowMin = parseInt(cfg.reply_window_minutes || '120', 10);\nconst now = Date.now();\nconst expires = new Date(now + windowMin * 60000).toISOString();\nconst rows = $('Sheets \\u2014 Read Waitlist').all().map(i => i.json);\nconst scored = rows\n  .filter(r => r['Phone'] && (!cancel.service || !r['Service'] || r['Service'] === cancel.service))\n  .map(r => {\n    const waitSince = Date.parse(r['Wait Since'] || '') || now;\n    const waitDays = Math.max(0, Math.floor((now - waitSince) / 86400000));\n    const noShows = parseInt(r['No Shows'] || '0', 10) || 0;\n    const visits = parseInt(r['Visits'] || '0', 10) || 0;\n    const prio = String(r['Priority'] || '').trim().toUpperCase();\n    const priority = prio === 'YES' || prio === 'TRUE' || prio === '1';\n    const score = waitDays * wDay + noShows * wNoShow + visits * wVisit + (priority ? wPrio : 0);\n    return { name: r['Name'] || '', phone: String(r['Phone']), service: r['Service'] || '', score };\n  })\n  .filter(c => c.score >= minScore)\n  .sort((a, b) => b.score - a.score)\n  .slice(0, offerCount);\nreturn scored.map(c => ({ json: {\n  appointment_id: cancel.appointment_id,\n  slot_time: cancel.slot_time,\n  service: cancel.service,\n  name: c.name,\n  phone: c.phone,\n  score: Math.round(c.score * 10) / 10,\n  status: 'RANKED',\n  offer_expires_at: expires,\n}}));",
        "mode": "runOnceForAllItems"
      },
