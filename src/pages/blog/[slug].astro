---
import { render } from "astro:content";
import BaseLayout from "../../components/BaseLayout.astro";
import { SITE } from "../../config";
import { getPublishedPosts, postUrl, formatDate, categoryName, slugify } from "../../lib/posts";
import NewsletterForm from "../../components/NewsletterForm.astro";
import fs from "node:fs";
import path from "node:path";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.md$/, "") },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const url = postUrl(post);
const slug = post.id.replace(/\.md$/, "");

// Code-written animated SVG hero (current system): public/animated/<slug>.svg
// autoplay + loop via SMIL, inlined so reduced-motion can pause it.
let animatedSvg = null;
try {
  animatedSvg = fs.readFileSync(path.join(process.cwd(), "public", "animated", `${slug}.svg`), "utf8");
} catch {
  animatedSvg = null;
}

// JSON-LD Article schema for rich results
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: post.data.title,
  description: post.data.description,
  author: { "@type": "Organization", name: post.data.author },
  publisher: { "@type": "Organization", name: SITE.name },
  datePublished: post.data.date.toISOString(),
  dateModified: (post.data.updated ?? post.data.date).toISOString(),
  mainEntityOfPage: new URL(url, SITE.url).toString(),
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  canonicalPath={url}
  image={post.data.image}
  type="article"
  publishedTime={post.data.date.toISOString()}
  modifiedTime={(post.data.updated ?? post.data.date).toISOString()}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <div class="prose-wrap">
    <header class="post-header">
      <p class="breadcrumb">
        <a href="/">Home</a> / <a href="/blog/">Blog</a> /
        <a href={`/categories/${post.data.category}/`}>{categoryName(post.data.category)}</a>
      </p>
      <p class="dwg-no">DWG NO. CF-{Astro.params.slug} · <b>REV A</b></p>
      <p class="post-kicker">{categoryName(post.data.category)}</p>
      <h1>{post.data.title}</h1>
      <div class="post-meta">
        <span>By {post.data.author}</span>
        <time datetime={post.data.date.toISOString()}>Published {formatDate(post.data.date)}</time>
        {post.data.updated && (
          <time datetime={post.data.updated.toISOString()}>Updated {formatDate(post.data.updated)}</time>
        )}
      </div>
      <div class="post-tags">
        {post.data.tags.map((t) => (
          <a class="tag" href={`/tags/${slugify(t)}/`}>#{t}</a>
        ))}
      </div>
    </header>

    {post.data.image && (
      <figure class="post-hero" data-lottie-slug={Astro.params.slug}>
        {animatedSvg ? (
          <div class="anim-hero" aria-hidden="true" set:html={animatedSvg} />
        ) : (
          <div class="lottie-hero" aria-hidden="true"></div>
        )}
        <img src={post.data.image} alt={post.data.title} loading="eager" fetchpriority="high" style={animatedSvg ? "display:none" : undefined} />
        <figcaption class="sheet-cap"><span>FIG. 01 — {post.data.title}</span><span>SCALE 16:9</span></figcaption>
      </figure>
    )}

    <article class="post">
      <Content />
    </article>

    <div class="cta-box">
      <div>
        <span class="fmt">DOC. CF-RSS-001 · FORMAT: XML</span>
        <h3>Want more like this?</h3>
        <p>Practical tutorials on AI agents, automation, and chatbots — straight to your reader.</p>
      </div>
      <a class="btn" href="/rss.xml">Subscribe via RSS</a>
    </div>

    <div class="nl-box">
      <div>
        <p class="nl-kicker">Doc. CF-NL-001 · Dispatch</p>
        <h3>Get the next build in your inbox</h3>
        <p class="nl-sub">One practical email per new post. No spam, unsubscribe anytime.</p>
      </div>
      <NewsletterForm source="article" id="nl-post" />
    </div>
  </div>

  <script is:inline src="/js/lottie.min.js"></script>
  <script is:inline>
    (function () {
      var reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      // Code-written animated SVG heroes: pause SMIL + fall back to static webp.
      document.querySelectorAll(".anim-hero").forEach(function (el) {
        if (!reduceMotion) return;
        var svg = el.querySelector("svg");
        if (svg && svg.pauseAnimations) { try { svg.pauseAnimations(); } catch (e) {} }
        el.style.display = "none";
        var img = el.closest("figure").querySelector("img");
        if (img) img.style.display = "";
      });
      // Respect reduced motion: keep the static webp hero.
      if (reduceMotion) return;
      var figures = document.querySelectorAll("figure.post-hero[data-lottie-slug]");
      if (!figures.length || typeof lottie === "undefined") return;
      figures.forEach(function (fig) {
        var slug = fig.getAttribute("data-lottie-slug");
        var mount = fig.querySelector(".lottie-hero");
        if (!slug || !mount) return;
        fetch("/lottie/" + slug + ".json")
          .then(function (r) { if (!r.ok) throw 0; return r.json(); })
          .then(function (data) {
            var img = fig.querySelector("img");
            lottie.loadAnimation({
              container: mount,
              renderer: "svg",
              loop: true,
              autoplay: true,
              animationData: data,
            });
            mount.classList.add("is-playing");
            if (img) img.style.display = "none";
          })
          .catch(function () { /* keep webp fallback */ });
      });
    })();
  </script>
</BaseLayout>
