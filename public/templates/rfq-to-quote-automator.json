      "parameters": {
        "jsCode": "// Final Telegram summary of the whole RFQ run.\nconst rec = $('Prepare RFQ Record').first().json;\nconst stats = $('Build RFQ Stats').first().json;\nconst finalStatus = stats.review_count > 0 ? 'REVIEW_NEEDED' : 'SENT';\nconst detail = stats.review_count > 0\n  ? `${stats.review_count} line(s) need human review \\u2014 check the Review Queue sheet.`\n  : `Quote email sent to the reviewer.`;\nreturn [{ json: { message:\n`<b>\\u2705 RFQ processed</b>\\n<b>${rec.rfq_reference}</b> \\u2014 ${rec.customer_name}\\nLines: ${stats.line_count} | Matched: ${stats.matched_count} | Review: ${stats.review_count}\\nQuote total: ${stats.currency} ${Number(stats.quote_total).toFixed(2)}\\nStatus: <b>${finalStatus}</b>\\n${detail}`\n}}];",
        "mode": "runOnceForAllItems"
