---
import BaseLayout from "../../components/BaseLayout.astro";
import { CATEGORIES } from "../../config";
import { getPublishedPosts, postUrl, formatDate, categoryName } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return CATEGORIES.map((c, i) => ({
    params: { category: c.slug },
    props: {
      category: c,
      figNo: String(i + 1).padStart(3, "0"),
      posts: posts.filter((p) => p.data.category === c.slug),
    },
  }));
}

const { category, figNo, posts } = Astro.props;
---

<BaseLayout
  title={category.name}
  description={`${category.description} Browse all ${category.name.toLowerCase()} tutorials and guides.`}
  canonicalPath={`/categories/${category.slug}/`}
>
  <section class="section">
    <div class="wrap">
      <p class="breadcrumb"><a href="/">Home</a> / <a href="/blog/">Blog</a> / {category.name}</p>
      <p class="kicker">CORTEXFLOW · FREE FOREVER</p>
      <p class="post-kicker">FIG. {figNo}</p>
      <h1 style="margin: 0 0 .75rem; font-size: clamp(2.2rem, 5vw, 3.4rem); text-transform: uppercase;">{category.name}</h1>
      <p style="margin: 0 0 2.2rem; font-weight: 600; max-width: 62ch;">{category.description}</p>

      {posts.length > 0 ? (
        <div class="spec-list">
          {posts.map((post, i) => (
            <a class="spec" href={postUrl(post)}>
              <span class="spec-no" aria-hidden="true">{String(i + 1).padStart(3, "0")}</span>
              <span class="spec-body">
                <h3 class="spec-title">{post.data.title}</h3>
                <p class="spec-desc">{post.data.description}</p>
              </span>
              <span class="spec-tag">
                <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
              </span>
            </a>
          ))}
        </div>
      ) : (
        <p>No posts in this category yet — check back soon.</p>
      )}
    </div>
  </section>
</BaseLayout>
