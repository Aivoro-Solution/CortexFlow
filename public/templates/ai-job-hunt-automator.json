    {
      "parameters": {
        "jsCode": "// Normalize JSearch results into a clean job list\nconst cfg = $('CONFIG \\u2014 Job Search').first().json;\nconst maxResults = parseInt(cfg.max_results || '20', 10);\nconst raw = $input.first().json.data || [];\nconst jobs = (Array.isArray(raw) ? raw : []).slice(0, maxResults);\nreturn jobs.map(j => ({ json: {\n  job_title: j.job_title || '',\n  company: j.employer_name || '',\n  location: [j.job_city, j.job_country].filter(Boolean).join(', '),\n  job_url: j.job_apply_link || j.job_google_link || '',\n  description: (j.job_description || '').slice(0, 3000),\n  date_posted: j.job_posted_at_datetime_utc || '',\n  date_found: new Date().toISOString().slice(0, 10),\n  status: 'NEW',\n}}));",
        "mode": "runOnceForAllItems"
      },
      "id": "90047c00-24f6-4bf3-8c80-7618035a920a",
      "name": "Normalize Job Listings",
      "type": "n8n-nodes-base.code",
