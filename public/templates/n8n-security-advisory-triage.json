      "id": "f739dcc7-24c6-4f8a-9f68-554d616be586",
      "name": "Merge — Combine Branches",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        3360,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// One Telegram digest: how many new advisories, how many are urgent\nconst items = $input.all().map(i => i.json);\nconst urgentItems = items.filter(i => i.urgent === true);\nconst date = new Date().toISOString().slice(0, 10);\nlet lines = [`🛡️ *n8n Security Digest — ${date}*`, ``, `📋 ${items.length} new advisories triaged`];\nif (urgentItems.length) {\n  lines.push(`🚨 ${urgentItems.length} URGENT (affect your version, high/critical):`, ``);\n  for (const u of urgentItems.slice(0, 10)) {\n    const o = u.output || {};\n    lines.push(`• *${u.ghsa_id}* (${o.severity}) — ${o.one_line_summary || ''} [details](${u.html_url})`);\n  }\n} else {\n  lines.push(`✅ None affect your version. Sheet is up to date.`);\n}\nreturn [{ json: { digest: lines.join('\\n'), new_count: items.length, urgent_count: urgentItems.length } }];",
        "mode": "runOnceForAllItems"
      },
