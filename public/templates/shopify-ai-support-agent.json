        "jsCode": "// One Telegram digest from every email routed in this run.\n// Counts are derived from the routing decision (same items end in each terminal branch).\nconst items = $('Compute Routing').all().map(i => i.json);\nconst autoResolved = items.filter(j => j.auto_resolvable);\nconst drafts = items.filter(j => !j.auto_resolvable && j.money_involved);\nconst escalated = items.filter(j => !j.auto_resolvable && !j.money_involved);\nconst lines = [\n  '\\U0001F6D2 *Shopify Support Summary \\u2014 ' + new Date().toISOString().slice(0, 10) + '*',\n  '',\n  '\\U0001F4E8 ' + items.length + ' email(s) triaged',\n  '\\u2705 ' + autoResolved.length + ' auto-resolved',\n  '\\u270F\\uFE0F ' + drafts.length + ' drafts created for human review',\n  '\\U0001F198 ' + escalated.length + ' escalated to Slack',\n];\nreturn [{ json: { summary: lines.join('\\n'), total: items.length } }];",
        "mode": "runOnceForAllItems"
