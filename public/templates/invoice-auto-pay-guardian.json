    {
      "parameters": {
        "jsCode": "// One Telegram summary for the paid batch\nconst items = $input.all().map(i => i.json);\nconst total = items.reduce((s, i) => s + (Number(i.amount) || 0), 0);\nconst currency = items[0] ? items[0].currency : 'USD';\nconst lines = items.map(i => `\\u2022 ${i.invoice_number} \\u2014 ${i.supplier}: ${i.amount} ${i.currency} (ref ${i.payment_reference}, ${i.settlement_status})`);\nconst summary = [`\\u2705 *Invoice Auto-Pay \\u2014 ${new Date().toISOString().slice(0, 10)}*`, ``,\n  `${items.length} invoice(s) paid \\u2014 total ${total.toFixed(2)} ${currency}`, ``,\n  ...lines, ``,\n  `Policy ${items[0] ? items[0].policy_version : ''} \\u00b7 Full audit trail in PayablesLog`].join('\\n');\nreturn [{ json: { summary } }];",
        "mode": "runOnceForAllItems"
