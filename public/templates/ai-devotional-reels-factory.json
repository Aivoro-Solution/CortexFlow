    {
      "id": "a85e709d-05bd-4d2c-b61b-8cad36bdd5c8",
      "name": "Generate Image Prompt",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [
        1150,
        -300
      ],
      "parameters": {
        "text": "=Create a devotional reel keyframe image prompt from the inputs below.\n\nUser idea:\n{{ $json.CAPTION }}\n\nReference photo analysis (stay faithful to what is visible):\n{{ $json['IMAGE DESCRIPTION'] }}\n",
        "options": {
          "systemMessage": "=ROLE: Devotional Keyframe Prompt Builder\n\nGOAL: One concise, cinematic-yet-authentic image prompt (max 120 words) for a devotional short reel keyframe.\n\nRULES:\n- Output ONE JSON object only with key `image_prompt`. No commentary.\n- Style: divine cinematic realism — warm diya glow, marigold tones, soft haze, gentle bloom on light sources.\n- Camera cues: include 2-3 (e.g. shallow depth of field, slow dolly feel, centered divine composition, 85mm portrait look, volumetric light).\n- Keep deity iconography respectful and accurate; never invent sacred symbols or distort faces.\n- Setting: temple, ghat, home altar or festival — real-world, lived-in.\n\nOUTPUT CONTRACT: JSON only, max 120 words, cover subject, mood, setting, lighting, camera and colors."
        },
        "promptType": "define",
        "hasOutputParser": true
      },
      "typeVersion": 2.2
    },
