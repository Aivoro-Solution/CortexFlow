      "id": "2cf00deb-a309-4091-9493-e33843017604",
      "name": "Extract RFQ Text — PDF",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [
        720,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Build the RFQ record from the form submission + extracted PDF text\nconst form = $('RFQ Intake \\u2014 Form Trigger').first().json;\nconst text = ($input.first().json.text || '').slice(0, 15000);\nconst d = new Date();\nconst ref = 'RFQ-' + d.toISOString().slice(0, 10).replace(/-/g, '') + '-' + Math.floor(1000 + Math.random() * 9000);\nreturn [{ json: {\n  rfq_reference: ref,\n  customer_name: form.customer_name || '',\n  customer_email: form.customer_email || '',\n  notes: form.notes || '',\n  rfq_text: text,\n  received_at: d.toISOString(),\n  stage: 'NEW',\n  status: 'NEW',\n  line_count: 0,\n  matched_count: 0,\n  review_count: 0,\n  quote_total: 0,\n}}];",
        "mode": "runOnceForAllItems"
      },
      "id": "94fb5455-0f35-418f-916f-bd5b507f45cc",
      "name": "Prepare RFQ Record",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        300
      ]
    },
    {
      "parameters": {
        "operation": "append",
        "resource": "sheetWithinDocument",
        "documentId": {
          "__rl": true,
          "mode": "list",
          "value": "={{ $('CONFIG \\u2014 RFQ Settings').first().json.spreadsheet_id }}"
        },
        "sheetName": {
          "__rl": true,
          "mode": "list",
          "value": "={{ $('CONFIG \\u2014 RFQ Settings').first().json.rfq_log_sheet }}"
        },
        "options": {},
        "columns": {
          "mappingMode": "defineBelow",
          "matchingColumns": [],
          "schema": [],
          "attemptToConvertTypes": false,
          "convertFieldsToString": false,
          "value": {
            "rfq_reference": "={{ $json.rfq_reference }}",
            "customer_name": "={{ $json.customer_name }}",
            "received_at": "={{ $json.received_at }}",
            "stage": "={{ $json.stage }}",
            "line_count": "={{ $json.line_count }}",
            "matched_count": "={{ $json.matched_count }}",
            "review_count": "={{ $json.review_count }}",
            "quote_total": "={{ $json.quote_total }}",
            "currency": "={{ $('CONFIG \\u2014 RFQ Settings').first().json.currency }}",
            "status": "={{ $json.status }}",
            "notes": "={{ $json.notes }}"
          }
        }
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "",
          "name": "Google Sheets API"
        }
      },
      "id": "715d42da-05dc-41d2-9a8a-973d8a53e89d",
      "name": "Log RFQ — Status NEW",
