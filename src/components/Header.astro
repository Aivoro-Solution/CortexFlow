---
import { SITE } from "../config";
const path = Astro.url.pathname;
const isActive = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
const links = [
  { href: "/", label: "Home" },
  { href: "/templates/", label: "Templates" },
  { href: "/compare/", label: "Compare" },
  { href: "/blog/", label: "Blog" },
  { href: "/about/", label: "About" },
];
---
<header class="site-header" id="siteHeader">
  <div class="wrap">
    <a class="logo" href="/" aria-label={`${SITE.name} home`}>
      <svg width="26" height="26" viewBox="0 0 40 40" fill="none" aria-hidden="true">
        <path d="M30.5 12.4 A13 13 0 1 0 30.5 27.6" stroke="#111111" stroke-width="5" stroke-linecap="round"/>
        <circle cx="34" cy="20" r="4.5" fill="#FF4D00"/>
      </svg>
      {SITE.name}
    </a>
    <button class="menu-btn" aria-expanded="false" aria-controls="mobileNav" aria-label="Open menu">
      <span></span><span></span><span></span>
    </button>
    <nav class="nav" id="mobileNav" aria-label="Main navigation">
      {links.map((l) => (
        <a href={l.href} class={isActive(l.href) ? "active" : ""} {...(isActive(l.href) ? { "aria-current": "page" } : {})}>
          {l.label}
        </a>
      ))}
      <span class="auth-area" id="authArea">
        <a class="btn-sm" href="/signin/" data-auth="signed-out">Sign in</a>
        <a class="btn-sm primary" href="/signup/" data-auth="signed-out">Sign up</a>
        <span class="auth-user" data-auth="signed-in" hidden></span>
        <button class="btn-sm" data-auth="signed-in" id="signOutBtn" hidden>Sign out</button>
      </span>
    </nav>
  </div>
</header>
<script>
  const header = document.getElementById("siteHeader");
  const btn = header.querySelector(".menu-btn");
  const nav = document.getElementById("mobileNav");
  const setOpen = (open) => {
    header.classList.toggle("nav-open", open);
    btn.setAttribute("aria-expanded", String(open));
    btn.setAttribute("aria-label", open ? "Close menu" : "Open menu");
  };
  btn.addEventListener("click", () => setOpen(!header.classList.contains("nav-open")));
  nav.addEventListener("click", (e) => {
    if (e.target.closest("a")) setOpen(false);
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && header.classList.contains("nav-open")) {
      setOpen(false);
      btn.focus();
    }
  });

  // Auth state: show sign in/up buttons or the signed-in user.
  (async () => {
    const area = document.getElementById("authArea");
    if (!area) return;
    try {
      const res = await fetch("/api/auth/me");
      const out = await res.json();
      const signedIn = res.ok && out.ok;
      area.querySelectorAll("[data-auth]").forEach((el) => {
        const want = el.getAttribute("data-auth");
        el.hidden = (want === "signed-in") !== signedIn;
      });
      if (signedIn) {
        area.querySelector(".auth-user").textContent = "Hi, " + out.name.split(" ")[0];
      }
    } catch {
      /* leave signed-out buttons visible */
    }
    const signOut = document.getElementById("signOutBtn");
    if (signOut) {
      signOut.addEventListener("click", async () => {
        await fetch("/api/auth/signout", { method: "POST" });
        window.location.href = "/";
      });
    }
  })();
</script>
