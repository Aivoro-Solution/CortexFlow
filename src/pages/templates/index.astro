---
import { getCollection } from "astro:content";
import BaseLayout from "../../components/BaseLayout.astro";
import { SITE, CATEGORIES } from "../../config";
import { categoryName, formatDate } from "../../lib/posts";

const templates = (await getCollection("templates", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const difficultyLabel: Record<string, string> = {
  beginner: "Beginner",
  intermediate: "Intermediate",
  advanced: "Advanced",
};
---

<BaseLayout
  title="n8n Workflow Templates"
  description="Ready-to-import n8n workflow templates — AI agents, chatbots, and automations you can download and use in minutes."
  canonicalPath="/templates/"
>
  <section class="section">
    <div class="wrap">
      <p class="breadcrumb"><a href="/">Home</a> / Templates</p>
      <p class="kicker">CORTEXFLOW · FREE FOREVER</p>
      <p class="post-kicker">FIG. 001</p>
      <h1 style="margin: 0 0 .75rem; font-size: clamp(2.2rem, 5vw, 3.4rem); text-transform: uppercase;">n8n Workflow <span style="background: var(--yellow); padding: 0 .25em; border: 3px solid var(--ink); display: inline-block; transform: rotate(-1deg);">Templates</span></h1>
      <p style="margin: 0 0 2.2rem; max-width: 70ch; font-weight: 600;">
        Production-ready n8n workflows built from real demand — download the JSON, import it in n8n,
        add your credentials, and you're running. Free forever.
      </p>

      {templates.length > 0 ? (
        <div class="tpl-grid">
          {templates.map((t, i) => (
            <a class="tpl-card" href={`/templates/${t.id.replace(/\.md$/, "")}/`}>
              {i === 0 && <span class="burst" aria-hidden="true">Live</span>}
              <h3>{t.data.title}</h3>
              <p class="flow">{t.data.description}</p>
              <div class="meta">
                <span class="tpl-tag tpl-tag--live">Live</span>
                <span class="tpl-tag tpl-tag--diff">{difficultyLabel[t.data.difficulty]}</span>
                <span class="tpl-tag tpl-tag--ghost">{categoryName(t.data.category)}</span>
                <span class="tpl-dl">↓ JSON</span>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <p>No templates yet — check back soon.</p>
      )}

      <div class="cta-box">
        <div>
          <span class="fmt">Request line</span>
          <h3>Want a template for a specific workflow?</h3>
          <p>We build what readers ask for.</p>
        </div>
        <a class="btn" href="/contact/">Tell us →</a>
      </div>
    </div>
  </section>
</BaseLayout>
