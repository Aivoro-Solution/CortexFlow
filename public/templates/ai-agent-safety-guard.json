    {
      "parameters": {
        "jsCode": "// Four guard checks: kill switch, idempotency replay, monthly budget, hourly rate cap.\n// Cost is estimated from estimated_tokens at the per-1k-token rate in CONFIG;\n// the budget check sums cost_usd for this client in the current month.\nconst cfg = $('CONFIG \\u2014 Guard Policy').first().json;\nconst req = $('Code \\u2014 Normalize Request & Idempotency Key').first().json;\nconst ledger = $input.all().map(i => i.json);\nconst norm = (s) => (s || '').toString().trim().toLowerCase();\nconst now = new Date();\nconst monthPrefix = now.toISOString().slice(0, 7); // YYYY-MM\nconst oneHourAgo = now.getTime() - 60 * 60 * 1000;\nconst ratePer1k = Number(cfg.cost_per_1k_tokens_usd) || 0.0006;\nconst cost_usd = (req.estimated_tokens / 1000) * ratePer1k;\nconst monthlyBudget = Number(cfg.monthly_budget_usd) || 100;\nconst maxPerHour = Number(cfg.max_actions_per_hour) || 20;\nconst killSwitch = norm(cfg.kill_switch_enabled) === 'true';\n\n// Idempotency: the NEW row we just appended counts once; 2+ rows with the\n// same key (or any non-NEW row with it) means this action already ran.\nconst sameKey = ledger.filter(r => norm(r.idempotency_key) === norm(req.idempotency_key));\nconst duplicate = sameKey.length >= 2 || sameKey.some(r => norm(r.status) !== 'new');\n// Monthly spend: sum cost_usd for this client in the current month (non-blocked rows)\nconst monthSpend = ledger\n  .filter(r => norm(r.client_id) === norm(req.client_id)\n    && (r.timestamp || '').toString().slice(0, 7) === monthPrefix\n    && !norm(r.status).startsWith('blocked'))\n  .reduce((s, r) => s + (Number(r.cost_usd) || 0), 0);\n// Hourly rate: actions by this client in the last hour (non-blocked rows)\nconst hourCount = ledger.filter(r => norm(r.client_id) === norm(req.client_id)\n  && !norm(r.status).startsWith('blocked')\n  && new Date(r.timestamp || 0).getTime() >= oneHourAgo).length;\n\nlet guard_status = 'PROCESSING';\nlet decision_reason = '';\nif (killSwitch) {\n  guard_status = 'BLOCKED_KILLSWITCH';\n  decision_reason = 'Kill switch is ON (kill_switch_enabled = true) — all actions blocked';\n} else if (duplicate) {\n  guard_status = 'BLOCKED_DUPLICATE';\n  decision_reason = 'Duplicate action: idempotency key ' + req.idempotency_key.slice(0, 12) + '... is already in the ledger';\n} else if (monthSpend + cost_usd > monthlyBudget) {\n  guard_status = 'BLOCKED_BUDGET';\n  decision_reason = 'Monthly budget $' + monthlyBudget + ' would be exceeded (spent $' + monthSpend.toFixed(4) + ' + this action $' + cost_usd.toFixed(4) + ')';\n} else if (hourCount >= maxPerHour) {\n  guard_status = 'BLOCKED_RATE';\n  decision_reason = 'Rate cap hit: ' + hourCount + ' actions in the last hour (max ' + maxPerHour + ')';\n}\nreturn [{ json: {\n  ...req,\n  cost_usd: Number(cost_usd.toFixed(6)),\n  month_spend: Number(monthSpend.toFixed(4)),\n  hour_count: hourCount,\n  guard_status, decision_reason,\n  status: guard_status,\n} }];",
        "mode": "runOnceForAllItems"
      },
