          "value": "Purchase Orders"
        },
        "options": {}
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "",
          "name": "Google Sheets API"
        }
      },
      "id": "4e98a607-47a9-462b-b58c-064b821f9604",
      "name": "Read Seen PO Numbers",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1200,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Drop POs whose number is already in the sheet (idempotent by PO number)\nconst seen = new Set(\n  $('Read Seen PO Numbers').all().map(i => (i.json['PO Number'] || i.json.po_number || '').trim()).filter(Boolean)\n);\nconst fresh = $('Normalize Purchase Orders').all()\n  .map(i => i.json)\n  .filter(p => p.po_number && !seen.has(p.po_number.trim()));\nreturn fresh.map(p => ({ json: p }));",
        "mode": "runOnceForAllItems"
      },
      "id": "e17389c5-3455-48a1-9644-05761b40cd6a",
      "name": "Filter New POs Only",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        300
      ]
    },
    {
      "parameters": {
        "operation": "append",
