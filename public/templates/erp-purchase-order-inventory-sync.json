      "id": "52933c8e-68fe-4584-9af2-3ded23493ab4",
      "name": "CONFIG — ERP API",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $json.erp_api_base_url }}{{ $json.po_endpoint }}",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "status",
