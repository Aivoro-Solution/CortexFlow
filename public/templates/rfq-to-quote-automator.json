    {
      "parameters": {
        "operation": "update",
        "resource": "sheetWithinDocument",
        "documentId": {
          "__rl": true,
          "mode": "list",
          "value": "={{ $('CONFIG \\u2014 RFQ Settings').first().json.spreadsheet_id }}"
        },
        "sheetName": {
          "__rl": true,
          "mode": "list",
          "value": "={{ $('CONFIG \\u2014 RFQ Settings').first().json.rfq_log_sheet }}"
        },
        "options": {},
        "columns": {
          "mappingMode": "defineBelow",
          "matchingColumns": [
            "rfq_reference"
          ],
          "schema": [],
          "attemptToConvertTypes": false,
          "convertFieldsToString": false,
          "value": {
            "rfq_reference": "={{ $('Prepare RFQ Record').first().json.rfq_reference }}",
            "line_count": "={{ $json.output.line_items.length }}",
            "stage": "EXTRACTED",
            "status": "EXTRACTED"
          }
        }
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "",
          "name": "Google Sheets API"
        }
      },
      "id": "a5888274-8056-4ef6-aa7a-ce8459c4a146",
      "name": "Update RFQ Log — Status EXTRACTED",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1680,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Flatten the agent's structured line items into one item per line.\n// Guarantees at least one output item so the chain stays alive.\nconst rec = $('Prepare RFQ Record').first().json;\nconst out = ($input.first().json.output && $input.first().json.output.line_items) || [];\nconst items = (Array.isArray(out) ? out : []).map((l, idx) => ({ json: {\n  rfq_reference: rec.rfq_reference,\n  line_no: l.line_no || (idx + 1),\n  code: String(l.code || '').trim(),\n  description: String(l.description || '').trim(),\n  quantity: Number(l.quantity || 0),\n  unit: String(l.unit || '').trim(),\n}})).filter(l => l.json.description || l.json.code);\nif (!items.length) {\n  return [{ json: {\n    rfq_reference: rec.rfq_reference,\n    line_no: 0,\n    code: '',\n    description: 'No line items could be extracted from the PDF',\n    quantity: 0,\n    unit: '',\n  }}];\n}\nreturn items;",
        "mode": "runOnceForAllItems"
      },
      "id": "33398091-dfc5-4759-888b-07ef61d0ced3",
      "name": "Normalize Line Items",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1920,
        300
      ]
    },
    {
      "parameters": {
        "operation": "read",
        "resource": "sheetWithinDocument",
        "documentId": {
          "__rl": true,
          "mode": "list",
          "value": "={{ $('CONFIG \\u2014 RFQ Settings').first().json.spreadsheet_id }}"
        },
        "sheetName": {
          "__rl": true,
          "mode": "list",
          "value": "={{ $('CONFIG \\u2014 RFQ Settings').first().json.catalogue_sheet }}"
        },
        "options": {}
      },
