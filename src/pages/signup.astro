---
import BaseLayout from "../components/BaseLayout.astro";
import { SITE } from "../config";
---

<BaseLayout
  title="Sign up"
  description={`Create your ${SITE.name} account — save templates and get member updates.`}
  canonicalPath="/signup/"
>
  <div class="prose-wrap">
    <section class="section prose auth-page">
      <p class="breadcrumb"><a href="/">Home</a> / Sign up</p>
      <h1>Create your account</h1>
      <p style="color: var(--muted);">Free forever. One account for templates, tutorials and updates.</p>

      <form id="signupForm" class="auth-form" novalidate>
        <label>
          <span>Name</span>
          <input type="text" name="name" autocomplete="name" required maxlength="64" placeholder="Your name" />
        </label>
        <label>
          <span>Email</span>
          <input type="email" name="email" autocomplete="email" required placeholder="you@example.com" />
        </label>
        <label>
          <span>Password <small>(min 8 characters)</small></span>
          <input type="password" name="password" autocomplete="new-password" required minlength="8" placeholder="••••••••" />
        </label>
        <p class="auth-error" id="authError" role="alert" hidden></p>
        <button type="submit" class="btn" id="submitBtn">Create account</button>
      </form>

      <div class="auth-divider"><span>OR</span></div>
      <button type="button" class="auth-google" id="googleBtn">
        <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
          <path fill="#4285F4" d="M23.49 12.27c0-.79-.07-1.54-.19-2.27H12v4.51h6.47c-.29 1.48-1.14 2.73-2.4 3.58v3h3.86c2.26-2.09 3.56-5.17 3.56-8.82z"/>
          <path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.86-3c-1.08.72-2.45 1.16-4.07 1.16-3.13 0-5.78-2.11-6.73-4.96H1.29v3.09C3.26 21.3 7.31 24 12 24z"/>
          <path fill="#FBBC05" d="M5.27 14.29c-.25-.72-.38-1.49-.38-2.29s.14-1.57.38-2.29V6.62H1.29C.47 8.24 0 10.06 0 12s.47 3.76 1.29 5.38l3.98-3.09z"/>
          <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.31 0 3.26 2.7 1.29 6.62l3.98 3.09C6.22 6.86 8.87 4.75 12 4.75z"/>
        </svg>
        Continue with Google
      </button>

      <p class="auth-switch">Already have an account? <a href="/signin/">Sign in →</a></p>
    </section>
  </div>

  <script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/12.19.0/firebase-app.js";
    import {
      getAuth,
      createUserWithEmailAndPassword,
      updateProfile,
      GoogleAuthProvider,
      signInWithPopup,
    } from "https://www.gstatic.com/firebasejs/12.19.0/firebase-auth.js";
    import {
      getFirestore,
      doc,
      setDoc,
      serverTimestamp,
    } from "https://www.gstatic.com/firebasejs/12.19.0/firebase-firestore.js";

    // Filled in from the Firebase console (Project settings -> Your apps).
    // These values are public by design (Firebase docs) — not secrets.
    const firebaseConfig = {
      apiKey: "AIzaSyBgmyFmzeP9nzhlDPd1800b0ycYmg-yDeM",
      authDomain: "cortexflow-7c274.firebaseapp.com",
      projectId: "cortexflow-7c274",
    };

    const form = document.getElementById("signupForm");
    const err = document.getElementById("authError");
    const btn = document.getElementById("submitBtn");

    const FIREBASE_ERRORS = {
      "auth/email-already-in-use": "This email is already registered. Try signing in instead.",
      "auth/invalid-email": "Please enter a valid email address.",
      "auth/weak-password": "Password must be at least 8 characters.",
      "auth/too-many-requests": "Too many attempts. Please try again later.",
      "auth/network-request-failed": "Network error. Please try again.",
      "auth/operation-not-allowed": "Sign-up is not enabled right now. Please try again later.",
      "auth/popup-closed-by-user": "Google sign-in was cancelled.",
      "auth/cancelled-popup-request": "Google sign-in was cancelled.",
      "auth/popup-blocked": "Popup was blocked. Please allow popups for this site and try again.",
      "auth/unauthorized-domain": "This domain is not authorized in Firebase yet.",
    };

    function showError(msg) {
      err.textContent = msg;
      err.hidden = false;
    }

    let auth = null;
    let db = null;
    try {
      if (!firebaseConfig.apiKey.startsWith("__")) {
        const app = initializeApp(firebaseConfig);
        auth = getAuth(app);
        db = getFirestore(app);
      }
    } catch {
      auth = null;
      db = null;
    }

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      err.hidden = true;
      if (!auth) {
        showError("Sign-up is being set up. Please try again in a little while.");
        return;
      }
      const data = Object.fromEntries(new FormData(form).entries());
      const name = String(data.name || "").trim().slice(0, 64);
      const email = String(data.email || "").trim();
      const password = String(data.password || "");
      if (!name || !email || password.length < 8) {
        showError("Please fill in your name, a valid email, and a password of 8+ characters.");
        return;
      }
      btn.disabled = true;
      btn.textContent = "Creating…";
      try {
        const cred = await createUserWithEmailAndPassword(auth, email, password);
        if (name) {
          try {
            await updateProfile(cred.user, { displayName: name });
          } catch {
            /* non-fatal */
          }
        }
        const idToken = await cred.user.getIdToken();
        const res = await fetch("/api/auth/firebase-session", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ idToken }),
        });
        const out = await res.json();
        if (out.ok) {
          // Save the profile in Firestore (best-effort — sign-in already works).
          if (db) {
            try {
              await setDoc(
                doc(db, "users", cred.user.uid),
                { name, email, provider: "email", createdAt: serverTimestamp() },
                { merge: true }
              );
            } catch {
              /* Firestore not set up yet — skip */
            }
          }
          window.location.href = "/";
        } else {
          showError(out.error || "Something went wrong.");
        }
      } catch (ex) {
        showError(FIREBASE_ERRORS[ex.code] || "Something went wrong. Please try again.");
      }
      btn.disabled = false;
      btn.textContent = "Create account";
    });

    // Continue with Google (works for new + existing users).
    const gBtn = document.getElementById("googleBtn");
    gBtn.addEventListener("click", async () => {
      err.hidden = true;
      if (!auth) {
        showError("Sign-up is being set up. Please try again in a little while.");
        return;
      }
      gBtn.disabled = true;
      try {
        const cred = await signInWithPopup(auth, new GoogleAuthProvider());
        const idToken = await cred.user.getIdToken();
        const res = await fetch("/api/auth/firebase-session", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ idToken }),
        });
        const out = await res.json();
        if (out.ok) {
          if (db) {
            try {
              await setDoc(
                doc(db, "users", cred.user.uid),
                {
                  name: cred.user.displayName || "",
                  email: cred.user.email || "",
                  provider: "google",
                  createdAt: serverTimestamp(),
                },
                { merge: true }
              );
            } catch {
              /* Firestore not set up yet — skip */
            }
          }
          window.location.href = "/";
        } else {
          showError(out.error || "Something went wrong.");
        }
      } catch (ex) {
        showError(FIREBASE_ERRORS[ex.code] || "Google sign-in failed. Please try again.");
      }
      gBtn.disabled = false;
    });
  </script>
</BaseLayout>
