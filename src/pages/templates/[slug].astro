---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../components/BaseLayout.astro";
import { SITE } from "../../config";
import { categoryName, formatDate, getPublishedPosts, postUrl } from "../../lib/posts";

export async function getStaticPaths() {
  const templates = await getCollection("templates", ({ data }) => !data.draft);
  return templates.map((t) => ({
    params: { slug: t.id.replace(/\.md$/, "") },
    props: { t },
  }));
}

const { t } = Astro.props;
const { Content } = await render(t);
const slug = t.id.replace(/\.md$/, "");
const url = `/templates/${slug}/`;
const fileName = t.data.workflow.split("/").pop();

const difficultyLabel: Record<string, string> = {
  beginner: "Beginner",
  intermediate: "Intermediate",
  advanced: "Advanced",
};

// Daisy-chain internal linking (Sturm/Quaid playbook): template money pages link
// out to the most topically relevant tutorials, so authority flows both ways.
const STOP_WORDS = new Set([
  "the","and","for","with","your","you","our","this","that","from","into",
  "using","use","how","what","when","are","was","have","has","will","can",
  "its","free","n8n","workflow","workflows","template","templates","ready",
  "import","json","guide","setup","step","api","ai","new","best","top",
  "get","make","all","out",
]);
function stemWord(w: string): string {
  if (w.length > 6 && w.endsWith("ing")) return w.slice(0, -3);
  if (w.length > 5 && w.endsWith("ed")) return w.slice(0, -2);
  if (w.length > 5 && w.endsWith("es")) return w.slice(0, -2);
  if (w.length > 4 && w.endsWith("s")) return w.slice(0, -1);
  return w;
}
function tplKeywords(text: string): Set<string> {
  const words = text.toLowerCase().match(/[a-z]{4,}/g) ?? [];
  return new Set(
    words.filter((w) => !STOP_WORDS.has(w)).map(stemWord)
  );
}
const tplKw = tplKeywords(`${t.data.title} ${t.data.description}`);
const allPosts = await getPublishedPosts();
const relatedArticles = allPosts
  .map((p) => {
    // Title/description count double; body (first 3000 chars) adds topical depth.
    const head = `${p.data.title} ${p.data.description} `;
    const pKw = tplKeywords(head + head + (p.body ?? "").slice(0, 3000));
    let score = 0;
    for (const w of pKw) if (tplKw.has(w)) score++;
    return { p, score };
  })
  .filter((r) => r.score >= 4)
  .sort((a, b) => b.score - a.score || b.p.data.date.getTime() - a.p.data.date.getTime())
  .slice(0, 3)
  .map((r) => r.p);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: t.data.title,
  description: t.data.description,
  applicationCategory: "DeveloperApplication",
  operatingSystem: "Any",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  author: { "@type": "Organization", name: SITE.name },
  datePublished: t.data.date.toISOString(),
  mainEntityOfPage: new URL(url, SITE.url).toString(),
};
---

<BaseLayout
  title={t.data.title}
  description={t.data.description}
  canonicalPath={url}
  type="article"
  publishedTime={t.data.date.toISOString()}
  modifiedTime={(t.data.updated ?? t.data.date).toISOString()}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <div class="prose-wrap">
    <section class="section prose">
      <p class="breadcrumb"><a href="/">Home</a> / <a href="/templates/">Templates</a> / {t.data.title}</p>
      <p class="kicker">CORTEXFLOW · FREE FOREVER</p>
      <p class="post-kicker">{categoryName(t.data.category)}</p>
      <h1 style="text-transform: uppercase;">{t.data.title}</h1>
      <p class="post-meta">
        <time datetime={t.data.date.toISOString()}>{formatDate(t.data.date)}</time>
        {" · "}{difficultyLabel[t.data.difficulty]}{" · "}{categoryName(t.data.category)}
      </p>

      <div class="tpl-download">
        <a class="tpl-download__btn" href={t.data.workflow} data-dl-url={t.data.workflow} data-dl-name={fileName}>
          ↓ Download workflow JSON
        </a>
        <p class="tpl-download__hint">
          Import in n8n: <b>Workflows → ⋯ → Import from file</b>, then add your credentials.
          Free download with a free account.
        </p>
      </div>

      <Content />

      <div class="tpl-download tpl-download--bottom">
        <a class="tpl-download__btn" href={t.data.workflow} data-dl-url={t.data.workflow} data-dl-name={fileName}>
          ↓ Download {fileName}
        </a>
      </div>

      {relatedArticles.length > 0 && (
        <section class="related">
          <div class="sec-head">
            <h2><span class="sq" aria-hidden="true"></span>Related tutorials</h2>
            <a class="more" href="/blog/">View all</a>
          </div>
          <div class="spec-list">
            {relatedArticles.map((r, i) => (
              <a class="spec" href={postUrl(r)}>
                <span class="spec-no" aria-hidden="true">{String(i + 1).padStart(3, "0")}</span>
                <span class="spec-body">
                  <h3 class="spec-title">{r.data.title}</h3>
                  <p class="spec-desc">{r.data.description}</p>
                </span>
                <span class="spec-tag">{categoryName(r.data.category)}</span>
              </a>
            ))}
          </div>
        </section>
      )}

      <p style="margin-top: 2rem;">
        <a href="/templates/">← All templates</a>
      </p>
    </section>
  </div>

  <div class="dl-modal-overlay" id="dlModal" hidden>
    <div class="dl-modal" role="dialog" aria-modal="true" aria-labelledby="dlModalTitle">
      <button class="dl-modal__close" id="dlModalClose" aria-label="Close">✕</button>
      <p class="kicker">Free download</p>
      <h2 id="dlModalTitle">Sign up to download</h2>
      <p>Create your free account (or log in) to download this workflow JSON. It takes 10 seconds.</p>
      <div class="dl-modal__actions">
        <a class="btn" id="dlModalSignup" href="/signup/">Sign up — it's free</a>
        <a class="btn dl-modal__login" id="dlModalLogin" href="/signin/">Log in</a>
      </div>
    </div>
  </div>

  <script>
    (function () {
      var modal = document.getElementById("dlModal");
      var PENDING_KEY = "cf_pending_dl";

      function pagePath() {
        var p = window.location.pathname;
        return p.charAt(0) === "/" ? p : "/";
      }

      function triggerDownload(url, name) {
        var a = document.createElement("a");
        a.href = url;
        if (name) a.download = name;
        document.body.appendChild(a);
        a.click();
        a.remove();
      }

      async function isLoggedIn() {
        try {
          var r = await fetch("/api/auth/me", { credentials: "same-origin" });
          return r.ok;
        } catch (e) {
          return false;
        }
      }

      function openModal(url, name) {
        try {
          sessionStorage.setItem(PENDING_KEY, JSON.stringify({ url: url, name: name }));
        } catch (e) {}
        var next = encodeURIComponent(pagePath());
        document.getElementById("dlModalSignup").href = "/signup/?next=" + next;
        document.getElementById("dlModalLogin").href = "/signin/?next=" + next;
        modal.hidden = false;
        document.body.style.overflow = "hidden";
      }

      function closeModal() {
        modal.hidden = true;
        document.body.style.overflow = "";
      }

      document.getElementById("dlModalClose").addEventListener("click", closeModal);
      modal.addEventListener("click", function (e) {
        if (e.target === modal) closeModal();
      });
      document.addEventListener("keydown", function (e) {
        if (e.key === "Escape" && !modal.hidden) closeModal();
      });

      document.querySelectorAll("[data-dl-url]").forEach(function (el) {
        el.addEventListener("click", async function (e) {
          e.preventDefault();
          var url = el.getAttribute("data-dl-url");
          var name = el.getAttribute("data-dl-name") || "";
          el.style.pointerEvents = "none";
          var ok = await isLoggedIn();
          el.style.pointerEvents = "";
          if (ok) {
            try {
              sessionStorage.removeItem(PENDING_KEY);
            } catch (err) {}
            triggerDownload(url, name);
          } else {
            openModal(url, name);
          }
        });
      });

      // If the user just came back from signup/login, auto-start the pending download.
      (async function () {
        var raw = null;
        try {
          raw = sessionStorage.getItem(PENDING_KEY);
        } catch (e) {}
        if (!raw) return;
        if (await isLoggedIn()) {
          try {
            var d = JSON.parse(raw);
            sessionStorage.removeItem(PENDING_KEY);
            if (d && d.url) triggerDownload(d.url, d.name);
          } catch (e) {}
        }
      })();
    })();
  </script>
</BaseLayout>
