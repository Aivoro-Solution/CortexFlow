    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "subject": "=Thanks {{ $json.customer_name }}! One quick favour 🙏",
        "sendTo": "={{ $json.email }}",
        "emailType": "html",
        "message": "=Hi {{ $json.customer_name }},<br><br>Thanks for the {{ $json.stars }}-star rating — it means a lot! Would you mind sharing it publicly? It takes 30 seconds:<br><br><a href=\"{{ $('CONFIG — Review Flow').first().json.google_review_url }}\">👉 Leave a Google review</a><br><br>Thank you! 🙏",
