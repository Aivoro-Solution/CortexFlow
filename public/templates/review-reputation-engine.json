            },
            {
              "id": "4a03e088-1d5f-4d34-9313-ba33b72fdd47",
              "name": "gbp_account_id",
              "type": "string",
              "value": "PASTE_YOUR_ACCOUNT_ID"
            },
            {
              "id": "b2c740dc-d85d-4b52-a822-092a60a39a9b",
              "name": "gbp_location_id",
              "type": "string",
