---
import { SITE, CATEGORIES } from "../config";
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap">
    <div>
      <p class="foot-brand">
        <svg width="26" height="26" viewBox="0 0 32 32" fill="none" aria-hidden="true">
          <path d="M9 16h4.5M18.5 16H23" stroke="#F4F4F1" stroke-width="2" stroke-linecap="round"/>
          <circle cx="6.5" cy="16" r="3.6" fill="#FF4D00"/>
          <rect x="13.5" y="11.5" width="9" height="9" rx="2.5" stroke="#F4F4F1" stroke-width="2"/>
          <circle cx="25.5" cy="16" r="3.6" stroke="#F4F4F1" stroke-width="2"/>
        </svg>
        {SITE.name}
      </p>
      <p>{SITE.tagline}. Real builds, honest comparisons, zero fluff.</p>
    </div>
    <div>
      <h4>Topics</h4>
      <ul>
        {CATEGORIES.map((c) => (
          <li><a href={`/categories/${c.slug}/`}>{c.name}</a></li>
        ))}
      </ul>
    </div>
    <div>
      <h4>Site</h4>
      <ul>
        <li><a href="/blog/">All posts</a></li>
        <li><a href="/about/">About</a></li>
        <li><a href="/contact/">Contact</a></li>
        <li><a href="/rss.xml">RSS feed</a></li>
      </ul>
    </div>
  </div>
  <div class="footer-bottom">
    <span>© {year} {SITE.name}. All rights reserved.</span>
    <span>Built with Astro · Hosted on Cloudflare Pages</span>
  </div>
</footer>
