        }
      },
      "id": "bb13e911-3ded-4e59-bd66-8cba23c0cd16",
      "name": "Read Price List",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        2400,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Match extracted RFQ lines against the Catalogue + approved Price List.\n// HARD RULES: price comes ONLY from the Price List. Never substitute products:\n// unknown codes, missing prices, missing units, or low confidence go to REVIEW.\nconst cfg = $('CONFIG \\u2014 RFQ Settings').first().json;\nconst threshold = parseFloat(cfg.confidence_threshold || '0.8');\nconst currency = cfg.currency || 'USD';\n\nconst normCode = s => String(s || '').trim().toUpperCase();\nconst normDesc = s => String(s || '').toLowerCase().replace(/[^a-z0-9]+/g, ' ').trim();\n\nconst catByCode = {};\nconst catByDesc = {};\nfor (const i of $('Read Catalogue').all()) {\n  const j = i.json;\n  const code = normCode(j.product_code);\n  if (code && !catByCode[code]) catByCode[code] = j;\n  const d = normDesc(j.description);\n  if (d && !catByDesc[d]) catByDesc[d] = j;\n}\nconst priceByCode = {};\nfor (const i of $('Read Price List').all()) {\n  const j = i.json;\n  const code = normCode(j.product_code);\n  if (code && priceByCode[code] === undefined) priceByCode[code] = j; // first price version wins\n}\n\nconst ref = $('Prepare RFQ Record').first().json.rfq_reference;\nconst out = [];\nfor (const item of $('Normalize Line Items').all()) {\n  const L = item.json;\n  const code = normCode(L.code);\n  let matched = null, confidence = 0, issue = '';\n  if (catByCode[code]) { matched = catByCode[code]; confidence = 1.0; }\n  else if (catByDesc[normDesc(L.description)]) { matched = catByDesc[normDesc(L.description)]; confidence = 0.8; }\n  else { issue = 'UNKNOWN_CODE'; }\n\n  let unit_price = null, line_total = 0;\n  if (matched) {\n    const priceRow = priceByCode[normCode(matched.product_code)];\n    if (priceRow && priceRow.unit_price !== '' && priceRow.unit_price !== undefined && priceRow.unit_price !== null) {\n      unit_price = Number(priceRow.unit_price);\n      line_total = Math.round(Number(L.quantity || 0) * unit_price * 100) / 100;\n    } else {\n      issue = 'NO_APPROVED_PRICE';\n    }\n  }\n  if (!L.unit) issue = issue || 'UNIT_MISSING';\n  if (matched && confidence < threshold) issue = issue || 'LOW_CONFIDENCE';\n\n  const status = (matched && !issue) ? 'MATCHED' : 'REVIEW';\n  out.push({ json: {\n    rfq_reference: ref,\n    line_no: L.line_no,\n    code: L.code || '',\n    matched_code: matched ? String(matched.product_code) : '',\n    description: L.description || '',\n    quantity: L.quantity || 0,\n    unit: L.unit || '',\n    unit_price: unit_price === null ? '' : unit_price,\n    line_total: status === 'MATCHED' ? line_total : 0,\n    currency: currency,\n    confidence: confidence,\n    status: status,\n    issue: issue,\n  }});\n}\nreturn out;",
        "mode": "runOnceForAllItems"
      },
      "id": "374c72ac-2810-4ed1-9b21-ea69fc316807",
      "name": "Match Lines Against Catalogue",
      "type": "n8n-nodes-base.code",
