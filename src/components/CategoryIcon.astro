---
/* Line-style category icons — drawn for the brief, not emoji. */
interface Props { slug: "ai-agents" | "automation" | "chatbots"; }
const { slug } = Astro.props;
const stroke = "#15151A";
const accent = "#FF4D00";
---
{slug === "ai-agents" && (
  <svg width="40" height="40" viewBox="0 0 40 40" fill="none" aria-hidden="true">
    <circle cx="20" cy="20" r="6" stroke={stroke} stroke-width="2"/>
    <circle cx="20" cy="20" r="2.2" fill={accent}/>
    <circle cx="7" cy="9" r="3.4" stroke={stroke} stroke-width="2"/>
    <circle cx="33" cy="9" r="3.4" stroke={stroke} stroke-width="2"/>
    <circle cx="7" cy="31" r="3.4" stroke={stroke} stroke-width="2"/>
    <circle cx="33" cy="31" r="3.4" stroke={stroke} stroke-width="2"/>
    <path d="M9.5 11.5 15 16M30.5 11.5 25 16M9.5 28.5 15 24M30.5 28.5 25 24" stroke={stroke} stroke-width="2" stroke-linecap="round"/>
  </svg>
)}
{slug === "automation" && (
  <svg width="40" height="40" viewBox="0 0 40 40" fill="none" aria-hidden="true">
    <path d="M33 20a13 13 0 1 1-3.8-9.2" stroke={stroke} stroke-width="2" stroke-linecap="round"/>
    <path d="M33 4v7h-7" stroke={accent} stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    <circle cx="20" cy="20" r="3" fill={stroke}/>
  </svg>
)}
{slug === "chatbots" && (
  <svg width="40" height="40" viewBox="0 0 40 40" fill="none" aria-hidden="true">
    <path d="M6 10h28v16H18l-7 6v-6H6V10z" stroke={stroke} stroke-width="2" stroke-linejoin="round"/>
    <circle cx="14" cy="18" r="1.8" fill={accent}/>
    <circle cx="21" cy="18" r="1.8" fill={accent}/>
    <circle cx="28" cy="18" r="1.8" fill={accent}/>
  </svg>
)}
